    "arch": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Round-headed arches only, springing from an impost with the rise exactly half the span within 2 percent -- no segmental, pointed or elliptical arches, except at service openings below the piano nobile.",
      "parameters": {
        "arch_rise_to_span": {
          "range": [
            0.48,
            0.52
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "italian-renaissance.json constraints (italian-renaissance.c02)"
        }
      },
      "variants": [
        {
          "id": "semicircular-arch-impost-sprung",
          "status": "canonical"
        },
        {
          "id": "segmental-pointed-or-elliptical",
          "status": "forbidden",
          "note": "italian-renaissance.c02, hard, except at service openings below the piano nobile."
        }
      ],
      "sources": [
        "italian-renaissance.json constraints (italian-renaissance.c02), diagnostic_tells"
      ],
      "group": "openings",
      "note": "MIGRATED FROM `window_head_masonry` 24 Aug 2026 (OQ 46), when the `arch` slot was added. Round-headed arches springing from an impost, with the rise exactly half the span. Every word of it is about an arch as a spanning member and none about how a window's head is built. The old slot is left `open`/`empty` on this kit rather than carrying a pointer, because the same fact in two places is what this migration exists to prevent."
    },
    "window_head_masonry": {
      "group": "openings",
      "binding": "open",
      "status": "empty",
      "note": "Emptied 24 Aug 2026 (OQ 46): everything this slot carried was about the ARCH as a spanning member and has moved to the `arch` slot. This kit states nothing about how a masonry window head is built, and saying so is different from saying it has none."
    },
