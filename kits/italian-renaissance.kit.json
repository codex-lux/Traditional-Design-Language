    "window_grouping_rule": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Every window on the facade is the same size and the same distance apart, including the ones next to the door -- no window is more important than any other. Emphasis, if any, comes only from centring the portal and at most slightly enlarging the central window; there is no hierarchical grouping.",
      "variants": [
        {
          "id": "uniform-identical-repeated-bays",
          "status": "canonical"
        },
        {
          "id": "hierarchical-emphasised-grouping",
          "status": "forbidden",
          "note": "Contradicts the style's own diagnostic_tells (every window the same size and spacing) and bay_rhythm ('no centrepiece and no crescendo'); hierarchical grouping is the Palladian, not the earlier Renaissance, move."
        }
      ],
      "sources": [
        "italian-renaissance.json diagnostic_tells, proportional_system.bay_rhythm"
      ],
