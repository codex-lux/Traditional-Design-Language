      "variants": [
        {
          "id": "even-additive-no-centrepiece",
          "status": "canonical",
          "op": "add",
          "note": "own bay_rhythm: 'no centrepiece and no crescendo... terminated by quoins and a cornice.' Every window on the facade is the same size and the same distance apart, including next to the door (own diagnostic_tells)."
        },
        {
          "id": "dominant-centre-with-flanking-wings",
          "status": "forbidden",
          "op": "add",
          "note": "This is precisely what distinguishes Palladio: own distinguished_from[palladian] states 'the earlier Renaissance composes an even, unaccented, planar wall with no centrepiece.'"
        }
      ],
      "note": "Extends the family's strict-bilateral-symmetry binding with the specific even, non-hierarchical bay logic that separates this member from Palladian's dominant-centre composition.",
