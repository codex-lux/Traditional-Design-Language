          "status": "forbidden",
          "op": "replace",
          "note": "This variant is load-bearing or substantially masonry construction; a timber-frame wall belongs to the spindlework or free classic subtypes instead."
        },
        {
          "id": "balloon-frame",
          "status": "forbidden",
          "op": "replace",
          "note": "The family's default wood construction; this variant is specifically the masonry expression of the parent style, not the balloon-framed majority."
        }
      ],
      "rule_append": "Load-bearing or substantially masonry wall construction in pressed or moulded brick, not the family's default balloon frame.",
