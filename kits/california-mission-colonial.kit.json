    "construction_type": {
      "group": "envelope",
      "binding": "extends",
      "variants": [
        {
          "id": "adobe",
          "status": "canonical",
          "op": "replace",
          "note": "The mission ranges and most church walls; the type's defining material (own defining characteristics)."
        },
        {
          "id": "solid-masonry-three-wythe",
          "status": "permitted",
          "op": "replace",
          "note": "Stone rubble at the grandest churches (e.g. Mission Santa Barbara, in local sandstone) where adobe alone could not span the height; still lime-plastered and whitewashed to read the same as adobe."
        }
      ],
      "note": "Promotes adobe from the family's generic 'permitted' rating (true across six unrelated branches) to canonical for this branch specifically, and adds the documented stone exception.",
      "confidence": "high",
      "status": "drafted"
    },
    "wall_thickness_masonry": {
      "group": "envelope",
      "binding": "extends",
      "parameters": {
        "thickness_church": {
          "range": [
            36,
            60
          ],
          "unit": "in",
          "kind": "measured",
          "note": "3-5 ft at the church specifically, thicker than the 24-36 in range-room wall the inherited colonial-iberian-americas figure (24-40 in) already covers."
        },
        "height_to_thickness_max": {
          "value": 8,
          "unit": "ratio",
          "kind": "measured",
          "note": "Height not more than 8x thickness without buttressing; where exceeded, external buttresses at not more than 15 ft o.c. (c03, hard)."
        }
      },
      "note": "Adds the church's own thicker figure and the height-to-thickness buttressing rule on top of the inherited 24-40 in mass-wall parameter, without restating it.",
      "confidence": "high",
