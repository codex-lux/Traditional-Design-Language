  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "extends",
      "rule_append": " Within that field-wall discipline, the arcaded corredor itself runs as a long, slow, uninterrupted rhythm of identical bays -- typically ten to twenty of them, on square masonry piers -- with no accent, no privileged bay and no termination other than the corner of the court; composition is spent entirely on the single church portada, never on the arcade (own proportional_system.bay_rhythm).",
      "note": "The inherited colonial-iberian-americas rule ('ornament confined to entry') is correct and untouched; this adds the arcade's own additive bay rhythm, which the ancestor's rule does not by itself state.",
      "status": "drafted",
      "confidence": "high"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": "3:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_max": {
          "value": "5:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_typical": {
          "value": "4:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_degrees": {
          "range": [
            14.0,
            22.6
          ],
          "unit": "deg",
          "kind": "derived"
        }
      },
      "rule": "Roof pitch 3:12 to 5:12 under half-round clay tile; pitches above 6:12 are foreign to the tradition (c02).",
      "note": "Specified rather than extends: the inherited colonial-iberian-americas band (20-30 degrees) is calibrated for the wider Iberian-Americas family's flat-azotea/tile split and is measurably shallower and narrower here -- 3:12-5:12 is about 14.0-22.6 degrees, mostly below the ancestor's 20-degree floor. Restating avoids a resolved kit that quietly carries the wrong number.",
      "confidence": "high",
      "status": "drafted"
    },
