    "gable_treatment": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "flush",
          "status": "canonical",
          "note": "The great majority of ranges and church gables are plain and unshaped, terminating the tile roof without ornament."
        },
        {
          "id": "parapeted",
          "status": "atypical",
          "note": "The shaped or curvilinear parapet gable occurs on only a few mission facades; the 1890s Mission Revival made it the universal signature, which this node's own distinguished_from note against mission-revival explicitly corrects."
        }
      ],
      "rule": "Gable treatment is plain by default; a shaped parapet gable is a real but minority historical feature, not the type's signature.",
      "confidence": "high",
      "status": "drafted"
    },
