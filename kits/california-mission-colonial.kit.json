    "porch_type": {
      "group": "threshold",
      "binding": "specified",
      "variants": [
        {
          "id": "engaged-under-roof",
          "status": "canonical",
          "note": "The arcaded corredor, 10-14 ft deep on square masonry piers, is the sole circulation for the whole quadrangle -- every room is entered from it (own defining characteristic and circulation_parti binding)."
        },
        {
          "id": "wrap-around",
          "status": "permitted",
          "note": "The corredor runs along more than one range face onto the court on a closed or three-sided quadrangle."
        },
        {
          "id": "full-width",
          "status": "forbidden",
          "note": "The corredor faces the court only; the outer face of the quadrangle is largely blind (own diagnostic tell)."
        }
      ],
      "rule": "The corredor is the type's only porch and its only circulation system; it never faces the public approach.",
      "confidence": "high",
      "status": "drafted"
    },
    "porch_depth": {
      "group": "threshold",
      "binding": "specified",
      "parameters": {
        "depth": {
          "range": [
            10,
            14
          ],
          "unit": "ft",
          "kind": "measured"
        }
      },
      "rule": "Corredor depth not less than 10 ft; below that it stops functioning as circulation and shade and becomes a covered walk (c04, hard).",
      "confidence": "high",
      "status": "drafted"
    },
    "porch_support": {
      "group": "threshold",
      "binding": "specified",
      "variants": [
        {
          "id": "square-masonry-pier",
          "status": "canonical",
          "note": "2 ft 6 in to 4 ft wide, no base, no capital, carrying a semicircular arch whose clear opening runs 1.5 to 2.5 times the pier width (c01, hard)."
        },
        {
          "id": "slender-classical-column-with-capital",
          "status": "forbidden",
          "note": "The Mission Revival's thin-pier arcade on wood frame or brick with stucco; structurally impossible in adobe and the type's own distinguished_from note against mission-revival."
        }
      ],
      "parameters": {
        "pier_width": {
          "range": [
            30,
            48
          ],
          "unit": "in",
          "kind": "measured"
        },
        "arch_opening_to_pier_ratio": {
          "range": [
            1.5,
            2.5
          ],
          "unit": "ratio",
          "kind": "measured"
        }
      },
      "rule": "Square masonry piers, not columns, under semicircular arches, with no capitals and often no imposts (own diagnostic tell).",
      "confidence": "high",
      "status": "drafted"
    },
