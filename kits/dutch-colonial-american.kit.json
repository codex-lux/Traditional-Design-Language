  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "open",
      "status": "empty"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "side-gable",
          "status": "canonical",
          "note": "The rural farmhouse -- hall-and-parlor and gambrel-block -- presents its long eave, not its gable, to the approach; door centred on five-bay work after c. 1730 (own bay_rhythm)."
        },
        {
          "id": "gambrel",
          "status": "canonical",
          "note": "The eighteenth-century arrival (c. 1720+) that gets a full upper storey out of a low wall (own long description); see roof_pitch for gambrel geometry."
        },
        {
          "id": "front-gable",
          "status": "permitted",
          "note": "The urban expression only -- Nieuw Amsterdam, Kingston, Albany -- where the parapeted gable turns to the street exactly as in the Netherlandish original (own lineage note); the inherited germanic-vernacular/low-countries-vernacular default, but not the rural family norm."
        }
      ],
      "rule": "The rural farmhouse is side-gable or gambrel, not front-gable; front-gable is the urban minority case, the reverse of what the inherited cascade states by default.",
      "confidence": "high",
      "status": "drafted"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "extends",
      "parameters": {
        "gambrel_lower_slope": {
          "range": [
            60,
            72
          ],
          "unit": "deg",
          "kind": "measured"
        },
        "gambrel_upper_slope": {
          "range": [
            18,
            30
          ],
          "unit": "deg",
          "kind": "measured"
        },
        "gambrel_break_point": {
          "range": [
            55,
            70
          ],
          "unit": "percent",
          "kind": "measured",
          "note": "Of the half-span."
        }
      },
      "rule_append": " Where the roof is gambrel rather than straight-gabled, the two slopes diverge sharply -- 60-72 degrees below, breaking to 18-30 degrees above at 55-70% of the half-span -- rather than holding one pitch throughout; a gambrel whose two slopes differ by less than 30 degrees reads as a twentieth-century barn-roof house (c03, soft).",
      "status": "drafted",
      "confidence": "high"
    },
    "roof_material": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty"
    },
    "eave_condition": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "spring-eave-flared",
          "status": "canonical",
          "applies_when": {
            "date_range": [
              1700,
              1790
            ]
          },
          "note": "The lower rafters continue past the wall face on a concave curve, projecting 18-36 in; only later given posts to become a porch (own diagnostic tell and long description)."
        },
        {
          "id": "flush-tight",
          "status": "canonical",
          "applies_when": {
            "date_range": [
              1625,
              1700
            ]
          },
          "note": "Seventeenth-century work, before the spring eave developed."
        }
      ],
      "parameters": {
        "wall_plate_height": {
          "range": [
            84,
            108
          ],
          "unit": "in",
          "kind": "measured",
          "note": "7-9 ft above the finished floor (c02, hard); above 10 ft the roof stops governing the elevation and the building reads Georgian."
        },
        "spring_eave_projection": {
          "range": [
            18,
            36
          ],
          "unit": "in",
          "kind": "measured",
          "applies_when": {
            "date_range": [
              1700,
              1790
            ]
          }
        }
      },
      "rule": "A low wall plate, 7 to 9 ft above the floor, so the roof carries most of the visual mass of the building; on eighteenth-century work a deep flared spring eave projects 18-36 in beyond the wall plane.",
      "confidence": "high",
      "status": "drafted"
    },
