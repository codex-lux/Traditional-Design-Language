    "primary_cladding": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "stone-ashlar",
          "status": "canonical",
          "applies_when": {
            "note": "entrance elevation; Hudson Valley limestone or Hackensack sandstone"
          },
          "note": "Dressed and coursed stone on the entrance elevation only, rubble on the other three -- 'a house with one good face' (own diagnostic tell and long description)."
        },
        {
          "id": "stone-rubble",
          "status": "canonical",
          "applies_when": {
            "note": "flank and rear elevations"
          }
        },
        {
          "id": "brick-common-bond",
          "status": "canonical",
          "applies_when": {
            "note": "urban gable-front work, cross bond"
          },
          "note": "Nieuw Amsterdam, Kingston, Albany, gable turned to the street."
        },
        {
          "id": "half-timber-infill",
          "status": "forbidden",
          "note": "The German Fachwerk answer, generic to the inherited germanic-vernacular ancestor; the American Dutch branch's H-bent frame is interior structure, exposed inside the room, not an exterior expressed frame-and-infill wall -- the frame retreats indoors once stone is available (own long description)."
        }
      ],
      "rule": "Walls follow the geology: dressed stone on the show face and rubble elsewhere in the country, brick in cross bond in the towns; the frame itself is never left exposed as an exterior wall the way German Fachwerk leaves it.",
      "confidence": "high",
      "status": "drafted"
    },
