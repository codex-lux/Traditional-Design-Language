    "fireplace_surround": {
      "group": "interior",
      "binding": "specified",
      "variants": [
        {
          "id": "jambless-open-hearth",
          "status": "canonical",
          "note": "No side cheeks: fire on a raised hearth against a flat wall, hood of plaster-on-lath or timber suspended on iron rods, sometimes trimmed with a valance; before c. 1750 (own long description and diagnostic tell #1). Occurs in no other American colonial tradition."
        },
        {
          "id": "bolection-moulding",
          "status": "forbidden",
          "note": "The English/Georgian answer -- a moulded surround around a recessed firebox with jambs -- is the opposite of the jambless Dutch hearth."
        }
      ],
      "rule": "The jambless fireplace is decisive and occurs in no other American tradition; anyone who has stood in front of one understands why the Dutch kept it and why the English thought it wasteful (own long description).",
      "confidence": "high",
      "status": "drafted"
