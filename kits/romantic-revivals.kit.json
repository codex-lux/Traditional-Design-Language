    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "solid-masonry-two-wythe",
          "status": "permitted",
          "note": "Renaissance Revival ('a wooden Renaissance Revival is a contradiction'), Egyptian Revival's institutional masonry, and the Italianate and Renaissance Revival brownstone/brick row branches."
        },
        {
          "id": "solid-masonry-three-wythe",
          "status": "permitted"
        },
        {
          "id": "braced-timber-frame",
          "status": "permitted"
        },
        {
          "id": "balloon-frame",
          "status": "permitted",
          "note": "The family's own defining technology: the family description names balloon framing, machine-cut nails and the steam scroll saw as the enabling condition that made the picturesque, ornament-heavy Gothic and Italianate branches affordable for the first time. Carpenter Gothic is explicitly 'light wood frame construction' with every ornamental element sawn from stock board."
        },
        {
          "id": "masonry-veneer-over-frame",
          "status": "forbidden",
          "note": "A later technique (broadly post-1900) than any member's floruit, all of which end by 1890 at the latest. Where a member builds in masonry it is genuinely load-bearing; where it builds in frame the wall is clapboard or board-and-batten over the frame, not a masonry skin."
        },
        {
          "id": "platform-frame",
          "status": "forbidden",
          "note": "Twentieth-century, after every member's floruit ends."
        },
        {
          "id": "structural-insulated-panel",
          "status": "forbidden",
          "note": "Modern manufactured technology, anachronistic to the whole family."
        }
      ],
      "rule": "The family covers the same technological transition its own description names: solid load-bearing masonry (Egyptian Revival, Renaissance Revival, and the Italianate/Renaissance Revival row-house branches) for institutional and urban work, and braced or, from the 1830s-40s on, balloon timber frame for the picturesque villa and cottage branches the sawmill made affordable. No member builds with a thin masonry veneer over a frame backup, platform framing, or a structural insulated panel \u2014 all three postdate every member's floruit, which ends by 1890 at the latest.",
      "confidence": "high",
      "status": "drafted"
    },
