    "circulation_parti": {
      "group": "plan-logic",
      "binding": "extends",
      "parameters": {
        "front_door_count": {
          "set": [
            2,
            4
          ],
          "unit": "count",
          "kind": "measured"
        }
      },
      "rule_append": " In the cottage specifically there are two or four identical front doors, one per front room, with no window between them and no way to tell which is 'the' entrance (own diagnostic tell #1); the shotgun's later, single-file, one-room-wide plan is easily confused with this but is a genuinely different, later type (own distinguished_from note).",
      "note": "Refines the parent french-colonial-american no-corridor rule with the cottage's own specific door count and the shotgun-house disambiguation.",
      "status": "drafted",
      "confidence": "high"
    },
