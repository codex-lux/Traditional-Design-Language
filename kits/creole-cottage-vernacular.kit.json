    "porch_type": {
      "group": "threshold",
      "binding": "extends",
      "variants": [
        {
          "id": "abat-vent",
          "status": "canonical",
          "op": "add",
          "note": "Unique to the Gulf Creole tradition: a roof plane or separate shed projecting 30-48 in over the sidewalk on wrought-iron rods or timber brackets, with nothing touching the ground -- the dense urban cottage's answer where posts cannot stand on the banquette (own diagnostic tell #2, c03 hard)."
        }
      ],
      "note": "Adds the abat-vent as a second, cottage-specific canonical option alongside the parent's inherited galerie.",
      "status": "drafted",
      "confidence": "high"
    },
    "porch_depth": {
      "group": "threshold",
      "binding": "extends",
      "parameters": {
        "abat_vent_projection": {
          "range": [
            30,
            48
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule_append": " Where the front shelter is an abat-vent rather than a galerie, it projects 30-48 in (c03, hard).",
