  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "near-symmetrical",
          "status": "canonical",
          "note": "The style's own proportional_system.symmetry field, and distinguished_from spanish-colonial-revival: 'a frontal, near-symmetrical two-storey block whose entire architectural argument is a single horizontal balcony.'"
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "note": "The inherited value from spanish-colonial-revival (via the regional_of edge) is this variant's own point of departure: the balcony's continuous, unbroken run depends on a frontal, near-regular composition, not a courtyard-organised asymmetrical one."
        }
      ],
      "rule": "A frontal, near-symmetrical two-storey block, entry centred or one bay off centre, three to five evenly spaced bays.",
      "confidence": "high",
      "note": "Specified rather than extends: spanish-colonial-revival's own composition_parti resolves to picturesque-asymmetrical canonical, and this variant needs the opposite ranking.",
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "side-gable",
          "status": "canonical",
          "op": "add",
          "note": "defining_characteristics: 'Low-pitched side-gable or hipped roof.' Added alongside the parent's inherited hip/cross-gable, since the two-storey balcony block is closer to a single unified block than to spanish-colonial-revival's accreted, multi-plane massing."
        }
      ],
      "note": "The parent's hip and cross-gable options are retained for the L-shaped and courtyard-u massing this style's own massing_affinities also permit; side-gable is added as this variant's own canonical case for the simple rectangular block.",
      "status": "drafted"
    },
