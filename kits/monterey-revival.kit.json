    "porch_type": {
      "group": "threshold",
      "binding": "specified",
      "variants": [
        {
          "id": "full-width",
          "status": "canonical",
          "note": "The style's whole architectural argument, per its own hard constraint c01: a balcony running the full width of the principal elevation, at the second floor rather than the ground -- massing_affinities calls it 'a gallery raised to the second storey and reduced to one face.'"
        },
        {
          "id": "recessed-loggia",
          "status": "forbidden",
          "note": "The parent style's ground-floor loggia answer is not this variant's threshold at all; the balcony is the threshold, and it is upstairs."
        },
        {
          "id": "stoop-only",
          "status": "permitted",
          "note": "At the ground-floor entry itself, subordinate to the balcony above it."
        }
      ],
      "rule": "The balcony must run the full width of the principal elevation and be not less than 6 ft deep (c01); a centred or partial balcony converts the house into an ordinary two-storey stucco box with a decorative appendage.",
      "confidence": "high",
      "status": "drafted"
    },
    "porch_depth": {
      "group": "threshold",
      "binding": "specified",
      "parameters": {
        "balcony_depth_min": {
          "value": 6,
          "unit": "ft",
          "kind": "measured",
          "note": "Hard constraint c01."
        },
        "balcony_depth_typical": {
          "range": [
            6,
            8
          ],
          "unit": "ft",
          "kind": "measured"
        }
      },
      "rule": "Below 6 ft the balcony fails as usable space and reads as trim rather than as the gallery the whole type depends on.",
      "confidence": "high",
      "note": "Overrides the inherited queen-anne-american porch-depth figures, which describe a ground-floor veranda, not this style's second-storey balcony.",
      "status": "drafted"
    },
