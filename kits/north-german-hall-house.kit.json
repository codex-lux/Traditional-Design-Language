    "circulation_parti": {
      "group": "plan-logic",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "single-axis-grootdor-to-flett",
          "status": "canonical",
          "note": "c02, hard: the Diele must run unbroken from the Grootdor to the Flett; no cross wall, stair or partition may interrupt it."
        },
        {
          "id": "cross-wall-interrupted",
          "status": "forbidden",
          "note": "c02: 'the type dies the moment one does.'"
        }
      ],
      "rule": "A single unbroken axis runs the full length of the building, from the great door in the gable to the open hearth at the far end; the Diele threshing floor occupies the whole central aisle, with cattle stalled in the flanking aisles facing inward toward it.",
      "sources": [
        "north-german-hall-house.c02",
        "north-german-hall-house.json description.long"
      ]
    },
    "hearth_position": {
      "group": "plan-logic",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "flett-open-hearth-no-chimney",
          "status": "canonical",
          "note": "c04, soft: no masonry chimney in the original type. An open hearth on a raised clay pad, unchimneyed, at the end of the Diele opposite the Grootdor."
        }
      ],
      "rule": "The Flett — an open hearth on a raised clay pad with no chimney — sits at the far end of the Diele from the Grootdor; smoke rises freely into the roof space to cure meat, dry grain and preserve the frame rather than being carried out through a flue.",
      "sources": [
        "north-german-hall-house.c04",
        "north-german-hall-house.json description.long"
      ]
