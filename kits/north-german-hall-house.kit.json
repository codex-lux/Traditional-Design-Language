      "variants": [
        {
          "id": "bay-addition-at-hearth-end",
          "status": "canonical",
          "note": "c01, hard: overall length must be a whole number of bays; growth is by adding a bay at the hearth end, never by stretching a bay."
        },
        {
          "id": "enclosure-around-a-yard",
          "status": "forbidden",
          "note": "The low-countries-vernacular family answer (Cape Dutch letter-plan, Flemish vierkantshoeve) this slot would otherwise inherit through the hybridizes_with edge to flemish-vernacular. Wrong for this node: the Diele must run unbroken from Grootdor to Flett with no cross wall (c02, hard), which enclosure-style growth around a yard would require."
        },
        {
          "id": "fixed-urban-lot-no-lateral-growth",
          "status": "forbidden",
          "note": "The dutch-urban-gable-house answer, also carried by the same family binding. Wrong here: this is a rural farm type whose whole point is that it grows, by bays, as the farm prospers."
        }
      ],
      "rule": "The building is one continuous three-aisled hall that grows only by adding a further structural bay (Fach, roughly 2.5 m) at the hearth end; it never grows by enclosing a yard with separate ranges and never sits on a fixed lot with no room to grow.",
      "note": "CASCADE-PROVENANCE FIX (WP-4.2 wave B2): left open, this slot resolves through low-countries-vernacular (spliced in via the hybridizes_with edge to flemish-vernacular, weight 0.2, inherits_kit:true) to a binding about enclosure-around-a-yard or a fixed urban lot — real facts about the Low Countries family, but not this node's own documented growth mechanism, which is bay-addition along one axis. Fixed on this node's own kit, not on low-countries-vernacular or any ancestor.",
      "sources": [
        "north-german-hall-house.c01",
        "north-german-hall-house.json defining_characteristics, description.long"
      ]
