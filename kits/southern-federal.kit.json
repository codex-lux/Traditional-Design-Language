    "depth_and_pile": {
      "group": "plan-logic",
      "binding": "specified",
      "variants": [
        {
          "id": "single-pile",
          "status": "canonical",
          "note": "Overrides the inherited Georgian double-pile default: 'one room deep so that every room is cross-ventilated and lit from two sides' (massing_affinities), the regional workhorse."
        },
        {
          "id": "double-pile",
          "status": "atypical",
          "note": "Filling in behind the passage removes the variant's climatic reason for existing and must be a deliberate, argued decision (hard constraint c01)."
        }
      ],
      "parameters": {
        "max_depth_ft": {
          "value": 20,
          "unit": "ft",
          "kind": "measured",
          "source": "southern-federal constraint c01"
        }
      },
      "rule": "No room may be more than 20 ft deep without a second exterior wall (hard constraint c01); the single-pile plan is not a cost saving but the mechanism the through-passage ventilation strategy depends on.",
      "confidence": "high",
      "status": "drafted"
