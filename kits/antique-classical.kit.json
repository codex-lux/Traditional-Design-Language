    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Both antique source styles build in real load-bearing masonry — Greek in dressed, unmortared ashlar; Roman in brick-faced concrete (opus caementicium) or dressed stone — never light timber frame. This binding fixes the family to the masonry side of every trade-split slot pair (reveal_masonry over reveal_frame, etc.). It deliberately does NOT resolve trabeated (Greek) versus arcuated (Roman) structural logic — the family's own defining_characteristics names these as 'two distinct structural logics,' and that disagreement is real and stays open for the style to decide.",
      "parameters": {
        "construction_family": {
          "value": "load-bearing masonry",
          "unit": "none",
          "kind": "measured",
          "source": "greek-classical.json / roman-classical.json defining_characteristics"
        }
      },
      "variants": [
        {
          "id": "light-timber-frame",
          "status": "forbidden",
          "note": "Neither antique source style built primary structure in timber; wood appears only as concealed roof framing above the ceiling."
        }
      ]
    },
