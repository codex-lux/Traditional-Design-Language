      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "The principal elevation is strictly bilaterally symmetrical about a central axis. Both antique source styles state this identically in their own proportional_system.symmetry field; no picturesque or additive massing occurs in either.",
      "parameters": {
        "symmetry_class": {
          "value": "strict-bilateral",
          "unit": "none",
          "kind": "measured",
          "source": "greek-classical.json / roman-classical.json proportional_system.symmetry"
        }
      },
      "variants": [
        {
          "id": "strict-bilateral-symmetry",
          "status": "canonical",
          "note": "Identical value in both members' own proportional_system.symmetry."
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "note": "Composed for a moving eye. No antique source organizes a principal facade this way; the device is a much later (Picturesque-movement) invention with no basis in either Greek or Roman practice."
        }
      ]
    },
