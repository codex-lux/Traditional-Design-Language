    "order": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "A single graduated classical order — shaft, capital and entablature varying together as one system, propagated from a single module — governs any colonnade in this family; an order is never mixed mid-run. Which specific register (Greek Doric/Ionic/Corinthian, or the Roman-codified five including Tuscan and Composite) and whether the shaft carries a base is decided at the style level: greek-classical's Doric is baseless by hard constraint (c02); roman-classical's Doric and Tuscan are always based. That disagreement is genuine and documented, not an oversight, and is left to the style kits.",
      "parameters": {
        "module_derivation": {
          "value": "single module, propagated through plan and elevation as a ratio",
          "unit": "none",
          "kind": "measured",
          "note": "Module = lower column diameter (Greek) or half the lower diameter, Vitruvian (Roman) — both members' own proportional_system.governing_logic."
        }
      }
    },
    "column": {
      "group": "classical-apparatus",
      "binding": "open",
      "status": "empty"
    },
    "entablature": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "A continuous entablature (architrave, frieze, cornice) runs above every order present, whether literally load-bearing (Greek trabeation) or applied over an arcuated bay (Roman practice — the Colosseum's superimposed arch order). Its specific proportion follows the bound order pack at the style level."
    },
    "pediment": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "Where a pediment occurs, it is a single, whole, unbroken triangular gable end — never scrolled or broken open. Broken and scrolled pediments have no antique precedent in either Greek or Roman source material cited by these two style nodes; the device belongs to the later Baroque.",
      "variants": [
        {
          "id": "whole-triangular-pediment",
          "status": "canonical"
        },
        {
          "id": "broken-or-scrolled-pediment",
          "status": "forbidden",
          "note": "A post-antique, Baroque device; absent from both members' own sources."
        }
      ]
    },
