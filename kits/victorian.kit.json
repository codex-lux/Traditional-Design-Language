    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "solid-masonry-two-wythe",
          "status": "permitted",
          "note": "Richardsonian Romanesque's load-bearing rock-faced ashlar, Queen Anne Patterned Masonry, and the Second Empire and Richardsonian brownstone/brick row branches."
        },
        {
          "id": "solid-masonry-three-wythe",
          "status": "permitted"
        },
        {
          "id": "braced-timber-frame",
          "status": "permitted"
        },
        {
          "id": "balloon-frame",
          "status": "permitted",
          "note": "The dominant construction of Folk Victorian, Stick Style, Shingle Style and the wood-clad Queen Anne subtypes; the family's floruit (1855-1910) is squarely within balloon framing's mature period."
        },
        {
          "id": "masonry-veneer-over-frame",
          "status": "forbidden",
          "note": "A later technique (broadly post-1900 in routine use), after every member's floruit ends. Masonry members in this family are genuinely load-bearing; frame members are clad in clapboard, shingle or applied stickwork over the frame, not a masonry skin."
        },
        {
          "id": "platform-frame",
          "status": "forbidden",
          "note": "Twentieth-century, after every member's floruit ends (the latest, Folk Victorian, has a decline_end of 1925 and even that predates platform framing's mainstream adoption)."
        },
        {
          "id": "structural-insulated-panel",
          "status": "forbidden",
          "note": "Modern manufactured technology, anachronistic to the whole family."
        }
      ],
      "rule": "Construction is load-bearing masonry (Richardsonian Romanesque, Queen Anne Patterned Masonry, and the row-house branches of Second Empire and Richardsonian) or braced/balloon timber frame (Folk Victorian, Stick Style, Shingle Style, and the wood-clad Queen Anne subtypes) — no branch uses a masonry veneer over a frame backup, platform framing, or a structural insulated panel, all of which postdate the family's floruit.",
      "confidence": "high",
      "status": "drafted"
    },
