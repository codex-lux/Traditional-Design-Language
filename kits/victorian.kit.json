  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "strict-bilateral-symmetry",
          "status": "forbidden",
          "note": "No member of this family uses rigid classical symmetry, not even the one member closest to it. Second Empire's own record explicitly claims only 'symmetrical or near-symmetrical... in contrast to the picturesque styles it descends from' — it is the family's single exception to picturesque massing, and even it stops at near-symmetrical, never claiming the arithmetic strict-bilateral discipline of Georgian, Federal or Greek Revival."
        },
        {
          "id": "additive-vernacular",
          "status": "permitted",
          "note": "Folk Victorian's own composition — inherited unchanged from a folk house type — is genuinely additive-vernacular; the style adds catalogue ornament to an existing folk massing without recomposing it."
        }
      ],
      "rule": "The family's defining move — 'a dominant mass with a deliberately complex silhouette' — rules out the rigid arithmetic symmetry of the classical streams outright; eight of the nine members hold some form of picturesque, balanced, or additive asymmetry, and the ninth, Second Empire, only softens to near-symmetrical rather than crossing into true classical strictness. Which of near-symmetrical, balanced-asymmetrical, picturesque-asymmetrical or additive-vernacular actually governs a given member is a per-style decision the family does not adjudicate.",
      "confidence": "high",
      "status": "drafted"
    },
