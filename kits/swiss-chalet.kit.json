      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "parameters": {
        "gable_overhang": {
          "range": [
            3.9,
            6.6
          ],
          "unit": "ft",
          "kind": "measured",
          "source": "swiss-chalet.c03",
          "note": "1.2-2.0 m in the source, converted to ft (unit vocabulary has no metre)."
        },
        "purlin_steps": {
          "value": "3 to 5, each shorter than the one below",
          "unit": "none",
          "kind": "measured"
        }
      },
      "variants": [
        {
          "id": "log-gallery-gable-with-stepped-overhang",
          "status": "canonical",
          "note": "Log courses run continuous and visible to the apex, carrying a very deep stepped overhang on shaped, stacked purlin ends; a full-width gallery (Lauben) with a sawn or turned balustrade sits under the overhang, with a carved bargeboard and a dated, carved or painted inscription band below it. All ornament in the family concentrates here (c05, soft)."
        },
        {
          "id": "half-timbered-gable",
          "status": "forbidden",
          "note": "Correct for the Fachwerk-hybrid zone of the Swiss Mittelland and northern cantons (this node's own lineage: hybridizes_with german-fachwerk, weight 0.25) but not for the alpine chalet proper this node describes, whose hearth is the Bernese Oberland and central Switzerland and whose defining_characteristics are unambiguous Blockbau."
        }
      ],
      "rule": "The gable face is the building's entire architectural statement: a very deep stepped overhang on shaped purlin ends, a full-width gallery with a balustrade, a carved bargeboard and an inscribed facade band — never a half-timbered gable, which belongs to the lowland Fachwerk-hybrid end of the family, not the alpine chalet.",
      "note": "CASCADE-PROVENANCE FIX (WP-4.2 wave B2): left open, this slot resolves through the germanic-vernacular family (spliced in via the hybridizes_with edge to german-fachwerk) to 'half-timbered' — a real fact about the Swiss Mittelland/northern-canton Fachwerk-hybrid zone, but wrong for this node's own alpine chalet, which is built in log throughout and whose gable is entirely dominated by the overhang/gallery/purlin system described here. Fixed on this node's own kit, not on germanic-vernacular, nordic-alpine-vernacular, or german-fachwerk.",
      "sources": [
        "swiss-chalet.json defining_characteristics, diagnostic_tells, description.long, c03"
      ]
    },
