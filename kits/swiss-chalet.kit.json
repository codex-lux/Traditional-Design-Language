    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "low",
      "judgment": true,
      "invented": true,
      "variants": [
        {
          "id": "garage-in-masonry-ground-storey",
          "status": "canonical",
          "note": "Invented: no historical precedent exists for any traditional style. The traditional ground storey is masonry or earth-set, holding the byre and cellar, with the log storey never meeting grade (defining_characteristics). A garage door fits that same masonry storey in place of the historic byre function, leaving the log storey, overhang and gallery on the principal elevation completely undisturbed."
        },
        {
          "id": "garage-door-in-log-storey",
          "status": "forbidden",
          "note": "Invented judgment: a wide door cut into the log storey would violate the settlement-gap and small-grouped-opening logic (window_grouping_rule, window_surround_wood) that governs every opening in a solid log wall."
        }
      ],
      "rule": "Where a garage is wanted, it is built into the masonry or earth-set ground storey that traditionally held the byre and cellar — never as an opening cut into the log storey above.",
      "note": "swiss-chalet is explicitly named in the task brief as a plausible contemporary-buildable reinterpretation, and is 'living' status with a continuing revival lineage into craftsman. Invented per docs/inheritance.md's own guidance: no traditional style has a historical answer for this slot."
