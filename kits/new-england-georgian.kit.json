          "op": "replace",
          "note": "Little building stone in eastern Massachusetts -- the whole reason the flush-board imitation exists."
        },
        {
          "id": "stucco-on-brick",
          "status": "forbidden",
          "op": "replace",
          "note": "There is no brick beneath to stucco on a wood-frame wall."
        }
