    "ornament_vocabulary": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "rule": "Ornament is not applied to a frame; it consumes the frame. Niche-pilasters (a niche with a figure cut directly into the body of the estipite), continuous deeply undercut relief, and sculpture, architecture and framing treated as one fabric with no legible boundary between figure and structural member. Ornament belongs to the west front, the transept portal, the sacristy and the retablo; nave and flank walls stay plain.",
      "parameters": {
        "relief_depth": {
          "range": [
            4,
            10
          ],
          "unit": "in",
          "kind": "measured",
          "source": "churrigueresque.json typical_ratios ('Relief depth 100-250 mm')",
          "note": "100-250mm converted to inches."
        },
        "niche_recess_depth": {
          "range": [
            12,
            24
          ],
          "unit": "in",
          "kind": "measured",
          "source": "churrigueresque.json typical_ratios ('niche recesses 300-600 mm')"
        }
      },
      "note": "defining_characteristics points 4-6 and diagnostic_tells point 4 (niche-pilasters); churrigueresque.c05 (soft, ornament confined to west front/transept portal/sacristy/retablo, nave and flank walls plain)."
    },
