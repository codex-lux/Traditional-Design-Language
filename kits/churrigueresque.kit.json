    "column": {
      "group": "classical-apparatus",
      "binding": "forbidden",
      "status": "drafted",
      "confidence": "high",
      "rule": "No ordinary classical column occurs. The estipite (see `pilaster`) has entirely displaced the column as the portada's vertical member.",
      "note": "churrigueresque.json description, direct: 'a column that has stopped being a column.' Where a vertical member appears in the portada it is the estipite, not a column proper."
    },
