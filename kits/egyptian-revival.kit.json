    "primary_cladding": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "stuccoed-brick",
          "status": "canonical",
          "note": "The Egyptian Building, Richmond, gets its effect from stuccoed brick and cast iron."
        },
        {
          "id": "dressed-sandstone-ashlar",
          "status": "canonical",
          "note": "Grove Street Cemetery Gateway, New Haven: Portland (Connecticut) sandstone."
        },
        {
          "id": "cast-iron-elements",
          "status": "permitted",
          "note": "Fence, hermai, and applied ornament at the Richmond example."
        },
        {
          "id": "clapboard",
          "status": "forbidden",
          "note": "No wood cladding; battering cannot be built in light frame (see construction_type)."
        },
        {
          "id": "board-and-batten",
          "status": "forbidden",
          "note": "Wood cladding of any kind; battering cannot be built in light frame."
        }
      ],
      "rule": "The wall is stuccoed brick or dressed stone ashlar; both surviving primary exemplars are masonry, and the mismatch between this masonry style and the era's cheap balloon frame is exactly why the mode stayed confined to institutional budgets (see the style's own long description).",
