    "construction_type": {
      "group": "envelope",
      "binding": "extends",
      "variants": [
        {
          "id": "balloon-frame",
          "status": "forbidden",
          "op": "replace",
          "note": "The style's own text is explicit: 'you cannot batter a balloon-framed wall convincingly.' Demoted from the family's permitted."
        },
        {
          "id": "braced-timber-frame",
          "status": "forbidden",
          "op": "replace",
          "note": "No frame technology batters convincingly; every surviving example is masonry (stuccoed brick, stone, or cast iron)."
        }
      ],
      "rule_append": "In practice the style is masonry only: the battered wall is a mason's and plasterer's problem, and no frame technology, braced or balloon, produces a convincing batter.",
      "confidence": "high",
      "status": "drafted"
    },
