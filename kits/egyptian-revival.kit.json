    "cornice": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "cavetto-cornice-with-torus-roll",
          "status": "canonical",
          "note": "Torus roll below cavetto cornice, in that order, with no intervening classical moulding (c02)."
        }
      ],
      "parameters": {
        "cavetto_height_to_torus_diameter_ratio": {
          "range": [
            4.8,
            7.2
          ],
          "unit": "ratio",
          "kind": "measured",
          "note": "Cavetto cornice height 0.8 to 1.2 times the torus roll diameter, times six (proportional_system typical_ratios)."
        }
      },
      "rule": "Every terminating horizontal edge is composed torus roll below cavetto cornice, in that order, without intervening classical mouldings; dentils, modillions, and egg-and-dart are forbidden anywhere on the building (c02).",
      "confidence": "high",
      "status": "drafted",
      "note": "No packs field: this style's own proportion_packs is deliberately empty (no proportion-layer coverage exists in this library for Egyptian Revival), so this cornice figure is stated as a plain measured ratio rather than a pack-derived expr."
    },
