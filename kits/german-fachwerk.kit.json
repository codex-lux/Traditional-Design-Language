    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "low",
      "judgment": true,
      "invented": true,
      "variants": [
        {
          "id": "detached-framed-outbuilding",
          "status": "canonical",
          "note": "Invented: no historical precedent exists for any traditional style (docs/inheritance.md). Built as its own small panel-framed structure in the same Gefach logic, set back from or beside the principal jettied street elevation, rather than as an integral bay or a door cut into the exposed frame."
        },
        {
          "id": "garage-door-cut-into-jettied-elevation",
          "status": "forbidden",
          "note": "Invented judgment: a wide garage-door opening would break the panel grid the whole wall depends on (see window_grouping_rule) and would have no jetty above it to carry."
        }
      ],
      "rule": "Where a garage is wanted at all, it is built as a separate small timber-framed outbuilding in the same panel logic as the house, not cut into the principal jettied and gridded elevation.",
      "note": "german-fachwerk has a continuing living trade (revival_periods 1945-2026: 'a continuing living trade of Zimmerleute repairing and building new frames'), so this slot is genuinely live rather than academic; still invented, since no traditional precedent exists for any style."
    },
