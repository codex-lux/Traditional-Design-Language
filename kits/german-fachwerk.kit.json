    "height_proportion": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": false,
      "parameters": {
        "storey_diminution_ratio": {
          "range": [
            0.85,
            0.9
          ],
          "unit": "ratio",
          "kind": "measured",
          "note": "Storey heights diminish upward by roughly 10-15 percent, per proportional_system.typical_ratios."
        },
        "jetty_projection": {
          "range": [
            200,
            400
          ],
          "unit": "mm",
          "kind": "measured",
          "source": "german-fachwerk.c03",
          "note": "Jetty projection between 200 and 400 mm per storey; beyond 400 mm a bracket (Knagge) is required at every beam end (c03, hard)."
        }
      },
      "rule": "Storeys diminish in height going up the building, and each storey above the ground floor oversails the one below by a jetty of 200-400 mm carried on the projecting floor-beam ends.",
      "sources": [
        "german-fachwerk.json proportional_system.typical_ratios",
        "german-fachwerk.c03"
      ]
    },
    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "variants": [
        {
          "id": "fixed-party-wall-vertical-growth",
          "status": "canonical",
          "note": "The urban type (massing_affinities: townhouse-row, canonical) is built to a fixed, taxed, party-walled lot with no room to grow sideways; where the building grows at all it is vertically, by adding a further jettied storey, not by adding a wing."
        },
        {
          "id": "courtyard-farm-ranges",
          "status": "permitted",
          "note": "The rural Franconian/Hessian courtyard farm (massing_affinities: linear-ell-farmhouse, common) strings house, barn and stable in framed ranges around a yard — genuine lateral growth, but only in the rural setting."
        }
      ],
      "rule": "Growth strategy depends on setting: the taxed urban lot has no lateral room and grows upward by jettied storey instead of by wing; only the rural courtyard farm adds ranges around a yard.",
      "sources": [
        "german-fachwerk.json massing_affinities"
