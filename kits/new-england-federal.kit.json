    "roof_form": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "hip",
          "status": "canonical",
          "op": "replace",
          "note": "The variant's own signature -- low hip 'frequently screened by a balustrade or captain's walk', a silhouette diagnostic_tells names directly against the steep-gabled colonial houses this variant's own carpenters had been building the season before."
        }
      ],
      "rule_append": "Where hipped, the low roof is very often screened by a balustrade or captain's walk (see balustrade) -- a device this variant's diagnostic_tells calls out as unmistakable 'in a region whose colonial houses had steep gables and a huge central chimney'.",
      "status": "drafted",
      "confidence": "medium"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "extends",
      "parameters": {
        "pitch_min": {
          "value": "6:12",
          "unit": "rise_in_12",
          "kind": "measured",
          "source": "new-england-federal constraint c04"
        },
        "pitch_max": {
          "value": "8:12",
          "unit": "rise_in_12",
          "kind": "measured",
          "source": "new-england-federal constraint c04"
        }
      },
      "rule_append": "Low enough to read Federal, steep enough to shed New England snow (soft constraint c04): below 5:12 the assembly fails in zone 5A-6A snow loads, and above 9:12 it reads colonial.",
      "status": "drafted",
      "confidence": "high"
    },
