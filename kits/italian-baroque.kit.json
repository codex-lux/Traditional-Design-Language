      "parameters": {
        "bay_narrowing_pct_per_step": {
          "range": [
            10,
            25
          ],
          "unit": "percent",
          "kind": "measured",
          "source": "italian-baroque.json constraints (italian-baroque.c03)"
        }
      },
      "variants": [
        {
          "id": "curved-wall-plan-accelerating-bays",
          "status": "canonical",
          "op": "add",
          "note": "The wall itself is a continuous deformable surface in plan (defining_characteristics), and the bay rhythm accelerates toward the axis (A-B-C-B-A, c03 hard)."
        },
        {
          "id": "flat-planar-wall-even-bays",
          "status": "forbidden",
          "op": "add",
          "note": "own distinguished_from[italian-renaissance]: 'the Renaissance wall is flat, the bays are even... If the plasticity comes from a curved wall surface it is Italian [Baroque]'."
        }
      ],
      "note": "Extends the family's strict-bilateral-symmetry binding (symmetry about the axis is retained -- 'Baroque irregularity is always resolved about an axis', own massing_affinities) with the curved-wall, accelerating-bay geometry that is this style's whole point.",
      "sources": [
        "italian-baroque.json defining_characteristics, constraints (italian-baroque.c03), massing_affinities, distinguished_from[italian-renaissance]"
      ],
