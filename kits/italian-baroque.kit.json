    "ornament_vocabulary": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Concealed and directed light (hidden lanterns, openings behind cornices) and a populated silhouette against the sky -- statues, urns, volutes, scrolled buttresses -- rather than a horizontal cornice termination. Ornament is sculptural and dynamic, organised toward a single controlled emotional effect, not a restrained, evenly-distributed treatise vocabulary.",
      "variants": [
        {
          "id": "sculptural-dynamic-concealed-light-populated-skyline",
          "status": "canonical"
        },
        {
          "id": "restrained-even-treatise-vocabulary",
          "status": "forbidden",
          "note": "This is the italian-renaissance/palladian condition, explicitly contrasted in own distinguished_from[italian-renaissance]."
        }
      ],
      "sources": [
        "italian-baroque.json defining_characteristics, diagnostic_tells"
      ],
      "group": "classical-apparatus"
    },
