    "pediment": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Pediments are broken, segmental or scrolled, used as compositional openings for a cartouche, a statue, or a window admitting light -- never merely decorative. A whole, unbroken pediment is the earlier Renaissance's device, not this one's.",
      "variants": [
        {
          "id": "broken-segmental-or-scrolled-pediment",
          "status": "canonical",
          "note": "italian-baroque.c05 (advisory): the break must be FOR something -- an empty break is a decorative tic, not a Baroque device."
        },
        {
          "id": "whole-unbroken-triangular-pediment",
          "status": "forbidden",
          "note": "CASCADE FIX. Inherited from antique-classical ('whole-triangular-pediment... broken/scrolled forbidden'), which is correct for Greek/Roman antiquity and for Palladian and italian-renaissance (both of which genuinely keep whole pediments, per their own distinguished_from text) but directly wrong for italian-baroque, whose own defining_characteristics headlines 'broken, segmental and scrolled pediments' as a diagnostic trait and whose own distinguished_from[italian-renaissance] states outright: 'whole versus broken pediments.'"
        }
      ],
      "note": "CASCADE FIX. This is the sharpest contradiction found in this batch: the family-level fix on tudor-jacobean.kit.json for entablature has a close analogue here, where a distant antique-classical binding (correct for two of the three renaissance-classical members) directly negates italian-baroque's own headline defining trait. Fixed on this node only, per WP-4.2 guidance -- italian-renaissance and palladian keep the inherited whole-pediment rule correctly.",
      "sources": [
        "italian-baroque.json defining_characteristics, diagnostic_tells, constraints (italian-baroque.c05), distinguished_from[italian-renaissance]"
      ],
      "group": "classical-apparatus"
    },
