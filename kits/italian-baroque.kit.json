    "column": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "A single bay may carry a pilaster, a half-column, a three-quarter column and a free-standing column, each in a different plane, so the facade reads as depth rather than pattern. Projection must increase monotonically toward the axis -- pilaster, then half, then three-quarter, then free-standing; random alternation of planes is noise, not Baroque layering.",
      "parameters": {
        "plane_step_in_modules": {
          "range": [
            0.5,
            1.0
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "italian-baroque.json proportional_system.typical_ratios"
        }
      },
      "variants": [
        {
          "id": "multi-plane-monotonic-projection-toward-axis",
          "status": "canonical",
          "note": "italian-baroque.c02, hard constraint."
        },
        {
          "id": "single-plane-columns",
          "status": "forbidden",
          "note": "own distinguished_from[italian-renaissance]: 'single versus multiple planes of column projection'."
        }
      ],
      "sources": [
        "italian-baroque.json defining_characteristics, constraints (italian-baroque.c02), proportional_system.typical_ratios"
      ],
      "group": "classical-apparatus"
    },
