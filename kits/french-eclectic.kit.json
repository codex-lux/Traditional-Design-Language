      "group": "openings",
      "binding": "specified",
      "variants": [
        {
          "id": "attached-subordinate-hip-wing",
          "status": "canonical",
          "note": "Continues the wall material and the constant-pitch hip roof discipline (c01) -- the style's own equivalent to a subordinate wing, authored to a house with no dominant gable to subordinate anything to."
        },
        {
          "id": "attached-subordinate-cross-gable",
          "status": "forbidden",
          "note": "Presumes a gabled massing vocabulary this style does not have (c01: no front-facing gable may exceed 25 percent of the primary elevation width -- see roof_form). Stated as a full override rather than an `extends` delta because which ancestor's own garage_strategy binding is nearest in the cascade is not stable across a corpus this large as sibling kits are authored -- this slot should stand on the style's own roof discipline (c01) regardless."
        },
        {
          "id": "detached-matching-outbuilding",
