      ],
      "parameters": {},
      "status": "drafted",
      "rule": "The style is defined by the absence of a dominant front-facing gable, which is the element that would immediately make the house read as Tudor Revival. Overrides the inherited value, which states half-timbering as the style's 'identifying gable treatment' -- true of Tudor Revival, not of this style.",
      "confidence": "high",
      "judgment": false
    },
