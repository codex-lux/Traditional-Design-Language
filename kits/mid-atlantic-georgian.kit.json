    "belt_course": {
      "group": "envelope",
      "binding": "extends",
      "variants": [
        {
          "id": "pent-roof-shed",
          "status": "canonical",
          "op": "add",
          "applies_when": {
            "date_range": [
              1715,
              1770
            ]
          },
          "note": "An unsupported shed 30-42 in deep at the second-floor line, on work before c. 1770 -- a Delaware Valley speciality appearing nowhere else in Georgian America in this form (own diagnostic tell #1). Mapped to this cardinality-many slot for lack of a dedicated pent-roof/mid-wall-shed slot in the ontology, alongside -- not instead of -- the parent's moulded belt course, since the two horizontal devices coexist (own long description: 'Two horizontal devices are the region's signature')."
        }
      ],
      "parameters": {
        "pent_projection": {
          "range": [
            30,
            42
          ],
          "unit": "in",
          "kind": "measured"
        },
        "pent_pitch": {
          "range": [
            25,
            35
          ],
          "unit": "deg",
          "kind": "measured"
        },
        "pent_corner_return": {
          "range": [
            12,
            24
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule_append": " Before about 1770, a second, competing horizontal -- the pent roof -- may also cross the facade or gable at the second-floor line: an unsupported shed 30-42 in deep at 25-35 degrees, returning 12-24 in at the corners (c05, soft); its presence dates a house to before the Revolution and within about eighty miles of Philadelphia (own long description).",
      "status": "drafted",
      "confidence": "high"
    },
