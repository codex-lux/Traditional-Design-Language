    "window_head_masonry": {
      "group": "openings",
      "binding": "extends",
      "variants": [
        {
          "id": "keystoned-flat-arch",
          "status": "canonical",
          "op": "add",
          "note": "Flat gauged brick arch with a 4-6 in rise and a 6-9 in projecting keystone -- the region's own signature, explicitly the feature tidewater-georgian's own kit forbids as wrong for Virginia ('the commonest way to build a Philadelphia front in Virginia'), and this node's own diagnostic tell #3."
        }
      ],
      "parameters": {
        "keystone_width": {
          "range": [
            6,
            9
          ],
          "unit": "in",
          "kind": "measured"
        },
        "arch_rise": {
          "range": [
            4,
            6
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule_append": " Window heads here are masonry and carry a keystone: a flat gauged brick arch, rise 4-6 in with a 6-9 in keystone, or a dressed stone lintel (c04, hard); a wood architrave head on masonry is incorrect.",
      "status": "drafted",
