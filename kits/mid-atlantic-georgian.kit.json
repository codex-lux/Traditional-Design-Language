    "construction_type": {
      "group": "envelope",
      "binding": "extends",
      "variants": [
        {
          "id": "solid-masonry-two-wythe",
          "status": "canonical",
          "op": "replace",
          "note": "18-24 in coursed stone or 13-18 in brick (c01, hard) -- the region's near-universal wall; 'the only American region where the Georgian house is normally built of stone.'"
        },
        {
          "id": "braced-timber-frame",
          "status": "atypical",
          "op": "replace",
          "note": "Demoted from the inherited Georgian family's general permitted status: masonry is this region's canonical answer, not merely one option among several."
        }
      ],
      "note": "Promotes masonry to canonical and demotes frame for this specifically stone-building region.",
      "status": "drafted",
      "confidence": "high"
    },
    "wall_thickness_masonry": {
      "group": "envelope",
      "binding": "open",
