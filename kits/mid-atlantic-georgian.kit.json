    "primary_cladding": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "stone-ashlar",
          "status": "canonical",
          "note": "Wissahickon schist or local limestone, coursed ashlar on the front, rubble elsewhere -- 'the only American region where the Georgian house is normally built of stone' (own long description)."
        },
        {
          "id": "brick-flemish-bond",
          "status": "canonical",
          "note": "Delaware and the Maryland shore."
        },
        {
          "id": "clapboard",
          "status": "forbidden",
          "note": "The New England answer; this region 'expresses its wall rather than its trim' (own long description)."
        }
      ],
      "rule": "Load-bearing masonry -- schist, limestone or brick -- is the region's near-universal wall, overriding the inherited Georgian family's wood-clapboard default.",
      "confidence": "high",
      "status": "drafted"
    },
