      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "variants": [
        {
          "id": "round-headed",
          "status": "canonical",
          "note": "defining_characteristics point 5; loggia arches are semicircular per c03 (rise = half span, within 3 percent)."
        },
        {
          "id": "square-headed",
          "status": "canonical",
          "note": "defining_characteristics point 5."
        },
        {
          "id": "pointed-or-tudor-arch",
          "status": "forbidden",
          "note": "italian-villa-vernacular.c03: pointed and Tudor arches 'are outside the tradition entirely.'"
        }
      ],
      "parameters": {
        "arch_rise_to_span": {
          "range": [
            0.47,
            0.53
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "italian-villa-vernacular.c03 (hard, tested)"
        }
      },
      "rule": "Round-headed or square-headed openings only, graded in size by storey; where an opening is arched (loggia or window), the rise is half the span within 3 percent."
    },
