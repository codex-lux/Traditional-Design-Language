    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "variants": [
        {
          "id": "balanced-asymmetrical-off-axis-tower",
          "status": "canonical",
          "note": "italian-villa-vernacular.c02 (hard): the tower must be off the centre line and exceed the block's eave height by at least 30 percent."
        },
        {
          "id": "strict-bilateral-classical",
          "status": "forbidden",
          "note": "italian-villa-vernacular.c02: a tower centred on the facade converts the composition into a symmetrical villa -- a different, Palladian type, not this one."
        }
      ],
      "parameters": {
        "tower_eave_height_excess_min_pct": {
          "value": 30,
          "unit": "percent",
          "kind": "measured",
          "source": "italian-villa-vernacular.c02"
        }
      },
      "rule": "Balanced but not strictly symmetrical: the tower -- off the centre line and exceeding the block's own eave height by at least 30 percent -- and the loggia deliberately unbalance an otherwise regular block.",
      "note": "OVERRIDES a cascade fill from antique-classical ('the principal elevation is strictly bilaterally symmetrical about a central axis'), which directly contradicts this node's own proportional_system.symmetry field ('balanced-asymmetrical') and its own hard constraint c02. The family kit (mediterranean-vernacular) deliberately left this slot open at the family level, stating explicitly: 'Symmetry class is the primary thing that tells the two members apart and is resolved at the style level, not here.' Resolved here, on this node's own kit, exactly as that note directs -- not fixed on the family kit or any other ancestor."
    },
