    "eave_condition": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "open-wide-overhang-exposed-rafter-tails",
          "status": "canonical"
        }
      ],
      "parameters": {
        "eave_projection_in": {
          "range": [
            24,
            42
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule": "Wide overhanging eave, 24-42 in, on exposed rafter tails at 24-32 in on centre, where the eave is expressed at all - the opposite of the closed, tight eave otherwise inherited, and itself the feature that distinguishes Mission Revival from Spanish Colonial Revival's minimal, closed eave (mission-revival.c05; diagnostic_tells).",
      "status": "drafted"
    },
