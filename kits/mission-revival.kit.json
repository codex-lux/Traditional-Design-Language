  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "near-symmetrical",
          "status": "canonical",
          "op": "add",
          "note": "The style's own proportional_system states symmetry directly as 'near-symmetrical'. A hipped stucco cube with a centred arcade and a parapet over the entrance reads as symmetrical from the street."
        }
      ],
      "status": "drafted"
    },
