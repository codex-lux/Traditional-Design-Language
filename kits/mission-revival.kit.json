    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "simple-rectilinear-block",
          "status": "canonical"
        },
        {
          "id": "courtyard-u-wrap",
          "status": "permitted",
          "note": "Institutional, hotel, and school examples where an arcade wraps a patio (massing_affinities)."
        }
      ],
      "rule": "Simple, blocky, largely rectilinear massing with openings cut plainly into the wall (defining_characteristics) - not a Beaux-Arts corps-de-logis with pavilion-terminated wings. The commonest residential form is a hipped stucco cube (foursquare, canonical); larger institutional work wraps an arcade around a courtyard.",
      "status": "drafted"
    },
    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "stucco-over-wood-frame",
          "status": "canonical"
        },
        {
          "id": "stucco-over-hollow-clay-tile",
          "status": "permitted"
        }
      ],
      "rule": "Thin stucco or plaster over wood frame (or, in more substantial work, hollow clay tile) - explicitly not the massive adobe of the actual missions being quoted: diagnostic_tells contrasts the revival's 'thin stucco over frame' against the original's '3-5 ft adobe'. Solid two-wythe load-bearing masonry is not this style's construction.",
      "status": "drafted"
    },
