    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "variants": [
        {
          "id": "detached-stucco-outbuilding",
          "status": "canonical"
        }
      ],
      "invented": true,
      "parameters": {},
      "rule": "The car is housed in a detached or minimally-attached stucco volume finished to match the house - plain wall, low tile-roofed or shed roof, no parapet of its own - set back from the front plane and turned off the entrance elevation, so the arcade and parapet stay the only things read from the street. No historical precedent exists for this element; this is an editorial extension consistent with the style's own logic of a plain stucco volume with a single ornamented event.",
