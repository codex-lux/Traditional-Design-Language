    "porch_type": {
      "group": "threshold",
      "binding": "specified",
      "variants": [
        {
          "id": "arcaded-veranda",
          "status": "canonical"
        }
      ],
      "parameters": {},
      "rule": "A porch or veranda carried on heavy square piers with round arches between them, engaged under the main roof or a lean-to extension of it - the arcade, not a colonnade or a Stick Style frame porch.",
      "status": "drafted"
    },
