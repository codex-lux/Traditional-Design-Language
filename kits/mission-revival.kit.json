          "range": [
            3,
            5
          ],
          "unit": "rise_in_12",
          "kind": "measured"
        }
      },
      "rule": "Roof pitch 3:12 to 5:12 in clay tile - low and quiet under the parapet, the opposite of the steep Gothic/Queen Anne roofs otherwise inherited (mission-revival.c05).",
      "status": "drafted"
    },
