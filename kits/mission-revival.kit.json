    "parapet": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "curvilinear-shaped-parapet",
          "status": "canonical"
        },
        {
          "id": "stepped-shaped-parapet",
          "status": "permitted"
        },
        {
          "id": "scalloped-shaped-parapet",
          "status": "permitted"
        }
      ],
      "parameters": {
        "parapet_height_in": {
          "range": [
            36,
            96
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule": "At least one curvilinear, scalloped, or stepped parapet (the espadana) rises a minimum of 3'0\" above the adjacent eave or roof line, usually over the entrance or at a gable end, capped with tile or a shaped coping. This is the style's single hard-required diagnostic (mission-revival.c01) and directly overrides the inherited Georgian rule that the roof is shown with no concealing parapet - here the parapet is the whole point.",
      "status": "drafted"
    },
