    "expressed_frame": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "The counterpart to the entry above: 'eave overhang 24-42 in. on exposed rafter tails where the eave is expressed at all.' Bound `structural-and-expressed` because the tails are real rafters and are also the only ornament the style permits itself.",
      "variants": [
        {
          "id": "structural-and-expressed",
          "status": "canonical",
