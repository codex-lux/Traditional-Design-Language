    "porch_support": {
      "group": "threshold",
      "binding": "specified",
      "variants": [
        {
          "id": "arcade-pier-round-arch",
          "status": "canonical"
        }
      ],
      "parameters": {
        "pier_width_in": {
          "range": [
            18,
            30
          ],
          "unit": "in",
          "kind": "measured"
        },
        "clear_span_ft": {
          "range": [
            6,
            9
          ],
          "unit": "ft",
          "kind": "measured"
        },
        "arch_spring_height_min_ft": {
          "value": 7,
          "unit": "ft",
          "kind": "measured"
        }
      },
      "rule": "Arcade piers 18-30 in wide with clear spans of 6'0\"-9'0\" and semicircular arches springing at not less than 7'0\" above the porch floor. Slender turned or classical columns are forbidden; the arcade must read as wall pierced, not as posts (mission-revival.c03). Overrides the post-and-diagonal-brace support otherwise inherited from Stick Style.",
      "status": "drafted"
    },
    "porch_rail": {
      "group": "threshold",
      "binding": "specified",
      "variants": [
        {
          "id": "none-solid-parapet-wall",
          "status": "canonical"
        }
      ],
      "parameters": {},
      "judgment": true,
      "rule": "Where a rail occurs at all it is a low solid stuccoed wall between piers, not an open baluster rail - the arcade reads as wall pierced by arches, and an open turned-baluster rail is a wood-frame Victorian device this style's own heavy-walled vocabulary does not use. Editorial inference from the style's governing plainness (c02-c04), not a directly sourced rail specification.",
      "status": "drafted"
    },
