    "gable_treatment": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "flush",
          "status": "canonical",
          "note": "Most work carries the overhang on the front only."
        },
        {
          "id": "jettied-gable-end",
          "status": "permitted",
          "note": "The overhang occasionally repeats at the gable ends as a second overhang, and rarely a third at the gable peak (own long description); at the gable end it sits at the attic floor line rather than the second-floor line (own diagnostic tell #5)."
        }
      ],
      "rule": "The overhang is primarily a front-facade feature; a gable-end repeat, where present, sits at the attic floor line, not the second-floor line.",
      "confidence": "high",
      "status": "drafted"
    },
