    "belt_course": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "framed-overhang-jetty",
          "status": "canonical",
          "note": "The style's defining feature, mapped to this slot for lack of a dedicated wall-projection/jetty slot in the 95-slot ontology (own proportion_packs note names this exact gap: 'no pack in this corpus dimensions a framed overhang'). A structural second-floor overhang on cantilevered joist ends bearing the upper posts, not a decorative applied moulding."
        }
      ],
      "parameters": {
        "overhang_framed": {
          "range": [
            14,
            20
          ],
          "unit": "in",
          "kind": "measured"
        },
        "overhang_hewn": {
          "range": [
            2,
            6
          ],
          "unit": "in",
          "kind": "measured"
        },
        "overhang_max": {
          "value": 24,
          "unit": "in",
          "kind": "measured",
          "note": "Never exceeded (c01, hard); the cantilever of a 7-9 in second-floor joist cannot be increased without changing the structure to something the tradition never built."
        },
        "pendant_count": {
          "value": 4,
          "unit": "count",
          "kind": "measured",
          "note": "Across a five-bay front, at post positions only, and only where the overhang is framed (c02, hard)."
        },
        "pendant_length": {
          "range": [
            8,
            14
          ],
          "unit": "in",
          "kind": "measured"
        },
        "pendant_diameter": {
          "range": [
            4,
            6
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule": "A framed overhang projecting 14-20 in (2-6 in if merely hewn from the solid), never more than 24 in, with four carved drop pendants at the post positions on a five-bay front. Not a fighting platform: no loopholes, no firing purpose (c05, advisory) -- the overhang is a structural and social display device, not the defensive feature folklore claims.",
      "confidence": "high",
      "status": "drafted"
    },
