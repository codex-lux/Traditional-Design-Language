          "status": "forbidden",
          "op": "add",
          "note": "Gable-end chimneys with a jetty produce a combination that does not occur in surviving First Period fabric (c03, hard)."
        }
      ],
      "parameters": {
        "count": {
          "value": 1,
          "unit": "count",
          "kind": "measured"
        }
      },
      "rule_append": " Exactly one central chimney; gable-end stacks never occur together with a jetty in surviving First Period work (c03, hard).",
      "status": "drafted",
      "confidence": "high"
