    "primary_cladding": {
      "binding": "specified",
      "variants": [
        {
          "id": "shingle",
          "status": "canonical"
        }
      ],
      "parameters": {
        "exposure": {
          "range": [
            4,
            6
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule": "The shingle field shall be continuous across every storey line, corner, and change of plane on all elevations. This single rule is what separates the style from Queen Anne and admits no exceptions.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/shingle-style.json defining_characteristics, constraints c01"
      ],
      "group": "envelope"
    },
    "secondary_cladding": {
      "binding": "forbidden",
      "rule": "No second cladding material may interrupt the continuous shingle field.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/shingle-style.json constraints c01"
      ],
      "group": "envelope"
    },
    "material_change_rule": {
      "binding": "specified",
      "rule": "The shingle field is continuous across every storey line, corner, and change of plane; the sole permitted material change is a rock-faced masonry base terminating at or below the first-floor sill line.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/shingle-style.json constraints c01, c05"
      ],
      "group": "envelope"
    },
    "foundation_expression": {
      "binding": "specified",
      "variants": [
        {
          "id": "rock-faced-stone-base",
          "status": "permitted",
          "note": "A Richardson-derived signature: the base terminates at or below the first-floor window sill line and is the only material change permitted on the elevation."
        }
      ],
      "rule": "Where a masonry base is used it shall be rock-faced, shall terminate at or below the first-floor window sill line, and shall be the only material change permitted on the elevation.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/shingle-style.json constraints c05, diagnostic_tells"
      ],
      "group": "envelope"
    },
