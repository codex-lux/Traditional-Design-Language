    "eave_condition": {
      "binding": "specified",
      "variants": [
        {
          "id": "closed-tight-no-brackets",
          "status": "canonical"
        }
      ],
      "parameters": {
        "eave_overhang_max": {
          "value": 12,
          "unit": "in",
          "kind": "measured"
        },
        "rake_overhang_max": {
          "value": 10,
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule": "Eave overhang shall not exceed 12 in and rake overhang shall not exceed 10 in, both closed tight to the wall plane with no exposed brackets, rafter tails, or purlin ends.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/shingle-style.json constraints c02"
      ],
      "group": "massing-and-roof"
