{
  "style": "shingle-style",
  "style_name": "Shingle Style",
  "ontology_version": "0.5.0",
  "kit_version": "0.2.1",
  "slots": {
    "composition_parti": {
      "binding": "extends",
      "variants": [
        {
          "id": "picturesque-asymmetrical",
          "status": "canonical",
          "op": "add"
        }
      ],
      "rule_append": "There is no module and no bay system; the design is controlled by keeping one material unbroken over an irregular volume, and by making the roof large and simple enough to gather that volume into one shape.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/shingle-style.json proportional_system"
      ],
      "group": "massing-and-roof"
    },
    "roof_form": {
      "binding": "specified",
      "variants": [
        {
          "id": "gambrel",
          "status": "canonical",
          "note": "The Colonial inheritance."
        },
        {
          "id": "cross-gable",
          "status": "permitted"
        },
        {
          "id": "catslide",
          "status": "permitted",
          "note": "The long rear catslide, taken from seventeenth-century New England to bring the roof to the ground."
        }
      ],
      "rule": "A broad sheltering roof of large simple planes, often gambrel or a long sweeping gable, coming low to the ground; the largest single plane not less than 40 percent of total roof area.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/shingle-style.json defining_characteristics, massing_affinities, proportional_system.typical_ratios"
      ],
      "group": "massing-and-roof"
    },
