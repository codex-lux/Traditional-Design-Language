    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "additive-accretive",
          "status": "canonical",
          "note": "The family's own stated central identity -- see the family node's own description: 'their expansion logic...is the property that formal styles most conspicuously lack and that a generative design system most needs.'"
        },
        {
          "id": "telescoping",
          "status": "permitted",
          "note": "The New England farmhouse's 'big house, little house, back house, barn' sequence."
        },
        {
          "id": "subordinate-ell",
          "status": "permitted",
          "note": "Farmhouse rear ell, log pen-plus-shed, camelback rear addition."
        },
        {
          "id": "none",
          "status": "permitted",
          "note": "The family's own acknowledged exception: Charleston Single House is a fixed urban type on a lot too narrow and too constrained to encode a growth logic of its own. This is not a failure to specify -- the type genuinely does not grow the way its rural and frontier siblings do."
        }
      ],
      "rule": "Growth without breaking is designed in: a dominant first-built volume anticipates the pen, the ell, or the shed that will be added later, and the combination rules -- not the ornament -- are what most of this family's identity consists of. The one true exception is the fixed-lot urban single house, which trades growth capacity for density and does not encode an expansion logic.",
      "confidence": "medium",
      "judgment": true,
      "status": "drafted",
      "note": "Grounded directly in the family's own defining_characteristics #4 ('Expansion and accretion as designed-in properties') and #2 ('Structural and climatic logic governing form directly'), and in each direct style child's own text: american-farmhouse-vernacular ('designed to grow: the first-built block anticipates the ell'); log-vernacular-american ('growth by pen addition rather than by enlarging the pen'); shotgun-house ('growth by adding rooms to the rear, or by the camelback'). charleston-single-house's own text does not discuss growth at all -- its lot is fixed and its plan is essentially complete on day one -- so it is carried here as the family's own stated exception rather than forced into the pattern. Marked judgment because binding a single family-wide slot to accommodate one explicit outlier is itself an editorial call about how to state the commonality honestly."
    },
