      "group": "interior",
      "binding": "extends",
      "variants": [],
      "parameters": {
        "lean_to_ceiling_at_main_wall": {
          "value": 84,
          "unit": "in",
          "kind": "measured",
          "note": "7 ft 0 in, where the lean-to meets the main block."
        },
        "lean_to_ceiling_at_rear_wall": {
          "range": [
            60,
            72
          ],
          "unit": "in",
          "kind": "measured",
          "note": "5 ft 0 in - 6 ft 0 in, following the rafters down."
        }
      },
      "status": "drafted",
      "rule_append": "In the lean-to the ceiling is not a plane but a slope: it follows the rafters down from 7 ft 0 in at the main house wall to 5 ft 0 in - 6 ft 0 in at the rear wall, so the governing dimension is the knee-wall head height rather than a single room height."
