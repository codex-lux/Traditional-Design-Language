{
  "style": "saltbox-colonial",
  "style_name": "Saltbox Colonial",
  "ontology_version": "0.5.0",
  "kit_version": "0.2.1",
  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "open",
      "status": "empty"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "saltbox",
          "status": "canonical",
          "op": "replace",
          "note": "The defining feature: a continuous roof plane over two full front storeys and a one-storey rear lean-to, ridge set forward at 35-45% of plan depth."
        },
        {
          "id": "side-gable",
          "status": "permitted",
          "op": "replace",
          "note": "The pre-addition state of the same house, before the lean-to is built; the front elevation reads identically either way."
        }
      ],
      "parameters": {},
      "status": "drafted",
      "note": "Own defining_characteristics and c02/c04 fix the asymmetric roof this variant exists to name; the parent's side-gable default is demoted to the pre-lean-to condition rather than removed."
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [],
      "parameters": {
        "front_slope_deg": {
          "range": [
            45,
            52
          ],
          "unit": "deg",
          "kind": "measured",
          "note": "Own hard constraint c02."
        },
        "rear_slope_broken_deg": {
          "range": [
            38,
            45
          ],
          "unit": "deg",
          "kind": "measured",
          "note": "Where the lean-to was added after the main frame; a shallower, independent rafter run."
        },
        "rear_slope_integral_deg": {
          "value": "matches front slope exactly",
          "unit": "none",
          "kind": "measured",
          "note": "Where the lean-to was framed from the start, the same rafter run simply continues past the plate."
        }
      },
      "status": "drafted",
      "rule_append": "The front slope runs 45-52 degrees; where the rear lean-to is a later addition the catslide breaks to a shallower 38-45 degrees, and where it was framed integrally the same unbroken rafter run continues at the front pitch -- the break itself is the field evidence for which happened.",
      "note": "Inherits new-england-colonial's single-slope range as the front-slope figure and adds the second, asymmetric rear slope this variant is defined by."
    },
    "roof_material": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty"
    },
    "eave_condition": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [],
      "parameters": {
        "front_eave_height_ft": {
          "range": [
            16,
            18
          ],
          "unit": "ft",
          "kind": "measured"
        },
        "rear_eave_height_ft": {
          "range": [
            6.5,
            8.5
          ],
          "unit": "ft",
          "kind": "measured",
          "note": "Own hard constraint c01: above 10 ft the catslide is cosmetic and the type is not present."
        }
      },
      "status": "drafted",
      "rule_append": "The rear eave is low enough to touch, 6 ft 6 in to 8 ft 6 in above grade, against a front eave of 16-18 ft -- the same flush, minimal eave condition the parent specifies, at two very different heights on the same building."
    },
