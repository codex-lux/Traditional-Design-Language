    "height_proportion": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "parameters": {
        "tower_slenderness": {
          "range": [
            4,
            6
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "mudejar.json typical_ratios ('Tower shaft slenderness roughly 1:4 to 1:6, square in plan')"
        }
      },
      "rule": "Where this style's dominant vertical element -- the Almohad-type square brick tower -- occurs, its shaft runs roughly 1:4 to 1:6, slenderness to plan width.",
      "note": "Scoped explicitly to the tower type (bell tower / minaret-derived), the style's own dominant vertical element per massing_affinities ('the Aragonese church tower gives a Mudejar ensemble a dominant vertical shaft'); not a general building height:width figure, since the style's own typology (church, palace, courtyard house) has no single shared massing height. Held at medium/judgment for that scoping reason."
    },
