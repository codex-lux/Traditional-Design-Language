    "belt_course": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "parameters": {
        "course_height": {
          "range": [
            2.4,
            2.8
          ],
          "unit": "in",
          "kind": "measured",
          "source": "mudejar.json typical_ratios ('Brick course plus joint 60-70 mm'), converted"
        },
        "band_depth": {
          "range": [
            3,
            9
          ],
          "unit": "courses",
          "kind": "measured",
          "source": "mudejar.json typical_ratios ('ornamental bands 3-9 courses deep')"
        }
      },
      "rule": "Wall ornament is generated entirely by offsetting, corbelling and rotating whole bricks -- dogtooth bands (esquinillas), sunken panels, interlaced blind arcading -- never by carving, moulding or casting a brick profile. Bands are dimensioned in whole brick courses, 3-9 courses deep.",
      "note": "mudejar.c01 (hard): 'Brick ornament must be generated by whole-brick offsets, rotations and corbels. Carved, moulded or cast brick profiles are prohibited.' diagnostic_tells point 1."
    },
