  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "rule": "Composition is near-symmetrical, not strictly bilateral: towers are panelled with two or three tall recessed divisions per face, subdivided by horizontal ornament bands, and naves are rhythmed by the diaphragm arches carrying the timber roof -- a near-regular, brick-module-driven order rather than a classical axial symmetry.",
      "note": "OVERRIDES a cascade fill from antique-classical ('strictly bilaterally symmetrical about a central axis... no picturesque or additive massing'), which directly contradicts this node's own proportional_system.symmetry field, stated in as many words as 'near-symmetrical.' The antique-classical figure reaches this node only through the generic classical-apparatus-adjacent chain (roman-classical/antique-classical/greek-classical), a route that was never meant to license a stricter symmetry than this node's own text supports. Fixed here per WP-4.2 instructions rather than on any ancestor kit."
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "variants": [
        {
          "id": "par-y-nudillo",
          "status": "canonical",
          "note": "Tie-beam, rafters and collar as one assembly, boarded and worked into an interlace of small timbers (lazo). The ceiling and the roof are the same object."
        },
        {
          "id": "suspended-ceiling-below-separate-roof",
          "status": "forbidden",
          "note": "mudejar.c02 (hard): 'a suspended ceiling below a separate roof is a different tradition.'"
        }
      ],
      "rule": "Timber roofs are armadura de par y nudillo -- tie-beam, rafters and collar built and finished as a single assembly, its underside boarded and worked into interlaced strapwork (lazo). There is no structural roof above and a decorative ceiling below; they are one object.",
      "note": "mudejar.c02 (hard); defining_characteristics point 3; description, long."
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "parameters": {
        "pitch_deg": {
          "set": [
            26.5,
            33.7
          ],
          "unit": "deg",
          "kind": "measured",
          "source": "mudejar.json proportional_system / typical_ratios ('cartabon de armadura cuadrada, giving a pitch near 26.5 degrees'; 'commonly 26.5 or 33.7 degrees')"
        }
      },
      "rule": "Pitch is fixed for the whole building by a single cartabon (a fixed wooden setting-out square), not chosen independently room by room; the commonest gives a pitch near 26.5 or 33.7 degrees.",
      "note": "governing_logic, direct."
    },
