        },
        {
          "id": "timber-eaves-cornice-in-town",
          "status": "forbidden",
          "note": "Prohibited by the London Building Act of 1707 after the fires; a period-correct London house cannot have one."
        }
      ],
      "parameters": {
        "cornice_projection_ratio": {
          "value": 1.0,
          "unit": "ratio",
          "kind": "measured",
          "source": "Gibbs, Rules for Drawing, 1732",
          "note": "An entablature-derived cornice projects about its own height. A boxed domestic cornice projects roughly 0.43 of its height; applying either figure to the other condition produces a distinct disaster. See fault cornice-that-is-a-fascia."
        }
      },
      "status": "drafted",
      "confidence": "high",
      "rule": "A full classical entablature at the eaves in the country; in London, outlawed in timber by the 1707 Act and replaced by a brick or stone cornice behind a parapet.",
      "packs": [
        {
          "pack": "gibbs-ionic",
          "precedence": 1
        }
      ],
      "code_conflict": [
        {
          "period_value": "Timber eaves cornice, country work",
          "code_requirement": "London Building Act 1707 prohibited projecting timber cornices",
          "resolution": "Parapet with a brick or stone cornice in town; the timber version is correct only outside the Acts' reach.",
          "severity": "blocking"
        }
      ],
      "sources": [
        "Gibbs, Rules for Drawing the Several Parts of Architecture, 1732",
        "Summerson, Georgian London",
