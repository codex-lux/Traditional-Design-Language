  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "variants": [
        {
          "id": "strict-bilateral-odd-bay",
          "status": "canonical"
        },
        {
          "id": "side-entrance-terrace",
          "status": "permitted",
          "note": "The London terrace case: entrance to one side, but bays still align vertically and the storey graduation is unbroken."
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "note": "The whole point of the style is that the facade is composed before the plan is drawn."
        },
        {
          "id": "even-bay-front",
          "status": "forbidden",
          "note": "An even number of bays leaves no centre to enter."
        }
      ],
      "parameters": {
        "bay_count": {
          "set": [
            3,
            5,
            7
          ],
          "unit": "count",
          "kind": "measured"
        },
        "facade_symmetry_tolerance_in": {
          "value": 2,
          "unit": "in",
          "kind": "editorial",
          "note": "Bay centres either align or they do not; two inches is construction tolerance, not licence."
        }
      },
      "rule": "Strict bilateral symmetry about a centred entrance, an odd number of bays, and a single dominant mass. The English town house accepts a side entrance on a narrow lot without abandoning the vertical alignment of the bays.",
      "sources": [
        "Gibbs, Rules for Drawing the Several Parts of Architecture, 1732",
        "Summerson, Georgian London",
        "Cruickshank and Wyld, London: The Art of Georgian Building",
        "Ayres, Building the Georgian City"
      ]
    },
