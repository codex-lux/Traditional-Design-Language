          "status": "forbidden",
          "note": "Superseded before the period opens; a leaded casement on a Georgian front is a century out."
        }
      ],
      "parameters": {
        "sash_setback_in": {
          "value": 4,
          "unit": "in",
          "kind": "measured",
          "note": "The 1709 Act required the frame set back four inches from the face; the 1774 Act required the box concealed entirely behind the reveal. The setback dates the house to a decade."
        },
        "glazing_bar_width_in": {
          "range": [
            0.625,
            1.0
          ],
          "unit": "in",
          "kind": "measured",
          "note": "Thinner as the century advances: about an inch in 1700, five eighths by 1800. The single best dating tell available from the street."
        }
      },
      "status": "drafted",
      "confidence": "high",
      "rule": "The vertically sliding sash, counterweighted in a boxed frame, and its history is legible in how far the box is set back from the face.",
      "code_conflict": [
        {
          "period_value": "Sash box flush with the face before 1709, set back 4 in after, concealed after 1774",
          "code_requirement": "Modern energy code drives insulated units that will not fit a period box",
          "resolution": "Slim-profile double glazing in a full-depth box, or single glazing with secondary internal glazing where the elevation matters more than the U-value.",
          "severity": "material"
        }
      ],
