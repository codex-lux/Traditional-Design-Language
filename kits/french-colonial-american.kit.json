    "circulation_parti": {
      "group": "plan-logic",
      "binding": "specified",
      "variants": [
        {
          "id": "no-corridor-room-to-room",
          "status": "canonical",
          "note": "Circulation is room to room through paired French casement doors, or by stepping out onto the galerie and re-entering elsewhere; there is no hall and no single privileged front door (own long description, hard constraint c01)."
        },
        {
          "id": "center-hall",
          "status": "forbidden",
          "note": "A hall is a room with one door and no cross-breeze -- a dead room in this climate (own long description); its presence is the decisive plan test against the later Anglo and Greek Revival successors (own distinguished_from notes)."
        }
      ],
      "rule": "No interior corridor; every habitable room has openings on two opposite or adjacent walls for cross-ventilation (c01, hard).",
      "confidence": "high",
      "status": "drafted"
