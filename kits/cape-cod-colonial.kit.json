    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "extends",
      "parameters": {
        "growth_sequence": {
          "set": [
            "quarter",
            "half",
            "three-quarter",
            "full"
          ],
          "unit": "none",
          "kind": "measured",
          "note": "Door begins offset toward one end and steps toward the centre as bays are added; the chimney stays fixed throughout (see chimney)."
        }
      },
      "rule_append": " In the Cape specifically this is a named, literal growth grammar -- quarter, half, three-quarter, full -- legible on the facade as the count and placement of window bays around a fixed chimney, not merely additive in the abstract sense the parent family states.",
      "status": "drafted",
      "confidence": "high"
    },
