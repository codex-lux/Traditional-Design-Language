    "construction_type": {
      "group": "envelope",
      "binding": "extends",
      "status": "drafted",
      "variants": [
        {
          "id": "adobe",
          "status": "canonical",
          "op": "replace",
          "note": "Moulded sun-dried brick in a wooden form -- the Spanish contribution to the older Puebloan coursed-earth tradition."
        },
        {
          "id": "rammed-earth",
          "status": "forbidden",
          "op": "replace",
          "note": "Not this branch's technique; own description is specific to moulded adobe brick, not tapia."
        },
        {
          "id": "solid-masonry-two-wythe",
          "status": "forbidden",
          "op": "replace",
          "note": "No coursed stone or brick masonry tradition here; contrast the coquina of Florida or the rubble of California."
        },
        {
          "id": "solid-masonry-three-wythe",
          "status": "forbidden",
          "op": "replace",
          "note": "No coursed stone or brick masonry tradition here."
        },
        {
          "id": "braced-timber-frame",
          "status": "forbidden",
          "op": "replace",
          "note": "No timber-frame branch survives in this variant; even the roof framing is post-and-beam vigas laid on a bearing wall, not a stud frame."
        }
      ]
    },
