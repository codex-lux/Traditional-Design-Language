    "eave_condition": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "exposed-rafter-tails",
          "status": "canonical",
          "note": "The vigas themselves, projecting through the wall and genuinely carrying the roof -- own hard constraint c05: 'non-structural applied viga ends are the single clearest marker of Pueblo Revival.'"
        },
        {
          "id": "bracketed-eave",
          "status": "forbidden",
          "note": "No pitched-roof eave assembly exists on the flat-roof condition; the only projection is the structural viga."
        },
        {
          "id": "fascia-and-gutter-eave",
          "status": "forbidden",
          "note": "There is no eave in the pitched-roof sense at all; the roof edge is the parapet, and water leaves through canales, not a gutter."
        }
      ],
      "parameters": {
        "viga_projection_in": {
          "range": [
            12,
            24
          ],
          "unit": "in",
          "kind": "measured",
          "note": "Own hard constraint c05."
        }
      },
      "status": "drafted",
      "rule": "The roof has no eave in the ordinary sense: it terminates at the parapet, and the only projection beyond the wall face is the structural viga ends, 12 to 24 in, which must actually carry the roof.",
      "confidence": "high"
    },
