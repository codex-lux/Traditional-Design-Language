{
  "style": "stick-style",
  "style_name": "Stick Style",
  "ontology_version": "0.6.0",
  "kit_version": "0.2.1",
  "slots": {
    "composition_parti": {
      "binding": "extends",
      "variants": [
        {
          "id": "picturesque-asymmetrical",
          "status": "canonical",
          "op": "add"
        }
      ],
      "rule_append": "No single mass shall exceed any other by more than 30 percent in height or plan area (c05, soft): Stick Style composition is a balance of comparable gables, not a dominant-mass hierarchy; a dominant mass produces a Queen Anne house instead.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/stick-style.json proportional_system, constraints c05"
      ],
      "group": "massing-and-roof"
    },
    "roof_form": {
      "binding": "specified",
      "variants": [
        {
          "id": "cross-gable",
          "status": "canonical"
        },
        {
          "id": "gable-front-and-wing",
          "status": "permitted"
        }
      ],
      "rule": "Steep gabled roofs with prominent cross gables and a vigorous irregular silhouette, composed of masses of comparable weight rather than one dominant volume.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/stick-style.json defining_characteristics, massing_affinities"
      ],
      "group": "massing-and-roof"
    },
    "roof_pitch": {
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": "9:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_max": {
          "value": "14:12",
          "unit": "rise_in_12",
          "kind": "measured"
        }
      },
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/stick-style.json proportional_system.typical_ratios"
      ],
      "group": "massing-and-roof"
    },
    "roof_material": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty"
    },
    "eave_condition": {
      "binding": "specified",
      "variants": [
        {
          "id": "exposed-bracket-or-rafter-tail",
          "status": "canonical"
        },
        {
          "id": "boxed-no-support",
          "status": "forbidden",
          "note": "A boxed eave with no visible support contradicts the style's entire premise (c04)."
        }
      ],
      "parameters": {
        "overhang": {
          "range": [
            18,
            36
          ],
          "unit": "in",
          "kind": "measured"
        },
        "bracket_spacing": {
          "range": [
            24,
            48
          ],
          "unit": "in",
          "kind": "measured",
          "note": "On centre."
        }
      },
      "rule": "Deep overhanging eaves on exposed brackets, purlins, or rafter tails.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/stick-style.json defining_characteristics, constraints c04"
      ],
      "group": "massing-and-roof"
