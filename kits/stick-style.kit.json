    "porch_support": {
      "binding": "specified",
      "variants": [
        {
          "id": "post-and-diagonal-brace",
          "status": "canonical"
        },
        {
          "id": "turned-post",
          "status": "forbidden",
          "note": "No turned spindles anywhere in the stickwork; a turned member moves the building to Queen Anne."
        }
      ],
      "parameters": {
        "post_size_nominal": {
          "set": [
            "5x5",
            "6x6",
            "7x7",
            "8x8"
          ],
          "unit": "none",
          "kind": "measured"
        },
        "brace_angle": {
          "value": 45,
          "unit": "deg",
          "kind": "measured"
        },
        "brace_length_ratio": {
          "range": [
            0.3,
            0.5
          ],
          "unit": "ratio",
          "kind": "measured",
          "note": "Of post height."
        }
      },
      "rule": "Porches and verandas built as visible frames of posts, diagonal braces, and open rails rather than as trabeated classical structures. Entirely rectilinear: no turned spindles, no scrolled brackets, no curved members anywhere.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/stick-style.json defining_characteristics, proportional_system.typical_ratios, diagnostic_tells"
      ],
      "group": "threshold"
    },
