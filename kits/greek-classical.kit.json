      "parameters": {
        "structural_logic": {
          "value": "trabeated",
          "unit": "none",
          "kind": "measured",
          "source": "greek-classical.json defining_characteristics"
        }
      },
      "variants": [
        {
          "id": "trabeated-dressed-ashlar-no-mortar",
          "status": "canonical",
          "op": "add",
          "note": "Post and lintel in dressed, unmortared stone — no arch, no vault, no mortar anywhere in the primary structure. Practical lintel spans top out around 5-6 m (c03), which is why the colonnade is dense and becomes the architectural subject."
        },
        {
          "id": "arcuated-concrete-or-brick",
          "status": "forbidden",
          "op": "add",
          "note": "The Roman answer to the same family-level masonry binding — see roman-classical's own construction_type, where this is canonical."
        }
      ],
      "rule_append": "Specifically trabeated: post-and-lintel dressed stone with no arch, no vault and no mortar anywhere in the primary structure.",
      "note": "Resolves the family's own explicitly-left-open trabeated/arcuated split (antique-classical.construction_type note: 'It deliberately does NOT resolve trabeated (Greek) versus arcuated (Roman) structural logic... that disagreement is real and stays open for the style to decide'). See roman-classical's own construction_type for the mirror-image resolution.",
      "sources": [
        "greek-classical.json defining_characteristics"
      ]
    },
