    "column": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "parameters": {
        "column_height_doric_diameters": {
          "range": [
            4,
            6.5
          ],
          "unit": "ratio",
          "kind": "measured",
          "note": "In lower column diameters. The tradition steadily lightens: Archaic Paestum ~4.3, Parthenon 5.48, late Hellenistic ~6.5."
        },
        "entasis_diminution": {
          "range": [
            0.1667,
            0.2
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "greek-classical.c04",
          "note": "1/6 to 1/5 of the lower diameter."
        },
        "intercolumniation_diameters": {
          "range": [
            1.2,
            1.7
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "greek-classical.c03",
          "note": "Clear span between column axes, in lower diameters."
        }
      },
      "variants": [
        {
          "id": "doric-baseless",
          "status": "canonical",
          "note": "c02, hard: 'A Doric column may not be given a moulded base... if a base is required, the order must change to Ionic or the reference must change to Roman.' The single sharpest diagnostic separating Greek from Roman practice."
        },
        {
          "id": "doric-with-moulded-base",
          "status": "forbidden",
          "note": "Roman, not Greek — see roman-classical's own column binding, where a moulded base is canonical for Doric and Tuscan."
        },
        {
          "id": "ionic-with-base",
          "status": "permitted",
          "note": "The base/no-base fault line is specifically the Doric order; the Erechtheion's own Ionic columns are based."
        }
      ],
      "rule": "Doric stands directly on the stylobate with no base at all. Entasis begins only above roughly the lower third of the shaft, diminishing by 1/6 to 1/5 of the lower diameter with a maximum swell of 1.5-2 percent over a straight-line taper (c04, soft). Corner columns are thickened and set closer than the typical bay — an optical correction against a bright sky.",
      "sources": [
        "greek-classical.c02",
        "greek-classical.c03",
        "greek-classical.c04",
        "greek-classical.json proportional_system"
      ]
    },
