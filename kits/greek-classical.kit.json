    "frieze": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "doric-triglyph-metope-contracted-corner",
          "status": "canonical",
          "note": "A triglyph sits over every column axis and must also land flush at the corner; since that is geometrically impossible at constant spacing, the last one or two intercolumniations contract by roughly half a triglyph width (c05, hard). The single most reliable proof of authentic Doric grammar."
        },
        {
          "id": "doric-uncontracted-corner",
          "status": "forbidden",
          "note": "c05, hard: 'an uncontracted corner with a half-metope is a revivalist error, not a Greek option.'"
        },
        {
          "id": "ionic-continuous-sculptured-frieze",
          "status": "permitted",
          "note": "Where the Ionic order is used, the frieze may instead run as a continuous sculptured band with no triglyph module."
        }
      ],
      "rule": "Where the Doric order is used, corner contraction is mandatory wherever a triglyph frieze is used — not a refinement but a rule (c05, hard).",
      "sources": [
        "greek-classical.c05",
        "greek-classical.json proportional_system.bay_rhythm"
      ]
    },
