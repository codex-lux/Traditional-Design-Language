    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "parameters": {
        "roof_slope_deg": {
          "range": [
            12,
            17
          ],
          "unit": "deg",
          "kind": "measured",
          "source": "greek-classical.c01"
        }
      },
      "rule": "Very shallow — 12 to 17 degrees, so the gable reads almost flat compared with any post-medieval revival. Above 20 degrees the profile reads Roman or Renaissance; above 30 it reads as a domestic gable with a pediment drawn on it (c01, hard).",
      "sources": [
        "greek-classical.c01"
      ]
