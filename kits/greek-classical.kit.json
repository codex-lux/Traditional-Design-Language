    "street_relationship": {
      "group": "site",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "variants": [
        {
          "id": "blind-wall-inward-courtyard",
          "status": "canonical",
          "note": "massing_affinities: courtyard-full, canonical."
        }
      ],
      "rule": "The Greek house (oikos) presents a nearly blind wall to the street; the architectural investment goes into the inward-facing court, not the public face. Domestic and temple architecture in this style share almost nothing — the temple is an exterior object meant to be walked around, the house turns inward.",
      "note": "Judgment: drawn from massing_affinities (courtyard-full, canonical) together with the description's own explicit statement ('The Greek oikos is an inward-turning court house presenting a nearly blind wall to the street; the domestic architecture and the temple architecture share almost nothing') rather than from a numbered constraint.",
