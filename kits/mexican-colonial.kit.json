    "outbuilding_types": {
      "group": "site",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "rule": "At religious sites, the church stands within a walled atrio large enough to hold a crowd outdoors, with a raised capilla abierta (open chapel) for saying mass to that crowd and four posa chapels at the atrio's corners for processional stations -- a New World invention with no Spanish precedent.",
      "note": "defining_characteristics point 8, direct: 'The walled atrio with open chapel and posa chapels at religious sites -- a New World type with no Spanish precedent.' description, long, paragraph 2 (the Franciscan/Dominican/Augustinian mass-conversion programme of the 1530s-40s)."
    },
