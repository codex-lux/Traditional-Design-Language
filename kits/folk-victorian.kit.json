    "composition_parti": {
      "binding": "extends",
      "variants": [
        {
          "id": "additive-vernacular",
          "status": "canonical",
          "op": "replace",
          "note": "Promoted from the family's 'permitted' to this style's canonical and only real case: massing is inherited unchanged from the folk house type, and ornament never recomposes it."
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "op": "add",
          "note": "c01: a tower, wraparound porch, or polygonal bay above the first floor converts the building to Queen Anne outright; this style keeps a folk footprint of not more than two primary volumes."
        }
      ],
      "rule_append": "Concretely: gable-front, gable-front-and-wing, I-house, hall-and-parlor, or pyramidal-cottage massing, unchanged from the underlying folk type; the ornament is confined to zones that type already had.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
