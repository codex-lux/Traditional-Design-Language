    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "variants": [
        {
          "id": "additive-vernacular",
          "status": "canonical",
          "note": "The node's own proportional_system.symmetry, verbatim."
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "note": "massing_affinities: 'the irregularity is a byproduct of accretion, never a composition... reads immediately as false here.'"
        },
        {
          "id": "strict-bilateral-classical",
          "status": "forbidden",
          "note": "tuscan-vernacular.c04 (soft): 'imposed symmetry converts the building into a villa' -- a different member of this family, not this one."
        }
      ],
      "rule": "Growth is by repetition of a roughly 4.0-4.5 m cell along the contour, with openings placed by what is behind them; imposed symmetry or a designed picturesque irregularity are both outside the type. Openings do not need to stack between storeys.",
      "note": "OVERRIDES a cascade fill from antique-classical ('strictly bilaterally symmetrical... no picturesque or additive massing'), which is the near-exact opposite of this node's own bay_rhythm field and its own soft constraint c04. The family kit (mediterranean-vernacular) deliberately left this slot open, stating explicitly: 'Symmetry class is the primary thing that tells the two members apart and is resolved at the style level, not here.' Resolved here per that note -- not fixed on the family kit or any other ancestor."
    },
