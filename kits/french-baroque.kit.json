    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "confidence": "high",
      "variants": [
        {
          "id": "brisee-mansard",
          "status": "canonical",
          "note": "defining_characteristics: 'The brisee or mansard roof, steep below and shallow above, preserving the habitable attic while cutting the silhouette.' Each pavilion carries its own independently terminated roof mass (hard constraint c02)."
        }
      ],
      "parameters": {
        "lower_slope_deg": {
          "range": [
            65,
            75
          ],
          "unit": "deg",
          "kind": "measured",
          "source": "french-baroque.json constraints c03"
        },
        "upper_slope_deg": {
          "range": [
            20,
            30
          ],
          "unit": "deg",
          "kind": "measured",
          "source": "french-baroque.json constraints c03"
        },
        "break_point_fraction": {
          "range": [
            0.6,
            0.7
          ],
          "unit": "ratio",
          "kind": "measured",
          "note": "Fraction of total roof height at which the slope breaks."
        }
      },
      "rule": "The brisee/mansard roof: lower slope 65-75 degrees, upper slope 20-30 degrees, breaking at 0.6-0.7 of total roof height (hard constraint c03) -- outside that range it reads as a Victorian mansard block. Every projecting pavilion carries its own independently terminated roof mass (c02).",
      "sources": [
        "french-baroque.json defining_characteristics, constraints c02, c03"
      ],
      "status": "drafted"
    },
