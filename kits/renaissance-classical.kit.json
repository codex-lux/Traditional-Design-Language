      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "The principal elevation is strictly bilaterally symmetrical. All three members state this identically in their own proportional_system.symmetry field; two of the three (italian-renaissance, italian-baroque) explicitly mark 'massed-picturesque' massing forbidden in their own massing_affinities, and the third (palladian) is unambiguously symmetrical about its dominant centre.",
      "parameters": {
        "symmetry_class": {
          "value": "strict-bilateral",
          "unit": "none",
          "kind": "measured",
          "source": "italian-renaissance.json / palladian.json / italian-baroque.json proportional_system.symmetry"
        }
      },
      "variants": [
        {
          "id": "strict-bilateral-symmetry",
          "status": "canonical",
          "note": "Identical value across all three members' own proportional_system.symmetry."
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "note": "italian-renaissance and italian-baroque both mark 'massed-picturesque' forbidden in their own massing_affinities — 'the precise negation of the Renaissance argument that a building is a single resolved figure,' and Baroque irregularity 'is always resolved about an axis.'"
        }
      ]
    },
