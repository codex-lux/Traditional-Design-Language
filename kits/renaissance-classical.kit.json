    "ceiling_height_rule": {
      "group": "interior",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "Room ceiling height is derived from the room's own plan proportion — the arithmetic, geometric or harmonic mean of its width and length — rather than set independently of the plan. Stated directly as governing_logic for palladian and confirmed as italian-renaissance's own founding method (both bind the room-harmonic pack directly, unmodified); italian-baroque's fit is real but weaker, and its own room-harmonic binding note says so explicitly: the pack 'governs the individual room... it does not reach... the oval, triangle-and-circle plan geometry that generates the whole building.'",
      "parameters": {
        "mean_type": {
          "set": [
            "arithmetic",
            "geometric",
            "harmonic"
          ],
          "unit": "none",
          "kind": "measured",
          "source": "Palladio, I quattro libri, Book I ch. XXIII; Wittkower (1949)"
        }
      }
    },
