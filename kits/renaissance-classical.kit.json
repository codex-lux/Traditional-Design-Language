    "order": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "A single treatise-derived classical order — module-propagated, shaft, capital and entablature varying together — governs any colonnade; where registers are superimposed they run heavier/plainer below to lighter/richer above. Which specific order(s) and which treatise (Palladio's own, for italian-renaissance and palladian; Vignola's, for italian-baroque) is decided at the style level, not here."
    },
    "column": {
      "group": "classical-apparatus",
      "binding": "open",
      "status": "empty"
    },
    "entablature": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "A continuous entablature runs above the order and terminates the composition. Even where the wall itself is deformed, the entablature must remain one continuous member: italian-baroque's own hard constraint (c01) makes a straight entablature over a curved wall an error, and italian-renaissance's crowning cornice — the same member read at building scale — is its own single most diagnostic feature (its own c03, 1/12-1/16 of facade height)."
    },
    "pediment": {
      "group": "classical-apparatus",
      "binding": "open",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "note": "Deliberately left open: the members directly contradict each other. italian-renaissance's own c05 reserves the pedimented portico for churches and forbids it on a domestic front ('no pedimented projecting portico on a domestic front'); palladian's defining_characteristics puts exactly that — 'the temple front... applied to a domestic building' — at the center of its own identity. Forcing one answer here would silently overwrite whichever style is right.",
      "rule": "Whether a pedimented portico may appear on a domestic front is a real, documented disagreement within the family and is resolved at the style level, not here.",
      "variants": [
        {
          "id": "temple-front-portico-on-house",
          "status": "permitted",
          "note": "palladian's own defining identity; 'a pediment over a house rather than over a church' is its fastest diagnostic tell."
        },
        {
          "id": "reserved-for-churches-not-houses",
          "status": "permitted",
          "note": "italian-renaissance's own c05 (soft, cultural): the temple front is reserved for churches until Palladio."
        }
      ]
    },
