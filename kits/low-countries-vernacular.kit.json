    "gable_treatment": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "rule": "The gable is the family's principal site of architectural expression — a shaped wall rising above or dominating the roofline — but its specific geometry is NOT shared and differs sharply by member.",
      "judgment": true,
      "confidence": "medium",
      "variants": [
        {
          "id": "free-standing-screen-gable",
          "status": "permitted",
          "note": "cape-dutch: a moulded, plastered gable 'standing free above the eave line of a thatched roof' (curvilinear/holbol geometry). dutch-urban-gable-house: 'a decorated masonry gable screen ... resolving on a single vertical axis' that is explicitly 'a screen in front of the roof, not the end of it' (stepped/neck/bell geometry)."
        },
        {
          "id": "structural-gable-as-roof-end",
          "status": "permitted",
          "note": "flemish-vernacular: 'the gable is structural' and 'genuinely the end of a roof rather than a screen in front of one' — the opposite condition from the other two members. Stepped (crow-stepped), capped in stone or tile."
        }
      ],
      "note": "No proportion pack in this corpus currently models any of these gable geometries — a curvilinear Cape Dutch module, or a stepped/bell/neck module for the Low Countries urban front — named as a real, unresolved gap in docs/reports/wp-4.1-proportion-pack-bindings.md ('no \"gable geometry\" system of any kind currently exists in the library'). This slot is authored as editorial judgment for that reason, not derived from any pack, and stays that way until such a pack exists."
    },
