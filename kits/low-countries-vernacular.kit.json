      "status": "drafted",
      "rule": "Growth strategy divides cleanly in two, by settlement type, and the two do not converge to one family-wide answer.",
      "judgment": false,
      "confidence": "high",
      "variants": [
        {
          "id": "rural-additive-enclosure",
          "status": "permitted",
          "note": "cape-dutch: additive letter-plan growth, langhuis to T to U to H, ranges pinwheeling around a small rear court within a walled werf. flemish-vernacular: growth by enclosure, single range to L to three-sided to a fully closed square farm (vierkantshoeve) with one gated entrance."
        },
        {
          "id": "none-fixed-urban-lot",
          "status": "permitted",
          "note": "dutch-urban-gable-house: a single fixed-frontage taxed lot; the house grows upward and backward within one build, never by adding a second range or enclosing a yard — there is no working precinct to enclose."
        }
      ]
