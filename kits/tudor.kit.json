    "ornament_vocabulary": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Renaissance figural ornament -- a terracotta roundel of a Roman emperor, a putto, a shell or a cartouche -- appears only as an inset panel, roundel or cresting set into an otherwise Gothic surface, and may not exceed roughly 5 percent of the elevation. It is never assembled into a classical order, entablature or applied system: this is Renaissance MOTIF borrowed as jewellery, not the classical ornament vocabulary (swag-and-urn, guttae-triglyph, acanthus, fan-and-patera) that would imply a real order stands behind it.",
      "parameters": {
        "max_coverage_pct": {
          "value": 5,
          "unit": "percent",
          "kind": "measured",
          "source": "tudor.json constraints (tudor.c02)"
        }
      },
      "variants": [
        {
          "id": "renaissance-inset-panel-roundel-cresting",
          "status": "canonical",
          "note": "Terracotta roundels (Giovanni da Maiano's Hampton Court emperors, 1521), putti, shells -- transmitted by Italian craftsmen working physically in England, per own lineage note, but confined to surface insets."
        },
        {
          "id": "applied-classical-order-or-entablature",
          "status": "forbidden",
          "note": "tudor.c02: classical orders may not be used structurally at all; this is a stricter rule than the family's own blanket ornament prohibition, which the medieval-british family kit correctly leaves as the default but which this node's own text lets nuance: SOME Renaissance ornament is real and documented, capped and confined."
        }
      ],
      "note": "Refines rather than contradicts the family-inherited forbidden binding on this slot (medieval-british's 'no classical ornament vocabulary... anywhere' remains true of the classical vocabulary proper -- swag-and-urn, triglyph, acanthus); this specification adds the nuance that Tudor's own text documents, that isolated Renaissance FIGURAL insets (distinct from an applied classical system) are real, sourced and capped at 5 percent.",
      "sources": [
        "tudor.json constraints (tudor.c02), description, lineage[italian-renaissance]"
      ],
      "group": "classical-apparatus"
    },
