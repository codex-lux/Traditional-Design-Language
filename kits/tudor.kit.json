    "primary_cladding": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Red brick, laid in English bond and patterned with vitrified (burnt) headers into diaper lozenges across the whole elevation, with stone dressings at openings, quoins and copings; ashlar stone (frequently salvaged monastic material) at the grandest houses; timber frame with wattle-and-daub or brick-nogged infill below the great-house scale.",
      "variants": [
        {
          "id": "red-brick-diaper-pattern",
          "status": "canonical",
          "note": "English bond with vitrified-header diaper patterning -- the period's fashionable, expensive material and the single most Tudor surface."
        },
        {
          "id": "ashlar-stone",
          "status": "permitted",
          "note": "The great courtyard houses; often reused dressed stone from the dissolved monasteries, per the style's own description."
        },
        {
          "id": "half-timber-infill",
          "status": "permitted",
          "note": "The smaller, timber-framed Tudor house below the great-house scale (see construction_type)."
        }
      ],
      "sources": [
        "tudor.json defining_characteristics, description"
      ],
