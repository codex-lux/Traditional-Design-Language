    "window_head_masonry": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "A hood mould (label mould) with carved or moulded spandrels stands above every principal window and doorway, shedding water clear of the reveal -- the single most reliable Tudor diagnostic tell, and the detail that most clearly separates Tudor from Elizabethan at fifty feet (Elizabethan drops the hood mould by the 1580s).",
      "variants": [
        {
          "id": "hood-mould-carved-spandrels",
          "status": "canonical"
        },
        {
          "id": "flush-no-hood-mould",
          "status": "forbidden",
          "note": "This is precisely the Elizabethan departure (own distinguished_from[elizabethan]); a flush mullion grid with no hood mould is not Tudor."
        }
      ],
      "sources": [
        "tudor.json diagnostic_tells, distinguished_from[elizabethan]"
