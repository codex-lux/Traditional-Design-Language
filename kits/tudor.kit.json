    "construction_type": {
      "binding": "extends",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "light-timber-frame",
          "status": "permitted",
          "op": "replace",
          "note": "CASCADE FIX. Tudor's own lineage note is explicit and direct: 'Below the level of the great house, Tudor is a timber-framing style. The carpentry tradition supplies the roofs and the whole vocabulary of the smaller Tudor house' (descends_from english-medieval-timber-frame, weight 0.6). The inherited antique-classical binding forbade light timber frame outright for the whole family; that is correct for the great houses (Hampton Court, Layer Marney, brick and stone) but wrong for the ordinary Tudor house below that scale, which this style's own text says IS a timber-framing tradition."
        }
      ],
      "note": "Extends rather than replaces: the masonry side of the inherited binding (brick as the fashionable great-house material, dressed stone at openings) is correct and stays inherited unrestated; only the forbidden-timber-frame variant is flipped, and only for Tudor, not for the family as a whole (Elizabethan and Jacobean each carry their own parallel fix, since the same lineage-confusion applies to both independently).",
      "sources": [
        "tudor.json lineage[english-medieval-timber-frame], defining_characteristics"
      ],
      "group": "envelope"
    },
