    "entry_door": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "The entrance is a true four-centred (Tudor) arch struck from four centres -- two short radii at the springing, two long radii to the apex -- with a rise to span of roughly 1:3 to 1:4, set within a rectangular label mould with carved spandrels. A flattened ellipse, a segmental arch or a moulded one-piece head is forbidden.",
      "parameters": {
        "arch_rise_to_span": {
          "range": [
            0.25,
            0.333
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "tudor.json constraints (tudor.c01)"
        }
      },
      "variants": [
        {
          "id": "four-centred-arch-in-voussoirs",
          "status": "canonical"
        },
        {
          "id": "flattened-ellipse-or-segmental",
          "status": "forbidden",
          "note": "Forbidden per tudor.c01: only a true four-centred arch struck from four centres is Tudor; a flattened ellipse or segmental head belongs to a later or different idiom."
        }
      ],
      "sources": [
        "tudor.json constraints (tudor.c01), diagnostic_tells"
