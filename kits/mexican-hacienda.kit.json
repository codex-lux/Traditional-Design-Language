    "porch_type": {
      "group": "threshold",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "variants": [
        {
          "id": "continuous-arcade-corredor",
          "status": "canonical",
          "note": "The organising architectural element of the whole type -- circulation, shade, working floor and social space in one."
        }
      ],
      "parameters": {
        "bay_count": {
          "range": [
            8,
            20
          ],
          "unit": "count",
          "kind": "measured",
          "source": "mexican-hacienda.json typical_ratios"
        },
        "bay_width": {
          "range": [
            9.8,
            13.1
          ],
          "unit": "ft",
          "kind": "measured",
          "source": "mexican-hacienda.json typical_ratios ('Corredor bay 3-4 m')"
        }
      },
      "rule": "A continuous arcade of eight to twenty repeated bays runs along the ranges it serves; the rhythm is relentlessly even, and any attempt to accent, group or break it works against the building.",
      "note": "bay_rhythm and governing_logic, direct. Distinct from mexican-colonial's own even-but-shorter patio arcade -- the hacienda's run is longer and its evenness is stated as the type's single most characteristic effect."
    },
    "porch_depth": {
      "group": "threshold",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "parameters": {
        "depth": {
          "range": [
            8.2,
            13.1
          ],
          "unit": "ft",
          "kind": "measured",
          "source": "mexican-hacienda.c03 (hard, tested: 'at least 2.5 m deep'; typical_ratios give 2.5-4 m)"
        }
      },
      "rule": "The corredor must be at least 2.5 m (8.2 ft) deep and continuous along the ranges it serves; a discontinuous arcade forces internal corridors the type does not have.",
      "note": "mexican-hacienda.c03 (hard)."
    },
    "porch_support": {
      "group": "threshold",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "rule": "Arcade piers are plain and evenly repeated, sized by the corredor bay and depth rather than by any order -- consistent with `order` (forbidden at the family level) and the style's own governing_logic ('nothing is derived from an order, and no elevation is composed as a whole').",
      "note": "governing_logic, direct."
    },
