    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "low",
      "judgment": true,
      "invented": true,
      "edit_provenance": {
        "kind": "invented",
        "note": "No traditional precedent exists for any style; invented honestly. mexican-hacienda's own status is 'historical' (the type effectively ended with agrarian reform after 1917), but it is named explicitly in the WP-4.2 task brief as a plausibly contemporary-buildable reinterpretation -- surviving cascos are widely reused as hotels and residential estates, and the vocabulary is actively reproduced in new construction across the US Southwest and Mexico."
      },
      "rule": "Where a garage is required, it is treated as one more range under the corredor bay logic -- a working outbuilding within the walled casco, never a freestanding volume -- and its door never breaks the continuous arcade rhythm on the casa grande's own principal elevation.",
      "note": "Invented per docs/inheritance.md guidance, honestly flagged as such."
    },
