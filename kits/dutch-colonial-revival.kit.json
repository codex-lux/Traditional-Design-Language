    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "gambrel",
          "status": "canonical"
        },
        {
          "id": "cross-gable",
          "status": "forbidden",
          "note": "The inherited value; a gambrel, not a gable of any kind, is this variant's whole identity."
        }
      ],
      "parameters": {
        "lower_slope": {
          "range": [
            20,
            24
          ],
          "unit": "rise_in_12",
          "kind": "measured",
          "source": "dutch-colonial-revival.c01"
        },
        "upper_slope": {
          "range": [
            6,
            9
          ],
          "unit": "rise_in_12",
          "kind": "measured",
          "source": "dutch-colonial-revival.c01"
        },
        "break_point": {
          "range": [
            55,
            65
          ],
          "unit": "percent",
          "kind": "measured",
          "source": "dutch-colonial-revival.c01",
          "note": "Percent of total roof height above the eave."
        }
      },
      "status": "drafted",
      "rule": "A two-slope gambrel: 20:12-24:12 below, 6:12-9:12 above, breaking at 55-65 percent of roof height -- c01, a hard constraint. Slopes closer than 8:12 apart produce a mansard and void the variant.",
      "confidence": "high",
      "judgment": false
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty",
      "note": "Superseded by roof_form's own two-slope parameters (c01) -- a single rise_in_12 value cannot describe a gambrel's two independent slopes, so the real numbers live there instead of being forced into this slot."
    },
    "roof_material": {
