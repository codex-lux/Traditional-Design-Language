    "dormer": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "shed-dormer",
          "status": "canonical",
          "note": "Full-length, per defining_characteristics: 'the lower slope pierced by a long shed dormer... providing full-height second-floor accommodation.'"
        },
        {
          "id": "gabled",
          "status": "permitted",
          "note": "A row of gabled dormers in place of a single shed dormer."
        }
      ],
      "parameters": {
        "min_headroom_at_3ft_in": {
          "value": 7,
          "unit": "ft",
          "kind": "measured",
          "source": "dutch-colonial-revival.c02"
        },
        "dormer_setback_min": {
          "value": 18,
          "unit": "in",
          "kind": "measured",
          "source": "dutch-colonial-revival.c03"
        },
        "dormer_ridge_below_main_min": {
          "value": 24,
          "unit": "in",
          "kind": "measured",
          "source": "dutch-colonial-revival.c03"
        },
        "dormer_length_pct_roof": {
          "range": [
            50,
            75
          ],
          "unit": "percent",
          "kind": "measured"
        }
      },
      "status": "drafted",
      "rule": "The lower slope must genuinely enclose habitable second-floor area -- minimum 7'0\" clear headroom 3'0\" in from the wall -- c02. A full-length shed dormer face sets back not less than 18 in from the wall plane, ridge not less than 24 in below the main ridge -- c03. Overrides the inherited georgian-colonial-american rule ('never break the eave line'), which is a different roof discipline entirely.",
      "confidence": "high",
      "judgment": false
    },
