          "unit": "in",
          "kind": "measured",
          "source": "dutch-colonial-revival.c04"
        },
        "kick_flare_start": {
          "range": [
            18,
            30
          ],
          "unit": "in",
          "kind": "measured",
          "note": "Up the slope from the eave."
        }
      },
      "status": "drafted",
      "rule": "Where an eave kick is used it projects 12-24 in past the wall, flares continuously across the full elevation, and returns at the gable ends -- c04. diagnostic_tells: 'its presence marks an architect or a good builder; its absence marks a catalog house.'",
      "confidence": "high",
      "judgment": false
    },
