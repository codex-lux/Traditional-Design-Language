  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "balanced-asymmetrical-bracket-unified",
          "status": "canonical",
          "op": "add"
        }
      ],
      "rule_append": "Italianate is the other picturesque half of the family's split, but looser than Gothic Revival's silhouette hierarchy: 'the style works on a symmetrical box as readily as on an L' (defining_characteristics), with the constant bracket rhythm — not axial symmetry, not silhouette hierarchy — doing the work of unifying whatever plan results.",
      "confidence": "high",
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "low-hip-suppressed",
          "status": "canonical"
        },
        {
          "id": "shallow-gable",
          "status": "permitted"
        },
        {
          "id": "steep-gable",
          "status": "forbidden",
          "note": "Contradicts the defining low-pitched, suppressed roof; that is Gothic Revival's territory (distinguished_from)."
        },
        {
          "id": "mansard",
          "status": "forbidden",
          "note": "'Add a mansard over the same brackets and it is Second Empire' — the single most common misidentification (diagnostic tells)."
        }
      ],
      "rule": "Low-pitched hipped or shallow gabled roof, visually suppressed; the roof must be substantially concealed by the cornice when viewed from 40 ft at eye height (c02).",
      "confidence": "high",
      "status": "drafted"
    },
