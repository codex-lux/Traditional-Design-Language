    "porch_type": {
      "group": "threshold",
      "binding": "extends",
      "variants": [
        {
          "id": "full-width-porch",
          "status": "canonical",
          "op": "replace",
          "note": "Promoted to canonical: the colossal colonnade runs the full width of the principal facade and frequently all four sides."
        },
        {
          "id": "wrap-around-porch",
          "status": "canonical",
          "op": "replace",
          "note": "Overrides the parent style's own forbidding of this id -- the parent's own note anticipates the override by name: 'a Northern Greek Revival house never wraps its colonnade (see greek-revival-southern-plantation for the variant that does, on different grounds)'. Here the wrap is peripteral shading, not Queen Anne picturesque massing."
        }
      ],
      "status": "drafted",
      "confidence": "high"
    },
    "porch_depth": {
      "group": "threshold",
      "binding": "specified",
      "parameters": {
        "gallery_depth_ft": {
          "range": [
            8,
            14
          ],
          "unit": "ft",
          "kind": "measured",
          "source": "greek-revival-southern-plantation constraint c02 / proportional_system"
        }
      },
      "rule": "Gallery depth minimum 8 ft, 10-12 typical (hard constraint c02), sufficient to shade the full window height at the summer solstice; a colonnade shallower than 8 ft is ornament, not a climate device, and the plan behind it must then be re-justified.",
