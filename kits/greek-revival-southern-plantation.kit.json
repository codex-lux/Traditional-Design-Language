    "service_zone_strategy": {
      "group": "plan-logic",
      "binding": "extends",
      "rule_append": "Kitchen and service functions belong in detached dependencies or a rear ell, never in the main block (constraint c05); this is the same detached-service diagram inherited from southern-federal, unchanged by the colonnade. The scale this type displays -- the colossal colonnade, the twelve-to-fourteen-foot ceilings, the acreage of trim -- was built on cotton and sugar wealth and on the labour of enslaved people between 1830 and 1861; the servants and enslaved workers who ran the house moved along back stairs and detached dependencies kept out of the principal sightlines by the same plan logic that hides the kitchen. Any reconstruction of this variant should record that history in its documentation rather than let the detached-service convention read as mere architectural tidiness.",
      "judgment": true,
      "status": "drafted",
      "confidence": "high"
    },
    "depth_and_pile": {
      "group": "plan-logic",
      "binding": "extends",
      "variants": [
        {
          "id": "single-pile",
          "status": "canonical",
          "op": "add",
          "note": "The style's own massing_affinities note the four-over-four main block is 'frequently thinned to single-pile for ventilation': rooms one deep on both sides of the through-passage so every principal room has openings on opposite walls (constraint c03's cross-ventilation clause). Added alongside the inherited double-pile four-over-four rather than replacing it, since both are attested exemplars (Oak Alley's core is closer to double-pile, Rosedown and the dogtrot-derived Gaineswood are thinner)."
        }
      ],
      "status": "drafted",
      "confidence": "medium"
    },
