    "roof_material": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "thatch-wheat-reed-water-reed-combed-straw",
          "status": "canonical"
        },
        {
          "id": "plain-clay-tile",
          "status": "permitted",
          "note": "Later and eastern examples."
        },
        {
          "id": "boxed-dormer-breaking-the-thatch",
          "status": "forbidden",
          "note": "c01, hard: 'thatch must run as an unbroken surface with no valleys, no hard verges and no interruption by boxed dormers.'"
        }
      ],
      "rule": "Thatch — wheat reed, water reed or combed straw — or, in later and eastern examples, plain clay tile, always treated as a continuous unbroken surface: no valleys, no hard verges, no boxed dormer interrupting it (c01, hard).",
      "sources": [
        "english-cottage-vernacular.c01",
        "english-cottage-vernacular.json defining_characteristics"
      ]
    },
    "eave_condition": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": false,
      "parameters": {
        "eaves_height": {
          "range": [
            6.6,
            8.9
          ],
          "unit": "ft",
          "kind": "measured",
          "source": "english-cottage-vernacular.c04",
          "note": "2.0-2.7 m in the source, converted to ft."
        }
      },
      "rule": "Eaves low enough to touch, 6'6\"-8'9\" at the wall plate (c04, soft), with a generous roof overhang protecting the wall below — no stated threshold for the overhang itself, only that it must be generous (c02: 'a good hat and a good pair of boots... neither is optional').",
      "sources": [
        "english-cottage-vernacular.c04",
        "english-cottage-vernacular.c02"
