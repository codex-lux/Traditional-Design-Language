    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "cob",
          "status": "canonical",
          "note": "Devon, Dorset."
        },
        {
          "id": "clay-lump",
          "status": "canonical",
          "note": "Norfolk."
        },
        {
          "id": "flint-or-chalk",
          "status": "permitted",
          "note": "The downs."
        },
        {
          "id": "rubble",
          "status": "permitted",
          "note": "The west."
        },
        {
          "id": "low-timber-frame-daub-infill",
          "status": "permitted",
          "note": "Everywhere there was oak; a minority condition, governed by wall_thickness_frame rather than wall_thickness_masonry, per british-vernacular's own note on that slot."
        }
      ],
      "rule": "Mass wall in whatever the ground provided within a few hundred metres — cob, clay lump, flint, chalk or rubble — or, everywhere there was oak, a low timber frame with daub infill. No single material is universal; geography decides.",
      "sources": [
        "english-cottage-vernacular.json defining_characteristics, description.long"
      ]
    },
