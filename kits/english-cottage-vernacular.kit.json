    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "low",
      "judgment": true,
      "invented": true,
      "variants": [
        {
          "id": "detached-low-outbuilding-off-principal-elevation",
          "status": "canonical",
          "note": "Invented: no historical precedent exists for any traditional style. Consistent with this type's own additive-by-cell-and-outshot growth logic (wing_strategy), a garage is a further low, thatched-or-tiled cell kept off the principal street elevation rather than a door cut into it."
        },
        {
          "id": "garage-door-in-principal-elevation",
          "status": "forbidden",
          "note": "Invented judgment: this style's whole diagnostic is the absence of hard edges and vertical alignment (diagnostic_tells: 'no hard edges anywhere... openings placed by internal need and never in vertical alignment'); a garage door is the hardest, most regular edge imaginable and would read as a different building type wearing a thatched hat (c04's own phrase, applied here by extension)."
        }
      ],
      "rule": "A garage, where wanted, is built as a further low, additive cell or outshot off the principal elevation, never as a door cut into the thatched street front.",
      "note": "Explicitly named as a plausible contemporary-buildable reinterpretation in this wave's brief; english-cottage-vernacular is 'living' status. Invented per docs/inheritance.md's own guidance: no traditional style has a historical answer for this slot."
    },
