    "dormer": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "eyebrow-swept-dormer-within-thatch",
          "status": "canonical",
          "note": "Formed within the thatch itself, not boxed on top of it — diagnostic_tells: 'swept dormers... because cob will not hold a sharp arris' extends to the roof detailing too."
        },
        {
          "id": "catslide-over-rear-outshot",
          "status": "permitted",
          "note": "massing_affinities: saltbox, common — 'the English original of which the New England saltbox is the transplanted and formalised descendant.'"
        },
        {
          "id": "boxed-dormer",
          "status": "forbidden",
          "note": "c01, hard."
        }
      ],
      "rule": "An eyebrow or swept dormer formed within the continuous thatch surface, or a catslide carried down over a rear outshot — never a boxed dormer interrupting the roof plane.",
      "sources": [
        "english-cottage-vernacular.json defining_characteristics, massing_affinities"
      ]
