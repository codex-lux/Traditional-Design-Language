      "binding": "specified",
      "variants": [
        {
          "id": "temple-front-with-lower-wings",
          "status": "canonical",
          "note": "massing_affinities: 'temple-front-with-wings' canonical -- 'portico on the centre block, lower wings either side,' and 'four-over-four' canonical -- 'the common domestic case: a two-room-deep centre-passage block with a portico applied.'"
        },
        {
          "id": "five-part-palladian",
          "status": "permitted",
