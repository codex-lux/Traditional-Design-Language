    "order": {
      "group": "classical-apparatus",
      "binding": "specified",
      "variants": [
        {
          "id": "doric",
          "status": "permitted"
        },
        {
          "id": "ionic",
          "status": "canonical"
        },
        {
          "id": "corinthian",
          "status": "canonical"
        },
        {
          "id": "composite",
          "status": "permitted"
        }
      ],
      "parameters": {
        "entasis_taper_min": {
          "value": "1/6 base diameter",
          "unit": "none",
          "kind": "measured",
          "note": "neoclassical-revival.c01: minimum taper of 1/6 the base diameter over the shaft height, taper beginning no lower than 1/3 the shaft height. Untapered cylindrical or box columns are forbidden at colossal scale."
        }
      },
      "rule": "Columns must be built to a published order with required entasis -- the order is correct, shaft tapering, capital turned or cast to a published profile, where Colonial Revival will accept an untapered box column (c01; diagnostic_tells).",
      "status": "drafted"
    },
    "column": {
      "group": "classical-apparatus",
      "binding": "specified",
      "variants": [
        {
          "id": "single-column",
          "status": "canonical"
        },
        {
          "id": "paired-coupled-columns",
          "status": "forbidden",
          "note": "The style's own distinguished_from names paired/coupled columns as precisely what separates it from Beaux-Arts-American: 'Neoclassical Revival is the same grammar stripped to plain wall and single columns, which is why it could be built in wood.' The inherited Beaux-Arts-American binding calls pairing 'the style's fastest diagnostic tell' -- against this style."
        }
      ],
      "parameters": {
        "shaft_height_ft": {
          "range": [
            18,
            24
          ],
          "unit": "ft",
          "kind": "measured"
        },
        "base_diameter_in": {
          "range": [
            20,
            28
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule": "Single columns rising two or more storeys, 18-24 ft tall on a two-storey house, 20-28 in diameter at the base -- not paired or coupled.",
      "status": "drafted"
    },
    "entablature": {
      "group": "classical-apparatus",
      "binding": "specified",
      "variants": [],
      "parameters": {
        "depth_ratio": {
          "range": [
            0.2,
            0.25
          ],
          "unit": "ratio",
          "kind": "measured"
        }
      },
      "rule": "Entablature depth must be between 1/5 and 1/4 of column height and carried on the return elevations for at least one bay; under 1/6 of column height it reads as a fascia board and voids the order (c02, hard).",
      "status": "drafted"
    },
