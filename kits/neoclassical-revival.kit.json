      "binding": "specified",
      "variants": [
        {
          "id": "paired-symmetrical-subordinate",
          "status": "canonical"
        },
        {
          "id": "tall-multiple-vertical-accent",
          "status": "forbidden",
          "note": "The inherited British Picturesque reading treats the chimney as a primary silhouette event; this style's strict-bilateral, cornice-dominated composition subordinates every roof element to the portico and the continuous cornice line."
        }
      ],
      "parameters": {},
      "judgment": true,
      "rule": "Chimneys are paired and symmetrical about the axis, kept low and subordinate to the roofline the continuous cornice defines -- consistent with the style's strict-bilateral symmetry (proportional_system) and its low, often balustrade-concealed roof (c05). Editorial inference: the style's own text does not describe chimneys directly.",
      "status": "drafted"
