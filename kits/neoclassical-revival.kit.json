      "rule": "Where a balustrade is used it is a minimum 30 in high with balusters spaced no more than 4 in clear, so it reads as railing rather than as ornament (c05).",
      "status": "drafted"
    },
    "ornament_vocabulary": {
      "group": "classical-apparatus",
      "binding": "specified",
      "variants": [
        {
          "id": "minimal-order-does-the-work",
          "status": "canonical"
        },
        {
          "id": "swag-and-urn",
          "status": "forbidden",
          "note": "distinguished_from is explicit: Beaux-Arts is 'richer and wetter... swags, cartouches, sculptural groups, exuberant stone carving. Neoclassical Revival is the same grammar stripped to plain wall.'"
        },
        {
          "id": "acanthus",
          "status": "permitted",
          "note": "Confined to the order's own capitals (Corinthian/Composite), not applied as separate wall ornament."
        }
      ],
      "parameters": {},
      "rule": "The grammar is stripped to plain wall and a correct order; the order itself is the ornament. Abundant applied sculptural ornament -- swags, cartouches, garlands, keystone masks, skyline figures -- is not this style's vocabulary.",
