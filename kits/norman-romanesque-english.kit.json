  "slots": {
    "composition_parti": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Heavy and slow bay rhythm at piers or vault responds, 3.0-5.0 m centres, set by what a groin vault of the available mortar could be trusted to span. Windows do not establish a rhythm of their own; they sit where the wall can spare the material -- the composition is governed by mass and structural bay, not by a symmetrical facade grid.",
      "parameters": {
        "bay_spacing_range_mm": {
          "range": [
            3000,
            5000
          ],
          "unit": "mm",
          "kind": "measured",
          "source": "norman-romanesque-english.json proportional_system.bay_rhythm"
        }
      },
      "variants": [
        {
          "id": "mass-governed-structural-bay",
          "status": "canonical"
        },
        {
          "id": "strict-bilateral-symmetry",
          "status": "forbidden",
          "note": "CASCADE FIX. Inherited from antique-classical via this style's own weight-0.3 descends_from edge to roman-classical -- real but explicitly attenuated transmission ('the round arch... reach Normandy through Carolingian and Lombard intermediaries, not by direct study of Roman buildings... no Norman mason had read Vitruvius'). Wrong for a style whose own proportional_system.symmetry is 'near-symmetrical', not strict-bilateral, and whose own text states directly that 'windows do not establish a rhythm of their own.'"
        }
      ],
      "note": "CASCADE FIX, parallel to the same mechanism corrected on english-gothic.kit.json. norman-romanesque-english's own weight-0.3 lineage to roman-classical is real (the round arch and ashlar course genuinely reach Normandy via Carolingian/Lombard intermediaries) but is explicitly NOT a claim about facade composition, and letting it drive composition_parti via the family-cascade splice was an overreach the family kit correctly left open at the medieval-british level.",
      "sources": [
        "norman-romanesque-english.json proportional_system.symmetry and bay_rhythm"
      ],
      "group": "massing-and-roof"
    },
