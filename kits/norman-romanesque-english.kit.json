    "arch": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Every arched opening is semicircular with rise exactly half the span. Segmental, stilted, four-centred and pointed heads are forbidden; a single pointed arch reclassifies the building as Transitional.",
      "parameters": {
        "arch_rise_to_span": {
          "value": 0.5,
          "unit": "ratio",
          "kind": "measured",
          "source": "norman-romanesque-english.json constraints (norman-romanesque-english.c01)"
        }
      },
      "variants": [
        {
          "id": "semicircular-arch-half-span-rise",
          "status": "canonical"
        },
        {
          "id": "segmental-stilted-four-centred-or-pointed",
          "status": "forbidden",
          "note": "norman-romanesque-english.c01, hard."
        }
      ],
      "sources": [
        "norman-romanesque-english.json constraints (norman-romanesque-english.c01)"
      ],
      "group": "openings",
      "note": "MIGRATED FROM `window_head_masonry` 24 Aug 2026 (OQ 46), when the `arch` slot was added. Semicircular, rise exactly half the span, pointed forbidden -- a single pointed arch reclassifies the building as Transitional. Arch form, not window head. The old slot is left `open`/`empty` on this kit rather than carrying a pointer, because the same fact in two places is what this migration exists to prevent."
    },
    "window_head_masonry": {
      "group": "openings",
      "binding": "open",
      "status": "empty",
      "note": "Emptied 24 Aug 2026 (OQ 46): everything this slot carried was about the ARCH as a spanning member and has moved to the `arch` slot. This kit states nothing about how a masonry window head is built, and saying so is different from saying it has none."
    },
