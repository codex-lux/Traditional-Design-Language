      "binding": "specified",
      "variants": [
        {
          "id": "gabled",
          "status": "canonical"
        },
        {
          "id": "pedimented",
          "status": "permitted"
        }
      ],
      "parameters": {
        "centering_tolerance": {
          "value": 6,
          "unit": "in",
          "kind": "measured",
          "note": "Dormers centred on the openings of the storey below within this tolerance."
        }
      },
      "rule": "Dormers shall be provided one per structural bay and shall be centred on the openings of the storey below. Dormer count and spacing shall not be varied independently of the fenestration.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/second-empire.json constraints c03"
