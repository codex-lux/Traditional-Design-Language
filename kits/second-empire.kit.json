  "slots": {
    "composition_parti": {
      "binding": "extends",
      "variants": [
        {
          "id": "near-symmetrical",
          "status": "canonical",
          "op": "add",
          "note": "The family's single exception: only near-symmetrical, never crossing into true classical strict-bilateral discipline (victorian.kit.json's own note on this variant)."
        }
      ],
      "rule_append": "Governed by the roof storey and the pavilion hierarchy: the mansard height sets the crown, and central or end pavilions establish an A-B-A or A-B-C-B-A rhythm inherited from French practice.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/second-empire.json proportional_system"
      ],
      "group": "massing-and-roof"
    },
    "roof_form": {
      "binding": "specified",
      "variants": [
        {
          "id": "mansard",
          "status": "canonical"
        }
      ],
      "rule": "A mansard roof, dual-pitched with a steep lower slope, forming a full habitable storey on all elevations. The mansard shall be continuous on all elevations of the mass it crowns, including rear and side elevations; a mansard applied to the street front only is prohibited.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/second-empire.json defining_characteristics, constraints c01"
      ],
      "group": "massing-and-roof"
    },
    "roof_pitch": {
      "binding": "specified",
      "parameters": {
        "lower_slope_deg": {
          "range": [
            65,
            80
          ],
          "unit": "deg",
          "kind": "measured"
        },
        "upper_slope_max": {
          "value": "4:12",
          "unit": "rise_in_12",
          "kind": "measured"
        }
      },
      "rule": "The lower mansard slope shall be between 65 and 80 degrees from horizontal, and the upper slope shall not exceed 4:12 and shall not be visible from eye height 40 ft from the building.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/second-empire.json constraints c02"
      ],
      "group": "massing-and-roof"
    },
