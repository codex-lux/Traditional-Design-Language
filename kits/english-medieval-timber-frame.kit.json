      ],
      "group": "envelope"
    },
    "primary_cladding": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Infill panels of wattle and daub (earliest), later brick nogging or lath and plaster, sitting flush or slightly recessed behind the timber face -- never covering the frame, and never structural. The same house may show infill from three different centuries because changing it never touches the structure.",
      "variants": [
        {
          "id": "wattle-and-daub-infill",
          "status": "canonical"
        },
        {
          "id": "brick-nogging-infill",
          "status": "canonical",
          "note": "Later, replacing daub panel by panel."
        },
        {
          "id": "lath-and-plaster-infill",
          "status": "permitted"
        },
        {
          "id": "frame-concealed-under-applied-siding",
          "status": "forbidden",
          "note": "The frame itself is never covered; this is exactly what distinguishes structural timber frame from the applied half-timbering of the revival (own distinguished_from -- not this node, but shared corpus convention)."
        }
      ],
      "sources": [
        "english-medieval-timber-frame.json defining_characteristics, description"
      ],
      "group": "envelope"
    },
