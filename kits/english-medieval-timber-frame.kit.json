    "circulation_parti": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Before the Great Rebuilding (c.1570-1640), an open hall with screens passage at the low end, service rooms beyond; after it, hall and parlour flank an inserted lobby-entry stack once the open hall is floored over.",
      "variants": [
        {
          "id": "open-hall-with-screens-passage",
          "status": "canonical",
          "applies_when": {
            "date_range": [
              1180,
              1570
            ]
          }
        },
        {
          "id": "hall-and-parlor-lobby-entry-stack",
          "status": "canonical",
          "applies_when": {
            "date_range": [
              1570,
              1700
            ]
          },
          "note": "W. G. Hoskins's 'Great Rebuilding', roughly 1570-1640, per own sources."
        }
      ],
      "sources": [
