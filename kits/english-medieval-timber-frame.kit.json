    "construction_type": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "A jointed hardwood frame -- cruck (curved blade pairs, dominant west/north) or box (rectilinear cage of sill, post, tie-beam, plate, diagonally braced) -- carries all vertical and lateral load; wall panels are non-structural infill only. Mortice-and-tenon joints secured by riven oak pegs; no metal fasteners in the primary frame.",
      "variants": [
        {
          "id": "box-frame",
          "status": "canonical"
        },
        {
          "id": "cruck-frame",
          "status": "canonical",
          "note": "Dominant in the west and north."
        },
        {
          "id": "balloon-frame",
          "status": "forbidden",
          "note": "1830s, three centuries too late."
        },
        {
          "id": "platform-frame",
          "status": "forbidden",
          "note": "20th-century American, anachronistic."
        }
      ],
      "sources": [
        "english-medieval-timber-frame.json defining_characteristics"
      ],
      "group": "envelope"
    },
    "wall_thickness_masonry": {
      "group": "envelope",
      "binding": "open",
      "status": "empty"
    },
    "wall_thickness_frame": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Post section 200-300 mm square; tie beam 250-350 mm deep -- the frame member sizes that set the whole building's grain.",
