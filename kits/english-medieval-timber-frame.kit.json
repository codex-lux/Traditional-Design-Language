    "expressed_frame": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "The frame IS the wall: 'the frame carries all vertical and lateral load' and the panel is infill. Post 200-300 mm square at 3.0-5.0 m centres, proud of the panel by its own thickness less the daub's. Nothing here is expressed for effect -- it is visible because it is there, which is what `structural` means as against `structural-and-expressed`.",
