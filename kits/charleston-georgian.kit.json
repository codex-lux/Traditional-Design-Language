    "porch_type": {
      "group": "threshold",
      "binding": "specified",
      "variants": [
        {
          "id": "engaged-under-roof",
          "status": "canonical",
          "note": "The piazza -- one or two tiers along the south or west flank -- roof structurally continuous with or clearly subordinate to the main roof, never a shed applied afterward (c04, hard)."
        },
        {
          "id": "wrap-around",
          "status": "permitted",
          "note": "Where the piazza turns the corner onto a second flank."
        },
        {
          "id": "entry-portico",
          "status": "atypical",
          "note": "May occur at the street door itself, but is subordinate to the piazza, which is the real threshold."
        },
        {
          "id": "stoop-only",
          "status": "forbidden",
          "note": "The inherited Georgian family default; wrong here because the piazza, not the stoop, is the type's organizing threshold."
        }
      ],
      "rule": "The piazza is the threshold; the street door is often not the real entrance at all (own long description and diagnostic tell #1).",
      "confidence": "high",
      "status": "drafted"
    },
    "porch_depth": {
      "group": "threshold",
      "binding": "specified",
      "parameters": {
        "depth": {
          "range": [
            10,
            14
          ],
          "unit": "ft",
          "kind": "measured"
        }
      },
      "rule": "Piazza depth not less than 10 ft, at least equal to the depth of an interior room (c04, hard).",
      "confidence": "high",
      "status": "drafted"
    },
    "porch_support": {
      "group": "threshold",
      "binding": "extends",
      "rule_append": " On a two-tier piazza the orders must be superimposed -- heavier below, lighter above -- never identical columns stacked on both levels, which reads as a modern deck (c03, hard).",
      "note": "The inherited Georgian porch_support binding already governs the order and column proportion; this adds only the piazza-specific superimposition requirement.",
      "status": "drafted",
      "confidence": "high"
    },
