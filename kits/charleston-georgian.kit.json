    "grade_relationship": {
      "group": "site",
      "binding": "specified",
      "variants": [
        {
          "id": "raised-basement",
          "status": "canonical",
          "note": "The principal floor is raised a full storey above an arcaded brick service basement, to escape ground damp and the mosquito line; the entry stair rises a full storey (own diagnostic tell #5)."
        },
        {
          "id": "low-plinth-on-a-level-site",
          "status": "forbidden",
          "note": "The inherited Georgian family answer, correct for the Northern and Tidewater branches; wrong for a subtropical port city that must lift its principal floor above the ground damp and insect line."
        }
      ],
      "parameters": {
        "basement_ceiling": {
          "range": [
            96,
            108
          ],
          "unit": "in",
          "kind": "measured",
          "note": "8-9 ft (own proportional_system)."
        }
      },
      "rule": "The house is raised a full storey on an arcaded, often stuccoed and scored, brick service basement -- a genuinely different section from the inherited Georgian low-plinth answer, not a variation on it.",
      "confidence": "high",
      "status": "drafted"
    }
