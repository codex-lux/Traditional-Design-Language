    "entry_sequence": {
      "group": "threshold",
      "binding": "specified",
      "parameters": {
        "sequence": {
          "value": "street door (sometimes false, opening only onto the piazza) -> piazza, a shaded outdoor room -> the real entrance, reached off the piazza",
          "unit": "none",
          "kind": "measured"
        }
      },
      "rule": "The visitor is admitted sideways through the piazza, not frontally through a facade; a door in the street or garden wall may open only onto the piazza and not into the house at all (own diagnostic tell #1 and long description).",
      "confidence": "high",
      "status": "drafted"
    },
    "ceiling_height_rule": {
      "group": "interior",
      "binding": "specified",
      "parameters": {
        "principal_floor": {
          "range": [
            144,
            168
          ],
          "unit": "in",
          "kind": "measured",
          "note": "12-14 ft; not less than 11 ft 6 in (c02, hard)."
        },
        "second_floor": {
          "range": [
            120,
            144
          ],
          "unit": "in",
          "kind": "measured",
          "note": "10-12 ft (own proportional_system)."
        }
      },
      "rule": "Principal-floor ceiling not less than 11 ft 6 in, typically 12-14 ft -- a full storey taller than the inherited Georgian family's 9-11 ft, because the stack effect and the vertical sash proportion both depend on it (c02, hard).",
      "note": "Specified rather than extends, matching Tidewater Georgian's own precedent for this slot: merging the parent's derived 9-11 ft figure alongside a materially different 12-14 ft figure would leave the resolved kit carrying a contradictory range.",
      "confidence": "high",
      "status": "drafted"
