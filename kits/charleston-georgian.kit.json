    "daylight_strategy": {
      "group": "plan-logic",
      "binding": "extends",
      "rule_append": " Here the two-wall rule is a cross-ventilation requirement before it is a daylight one: openings must align front to back through the plan to sustain a cross draft off the piazza breeze; a blocked enfilade defeats the reason the section is shaped this way (c05, soft).",
      "note": "The inherited Georgian daylight_strategy already states two-wall lighting; this reframes the same geometry around airflow, which is the operative reason here.",
      "status": "drafted",
      "confidence": "high"
    },
