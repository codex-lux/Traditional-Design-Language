    "circulation_parti": {
      "group": "plan-logic",
      "binding": "specified",
      "variants": [
        {
          "id": "side-hall",
          "status": "canonical",
          "note": "The Charleston single house: one room wide, end to the street, side hall running the depth of the lot toward the piazza -- the region's dominant urban expression (own massing_affinities)."
        },
        {
          "id": "center-hall",
          "status": "permitted",
          "note": "The grander 'double house', four rooms to a floor, facing the street conventionally (own distinguished_from note against charleston-single-house)."
        }
      ],
      "rule": "Side-hall is the dominant urban parti here, not merely a lot-driven exception the way the inherited Georgian family treats it; the single house is the type's default.",
      "confidence": "high",
      "status": "drafted"
    },
