    "orientation_rule": {
      "group": "site",
      "binding": "specified",
      "parameters": {
        "piazza_bearing": {
          "value": 225,
          "unit": "deg",
          "kind": "measured",
          "note": "Due southwest."
        },
        "tolerance": {
          "value": 45,
          "unit": "deg",
          "kind": "measured"
        }
      },
      "rule": "Governing factor is the compass, not the approach: the piazza must face within 45 degrees of southwest to catch the prevailing summer breeze and shade the long wall; a piazza on the north flank is decoration and defeats the type (c01, hard).",
      "note": "Overrides the inherited Georgian family's 'approach and composition' governing factor, which is a soft criterion here and subordinate to this hard climatic one.",
      "confidence": "high",
      "status": "drafted"
    },
