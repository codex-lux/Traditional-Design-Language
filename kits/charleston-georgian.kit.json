    "street_relationship": {
      "group": "site",
      "binding": "specified",
      "variants": [
        {
          "id": "gable-end-to-street",
          "status": "canonical",
          "note": "The single house turns its narrow end to the street and gives its composed long elevation -- the piazza flank -- to the side yard, not to the public way (own long description: 'the system... survives being turned ninety degrees')."
        },
        {
          "id": "frontal-to-the-road",
          "status": "permitted",
          "note": "The double house only, which faces the street conventionally."
        }
      ],
      "rule": "The house is not seen frontally as the inherited Georgian family assumes; the single house's composed elevation is not the street elevation at all.",
      "confidence": "high",
      "status": "drafted"
    },
