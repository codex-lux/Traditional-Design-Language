          ],
          "unit": "ratio",
          "kind": "measured",
          "note": "Principal gable width 1.4 to 2.0 times the width of the largest subordinate gable (typical_ratios)."
        }
      },
      "rule": "Pointed or lancet openings in the principal gable, with label or drip mouldings over the heads.",
      "confidence": "high",
      "status": "drafted"
