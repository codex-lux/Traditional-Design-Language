  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "massed-picturesque-silhouette",
          "status": "canonical",
          "op": "add"
        }
      ],
      "rule_append": "Gothic Revival takes the picturesque half of the family's split: composition is governed by silhouette hierarchy — a dominant gable, subordinate gables of unequal width, and a chimney group completing the outline against the sky — not by axial or bilateral symmetry.",
      "confidence": "high",
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "multi-gable-unequal-width",
          "status": "canonical"
        },
        {
          "id": "low-hip",
          "status": "forbidden",
          "note": "Suppresses the gable, which the style's own defining_characteristics make the governing compositional element."
        }
      ],
      "parameters": {
        "principal_pitch_min": {
          "value": 12,
          "unit": "rise_in_12",
          "kind": "measured",
          "note": "c01."
        }
      },
      "rule": "Steeply pitched roof, 12:12 or greater, with the gable as the governing compositional element (c01). Below 12:12 the building reads as Carpenter Gothic ornament applied to a folk box.",
      "confidence": "high",
      "status": "drafted"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": 12,
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_max": {
          "value": 18,
          "unit": "rise_in_12",
          "kind": "measured"
        }
      },
      "rule": "12:12 to 18:12; below 12:12 the style fails (c01, typical_ratios).",
      "confidence": "high",
      "status": "drafted"
    },
    "roof_material": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty"
    },
    "eave_condition": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "close-eave-no-brackets",
          "status": "canonical"
        },
        {
          "id": "wide-bracketed-eave",
          "status": "forbidden",
          "note": "Diagnostic tell against Italianate: 'brackets under a wide eave with no bargeboard: Italianate.' The two vocabularies do not mix on one building."
        }
      ],
      "rule": "The eave is close and unbracketed; the rake (see `rake_condition`), not the eave, carries the style's ornament.",
      "confidence": "high",
      "status": "drafted"
    },
    "rake_condition": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "bargeboard-full-rake-pierced",
          "status": "canonical"
        }
      ],
      "parameters": {
        "verge_overhang_in": {
          "range": [
            12,
            24
          ],
          "unit": "in",
          "kind": "measured"
        }
      },
      "rule": "Bargeboard, where used, follows the full length of the rake from eave to apex without interruption, with a verge overhang of 12 to 24 in so the board is read against shadow. A bargeboard applied only to the upper third of the rake is forbidden (c02).",
      "confidence": "high",
      "status": "drafted"
    },
    "cornice_return": {
      "group": "massing-and-roof",
      "binding": "forbidden",
      "note": "The rake is finished in bargeboard, not a boxed classical cornice with mitred returns; a cornice return signals Greek Revival millwork, not Gothic Revival (see distinguished_from).",
      "judgment": true,
      "confidence": "medium",
      "status": "drafted"
    },
