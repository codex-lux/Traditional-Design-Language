    "circulation_parti": {
      "group": "plan-logic",
      "binding": "specified",
      "variants": [
        {
          "id": "asymmetric-three-room-flurkuchenhaus",
          "status": "canonical",
          "note": "Kuche (kitchen, open hearth), Stube (stove-room, closed jamb stove) and Kammer (chamber) around the central chimney, with no through passage (own defining characteristic #1)."
        },
        {
          "id": "center-hall",
          "status": "forbidden",
          "note": "The inherited Georgian answer, pulled in via the english-georgian lineage splice; this plan has no through passage of any kind."
        },
        {
          "id": "hall-and-parlor",
          "status": "permitted",
          "note": "The nearest catalogued skeleton (own massing_affinities), with the caveat that the German plan divides unequally into three rooms, not two equal ones."
        }
      ],
      "rule": "No through passage; three unequal rooms around the chimney, organized by the heating technology, not by an entry axis (own defining characteristic #1).",
      "confidence": "high",
      "status": "drafted"
    },
    "hearth_position": {
      "group": "plan-logic",
      "binding": "specified",
      "variants": [
        {
          "id": "central-stack",
          "status": "canonical",
          "note": "On the partition between kitchen and stove-room, serving an open hearth on the Kuche side and a closed five-plate jamb stove aperture on the Stube side (own hard constraint c01) -- central for a service-wall reason, not New England's thermal-mass reason."
        },
        {
          "id": "gable-end-paired",
          "status": "forbidden",
          "note": "The Dutch colonial answer; wrong here because the chimney serves the kitchen hearth and the stove aperture from one central partition wall, not paired gable stacks."
        },
        {
          "id": "corner",
          "status": "forbidden",
          "note": "Dutch and French colonial; a corner hearth has no chimney position on this style's central partition-wall stack."
        }
