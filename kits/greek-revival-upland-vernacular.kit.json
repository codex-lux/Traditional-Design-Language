    "order": {
      "group": "classical-apparatus",
      "binding": "extends",
      "variants": [
        {
          "id": "vernacular-abstracted",
          "status": "canonical",
          "op": "replace",
          "note": "Promoted from atypical to canonical: this is the defining fact of the node, not an exception to it. The style's own governing_logic states classical proportion is 'carried entirely by board width and eave depth, with no orders present' -- no shaft, capital or base is built anywhere on the house."
        },
        {
          "id": "doric-greek",
          "status": "forbidden",
          "op": "replace",
          "note": "A built Doric order belongs to a variant that can afford columns; per the style's own constraint c04, 'if columns are wanted, the building belongs to a different variant.'"
        },
        {
          "id": "ionic-greek",
          "status": "forbidden",
          "op": "replace",
          "note": "Same objection as doric-greek -- no built order at all on this variant."
        },
        {
          "id": "corinthian",
          "status": "forbidden",
          "op": "replace",
          "note": "Same objection -- the Tower-of-the-Winds order is rarer even on the temple-front nodes that do build columns."
        }
      ],
      "rule_append": "The Grecian identity is carried entirely by trim profile and board proportion -- corner pilaster boards, frieze depth, door entablature -- run with planes a local carpenter already owned; encoding the widths and depths honestly matters more here than anywhere else in the family precisely because there is no order to fall back on if the proportions are wrong (see the style's own governing_logic).",
      "status": "drafted",
      "confidence": "high"
    },
    "column": {
      "group": "classical-apparatus",
      "binding": "extends",
      "variants": [
        {
          "id": "square-pier",
          "status": "canonical",
          "op": "replace",
          "note": "Promoted from atypical to canonical: 'no columns anywhere on the building' is this variant's own diagnostic tell. Where a porch post gets classical treatment at all it is chamfered with a lamb's-tongue stop (see porch_support), not turned or built up as a shaft."
        }
      ],
      "parameters": {
        "post_size_in": {
          "set": [
            4,
            6
          ],
          "unit": "in",
          "kind": "measured",
          "source": "greek-revival-upland-vernacular constraint c04 (soft, structural): 'square or chamfered posts 4x4 to 6x6'"
        }
      },
      "rule_append": "No built column exists on this variant at all -- the diameters-per-order figures above (5.5-7 Doric, 8.5-9.5 Ionic) do not apply; the porch is carried on 4x4 to 6x6 square or chamfered posts (constraint c04).",
      "status": "drafted",
      "confidence": "high"
    },
    "entablature": {
      "group": "classical-apparatus",
      "binding": "extends",
      "parameters": {
        "total_depth_in": {
          "range": [
            14,
            22
          ],
          "unit": "in",
          "kind": "measured",
          "source": "greek-revival-upland-vernacular proportional_system typical_ratios: 'total eave assembly 14-22 inches'"
        }
      },
      "rule_append": "The inherited order-derived ratio (entablature = 1/4 to 1/5 of column height) has no column to measure from on this variant: the eave assembly is instead sized directly in absolute board dimensions, 14 to 22 in total depth, the frieze board making up the greater part of it (see frieze).",
      "status": "drafted",
      "confidence": "high"
    },
