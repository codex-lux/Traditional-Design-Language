        },
        "cap_depth_in": {
          "range": [
            2,
            3
          ],
          "unit": "in",
          "kind": "measured",
          "source": "greek-revival-upland-vernacular proportional_system typical_ratios"
        }
      },
      "rule_append": "This is the whole trick of the stratum: an ordinary corner board widened from about 4 in to 10-12 in and given a 2-3 in cap so it reads as a pilaster, with no fluting, entasis or applied ornament of any kind -- diagnostic_tells: 'corner boards 10-12 inches wide with a simple capital, and no columns anywhere on the building'.",
      "status": "drafted",
