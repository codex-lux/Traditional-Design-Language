    "porch_type": {
      "group": "threshold",
      "binding": "extends",
      "variants": [
        {
          "id": "entry-portico",
          "status": "forbidden",
          "op": "replace",
          "note": "A portico costs columns, and this variant does not build any (constraint c04: 'if columns are wanted, the building belongs to a different variant'). The style's own hard constraint c01 (column height equals full facade height) presupposes a column that does not exist here."
        },
        {
          "id": "full-width-porch",
          "status": "canonical",
          "op": "replace",
          "note": "The nearest existing id to 'a shed or hip porch on square or chamfered posts' running across the ordinary front elevation. Genuine gap, honestly noted: no id in this vocabulary distinguishes a plain-post porch from a colonnade, so this binding carries the width fact (full-width) without the height/order fact the parent's own definition of this id assumes."
        },
        {
          "id": "stoop-only",
          "status": "permitted",
          "op": "replace",
          "note": "Promoted from atypical to permitted: the cheapest examples of the stratum reduce to trim boards and a doorway with no porch at all, per the ancestor's own anticipatory note naming this variant directly."
        }
      ],
      "status": "drafted",
      "confidence": "medium"
