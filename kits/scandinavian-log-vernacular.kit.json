    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "low",
      "judgment": true,
      "invented": true,
      "variants": [
        {
          "id": "detached-single-purpose-outbuilding",
          "status": "canonical",
          "note": "Invented: no historical precedent exists for any traditional style. Consistent with this type's own settlement logic (see outbuilding_types), a garage is simply one more single-purpose log building added to the yard cluster, standing apart from the stue rather than attached to or cut into it."
        },
        {
          "id": "attached-garage-bay",
          "status": "forbidden",
          "note": "Invented judgment: an attached bay has no precedent in a tradition whose entire settlement pattern is dispersal into separate small buildings, and it would require a wall opening far wider than the log-course/settlement-gap logic (window_grouping_rule, window_surround_wood) permits."
        }
      ],
      "rule": "A garage, where wanted, is treated as one more single-purpose building in the farm cluster — log-built or sympathetically clad, standing apart from the house — rather than as an attached bay or an integral opening.",
      "note": "scandinavian-log-vernacular is 'living' status with an explicit continuing trade (revival_periods: 'laft is still taught, licensed and built in Norway and Sweden'), so this slot is genuinely live; still invented per docs/inheritance.md, since no traditional style has an answer."
    },
