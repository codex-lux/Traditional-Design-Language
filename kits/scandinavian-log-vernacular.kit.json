    "circulation_parti": {
      "group": "plan-logic",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": false,
      "variants": [
        {
          "id": "single-cell-stue",
          "status": "canonical",
          "note": "massing_affinities: hall-single-cell, canonical — 'the type specimen and the unit everything else is assembled from.' One room, one hearth, one door."
        },
        {
          "id": "parstuga-central-passage",
          "status": "canonical",
          "note": "The plan formalises into two rooms — an everyday room and a finer, colder festroom — either side of a central entry passage; massing_affinities rates double-pen common and names this 'the direct ancestor of the American double pen.'"
        }
      ],
      "rule": "The plan is either the single-cell stue or, once formalised, the parstuga — two rooms flanking a central passage — but a room is never simply enlarged past what one log wall allows: growth multiplies rooms and buildings instead (see wing_strategy, outbuilding_types).",
      "sources": [
        "scandinavian-log-vernacular.json description.long, massing_affinities"
      ]
    },
    "hearth_position": {
      "group": "plan-logic",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": false,
      "variants": [
        {
          "id": "open-hearth-central-arestue",
          "status": "permitted",
          "applies_when": {
            "date_range": [
              800,
              1400
            ]
          },
          "note": "The earliest surviving type (arestue): an open hearth in the middle of the floor with a smoke hole (ljore) in the roof and no chimney at all."
        },
        {
          "id": "corner-fireplace-with-hood",
          "status": "canonical",
          "applies_when": {
            "date_range": [
              1300,
              1950
            ]
          },
          "note": "From the 14th century in Sweden, the 16th in Norway: a corner fireplace with a hood (peis) and a stone flue, letting the ceiling come down."
        }
      ],
      "rule": "Hearth type dates the building: the earliest arestue plan has a central open hearth with a smoke hole and no chimney; from the 14th-16th century a corner fireplace with a hood and stone flue supersedes it.",
      "sources": [
        "scandinavian-log-vernacular.json description.long"
      ]
    },
