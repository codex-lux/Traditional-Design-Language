      "binding": "extends",
      "status": "drafted",
      "variants": [
        {
          "id": "braced-timber-frame",
          "status": "canonical",
          "op": "add",
          "note": "The upper storey specifically -- light Anglo-American framing, sometimes over a second, thinner course of adobe. This is a genuine two-material building: adobe below (already canonical via the parent), frame above."
        }
      ],
      "rule_append": "The ground storey is Hispanic adobe and the upper storey is Anglo braced frame, stacked -- two building cultures in one section, not a single-material choice."
    },
