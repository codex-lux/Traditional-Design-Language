    "entry_sequence": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Arriving through the screens passage means arriving at the low end, in shadow, looking up the length of the hall toward the dais -- a deliberate social gradient built from a sequence of thresholds and a fall of light, not a straight-on approach to the room's centre.",
      "variants": [
        {
          "id": "screens-passage-low-end-shadow-to-dais-light",
          "status": "canonical"
        }
      ],
      "sources": [
        "english-gothic.json description"
      ],
      "group": "threshold"
    },
    "ceiling_height_rule": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "The great hall's wall-plate height is not less than the hall's own clear width -- a hall wider than it is tall is a room, not a hall. Subsidiary chambers off the dais end and service rooms beyond the screens are governed separately, at ordinary domestic scale.",
      "parameters": {
        "hall_width_m": {
          "range": [
            7500,
            9000
          ],
          "unit": "mm",
          "kind": "measured",
          "source": "english-gothic.json proportional_system.typical_ratios",
          "note": "Converted from the source's 7.5-9.0 m."
        },
        "hall_length_to_width": {
          "range": [
            1.5,
            2.0
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "english-gothic.json proportional_system.typical_ratios"
        }
      },
      "sources": [
        "english-gothic.json constraints (english-gothic.c04), proportional_system.typical_ratios"
