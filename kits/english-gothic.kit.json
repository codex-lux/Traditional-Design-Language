    "window_type": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Pointed-arch traceried windows -- plate, then geometric bar, then flowing curvilinear, then rectilinear Perpendicular panel tracery, in that historical sequence -- always finished with a hood mould or weathered label above. Tracery flush in a wall with no drip is a modern detail and will fail in a British rain.",
      "variants": [
        {
          "id": "pointed-traceried-with-hood-mould",
          "status": "canonical"
        },
        {
          "id": "round-headed-window",
          "status": "forbidden",
          "note": "The moment a pointed arch appears you have left Norman for Transitional or Gothic (own distinguished_from[norman-romanesque-english])."
        }
      ],
      "sources": [
        "english-gothic.json defining_characteristics, diagnostic_tells, constraints (english-gothic.c02)"
      ],
      "group": "openings"
    },
    "window_proportion": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Lancet openings run 4:1 to 6:1 height to width in the earliest (Early English) phase; Perpendicular windows, later, run 2:1 to 3:1 overall as tracery opens the wall to more glass.",
      "parameters": {
        "lancet_h_to_w": {
          "range": [
            4,
            6
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "english-gothic.json proportional_system.typical_ratios",
          "applies_when": {
            "date_range": [
              1180,
              1275
            ]
          }
        },
        "perpendicular_h_to_w": {
          "range": [
            2,
            3
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "english-gothic.json proportional_system.typical_ratios",
          "applies_when": {
            "date_range": [
              1375,
              1540
            ]
          }
        }
      },
      "sources": [
        "english-gothic.json proportional_system.typical_ratios"
