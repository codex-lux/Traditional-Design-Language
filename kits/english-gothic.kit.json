    "composition_parti": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Regular structural bays set by the roof trusses or vault ribs, 3.5-5.0 m apart, with openings centred in their own bay -- the bay, not the facade, is the unit of composition. The plan is additive and grows by function (hall, solar, service) rather than by a symmetrical facade grid.",
      "parameters": {
        "bay_spacing_range_mm": {
          "range": [
            3500,
            5000
          ],
          "unit": "mm",
          "kind": "measured",
          "source": "english-gothic.json proportional_system.bay_rhythm"
        }
      },
      "variants": [
        {
          "id": "additive-vernacular-bay-composition",
          "status": "canonical"
        },
        {
          "id": "strict-bilateral-symmetry",
          "status": "forbidden",
          "note": "CASCADE FIX. Inherited from antique-classical via this style's own weight-0.3 descends_from edge to roman-classical (itself reached only through norman-romanesque-english's real but attenuated lineage -- 'no Norman mason had read Vitruvius'). That is architecturally wrong: english-gothic's own proportional_system.symmetry is 'additive-vernacular', and its own bay_rhythm text is explicit that 'the bay, not the facade, is the unit of composition' -- the opposite of a classical facade-driven symmetry."
        }
      ],
      "note": "CASCADE FIX. A distant, ornament-scale lineage edge (Gothic's own roman-classical ancestry runs through Norman masonry practice, weight 0.3, and is explicitly 'attenuated... no Norman mason had read Vitruvius') was letting a classical symmetry rule from antique-classical override this style's own directly documented additive massing.",
      "sources": [
        "english-gothic.json proportional_system.symmetry and bay_rhythm"
      ],
      "group": "massing-and-roof"
    },
