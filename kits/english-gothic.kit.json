    "circulation_parti": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Entry to the hall is always through a screens passage at the low end, off-centre, never centrally on the long side and never at the dais end -- described in the style's own text as 'the load-bearing rule of the whole domestic plan.' The sequence dais / hall / screens / service is the single most consequential diagram in British domestic architecture, and descends directly into the H- and E-plan manor and every later British habit of entering off-centre through a passage.",
      "variants": [
        {
          "id": "screens-passage-at-low-end-off-centre",
          "status": "canonical",
          "note": "english-gothic.c03, hard: 'the load-bearing rule of the whole domestic plan.'"
        },
        {
          "id": "central-entry-on-long-side",
          "status": "forbidden",
          "note": "english-gothic.c03: entry is never centrally on the long side."
        },
        {
          "id": "entry-at-dais-end",
          "status": "forbidden",
          "note": "english-gothic.c03: entry is never at the dais (high) end."
        }
      ],
      "sources": [
        "english-gothic.json constraints (english-gothic.c03), description, defining_characteristics"
      ],
      "group": "plan-logic"
    },
