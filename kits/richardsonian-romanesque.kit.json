    "order": {
      "binding": "forbidden",
      "rule": "No true classical order -- a base-shaft-capital-entablature system proportioned to a module -- governs any part of the composition. Ornament is concentrated in narrow bands of carved Byzantine or Romanesque foliage, never a real order.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/richardsonian-romanesque.json defining_characteristics"
      ],
      "group": "classical-apparatus"
    },
    "column": {
      "binding": "forbidden",
      "rule": "No classical, entasis-bearing column. The squat columns at the entrance arch are massive masonry supports, not a proportioned classical order.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
