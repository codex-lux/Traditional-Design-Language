    "composition_parti": {
      "binding": "extends",
      "variants": [
        {
          "id": "balanced-asymmetrical",
          "status": "canonical",
          "op": "add"
        }
      ],
      "rule_append": "Governed by mass and by the arch rather than by module: the entrance arch's span sets the wall's apparent thickness, the coursing scale, and the depth of every reveal, with a Beaux-Arts parti discipline organising the plan beneath it.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/richardsonian-romanesque.json proportional_system"
      ],
      "group": "massing-and-roof"
    },
    "roof_form": {
      "binding": "specified",
      "variants": [
        {
          "id": "hip",
          "status": "canonical",
          "note": "Broad, simple, low hipped forms, subordinate to the wall mass."
        },
        {
          "id": "cross-gable",
          "status": "permitted",
          "note": "A few large gables, never a multiplication of small ones."
        }
      ],
      "rule": "Broad simple roof forms, low hipped or with a few large gables, always subordinate to the wall mass; the roof is never the primary compositional event.",
      "status": "drafted",
      "confidence": "high",
