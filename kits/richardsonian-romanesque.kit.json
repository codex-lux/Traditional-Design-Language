    "construction_type": {
      "binding": "extends",
      "variants": [
        {
          "id": "solid-masonry-two-wythe",
          "status": "canonical",
          "op": "replace"
        },
        {
          "id": "solid-masonry-three-wythe",
          "status": "canonical",
          "op": "replace"
        },
        {
          "id": "braced-timber-frame",
          "status": "forbidden",
          "op": "replace",
          "note": "The style insists on load-bearing masonry at exactly the moment American construction was abandoning it (description.long); a timber-frame wall is not this style."
        },
        {
          "id": "balloon-frame",
          "status": "forbidden",
          "op": "replace",
          "note": "The family's default wood construction; this style insists on load-bearing masonry at exactly the moment American construction was abandoning it (description.long)."
        }
      ],
      "rule_append": "Exterior walls shall be load-bearing masonry of not less than 16 in nominal thickness at the ground storey; a thin stone veneer over a frame wall is prohibited outright.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/richardsonian-romanesque.json constraints c01"
      ],
      "group": "envelope"
    },
