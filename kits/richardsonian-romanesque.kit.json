          "id": "carved-foliate-band",
          "status": "permitted"
        }
      ],
      "parameters": {
        "max_bands_per_elevation": {
          "value": 2,
          "unit": "count",
          "kind": "measured"
        },
        "max_pct_elevation_area": {
          "value": 8,
          "unit": "percent",
          "kind": "measured"
        }
      },
