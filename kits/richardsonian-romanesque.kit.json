          "range": [
            0.125,
            0.167
          ],
          "unit": "ratio",
          "kind": "measured",
          "note": "1/8 to 1/6 of the span."
        },
        "column_height_diameters_max": {
          "value": 3.5,
          "unit": "ratio",
          "kind": "measured"
        }
      },
      "rule": "The principal entrance is a deep semicircular arch springing from short heavy columns or directly from a plinth or the ground; where columns support the arch, shaft height shall not exceed 3.5 base diameters.",
