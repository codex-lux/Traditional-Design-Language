    "circulation_parti": {
      "binding": "specified",
      "variants": [
        {
          "id": "two-pens-open-passage",
          "status": "canonical",
          "note": "Own defining_characteristics: two pens under one continuous roof, separated by an open central passage."
        }
      ],
      "parameters": {
        "passage_width_ft": {
          "range": [
            8,
            12
          ],
          "unit": "ft",
          "kind": "measured",
          "note": "Own hard constraint c02."
        }
      },
      "rule": "The passage must be open at both ends, unheated, and unglazed, 8 to 12 ft wide and never as wide as the pen it separates (own hard constraint c01, c02). Screening is tolerable; enclosing it converts the building to a center-passage house and must be recorded as such.",
      "confidence": "high",
      "status": "drafted",
      "note": "Overrides the parent style's own single-pen/double-pen/hall-and-parlor circulation_parti with the specific open-passage configuration that is this variant's whole identity.",
