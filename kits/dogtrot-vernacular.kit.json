    "composition_parti": {
      "binding": "extends",
      "rule_append": "A three-part rhythm of pen-void-pen, in which the void (the passage) is narrower than the solids -- own proportional_system.bay_rhythm: a passage as wide as a pen reads as a breezeway between two buildings rather than as one house.",
      "group": "massing-and-roof"
    },
    "roof_form": {
      "binding": "extends",
      "rule_append": "One continuous unbroken ridge runs over both pens and the passage; a break in the ridge destroys the reading of a single house (own hard constraint c03).",
      "group": "massing-and-roof"
    },
    "roof_pitch": {
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": "8:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_max": {
          "value": "12:12",
          "unit": "rise_in_12",
          "kind": "measured"
        }
      },
      "rule": "Roof pitch 8:12 to 12:12, one unbroken ridge; eave overhang 24 to 36 in (own typical_ratios).",
      "confidence": "high",
      "status": "drafted",
      "group": "massing-and-roof"
    },
