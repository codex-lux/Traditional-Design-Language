    "landscape_idiom": {
      "group": "site",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "The building is one term in a controlled axial sequence, not a freestanding object read in isolation: an entry court (cour d'honneur / forecourt) on the approach side, a formal garden, allee, or (in the nineteenth-century urban case) a boulevard axis on the other. french-renaissance-chateau and french-baroque both mark courtyard-u ('entre cour et jardin') canonical in their own massing_affinities; french-baroque's own c05 states the principal axis 'must be extended into the landscape — a court on one side, a formal garden or allee on the other'; beaux-arts-french's marche doctrine extends the identical logic to an urban axis cut through the city for the purpose (Palais Garnier's approach avenue).",
      "variants": [
        {
          "id": "axial-entry-to-garden-or-boulevard",
          "status": "canonical"
        }
      ]
    },
