    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": true,
      "rule": "The building organizes as a corps de logis (main range) flanked by subordinate ailes terminating in distinguished pavilions or towers, often each carrying its own independently terminated roof mass. This is a continuous, explicitly documented descent across the whole family: french-baroque's own lineage note states the corps de logis, cour d'honneur, pavilion and tall roof 'all survive' from french-renaissance-chateau — 'what changes is that they are finally brought under proportional control'; french-neoclassical's hotel particulier keeps the identical court-and-garden plan 'unchanged from the Baroque; only its dress is renovated'; beaux-arts-french's own bay_rhythm is explicitly 'a dominant centre pavilion, subordinate end pavilions,' resolved at both ends and directly descended (lineage weight 0.6) from french-baroque.",
      "variants": [
        {
          "id": "corps-de-logis-with-pavilion-terminated-wings",
          "status": "canonical",
          "note": "Common to all four members across three centuries of documented descent; see rule."
        }
      ]
    },
    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "Masonry construction — dressed stone (chateau tufa/limestone, Baroque and Neoclassical ashlar) — or, in Beaux-Arts practice, a masonry-and-terracotta envelope wrapped around a modern iron/steel/reinforced-concrete frame while still built and detailed to genuine masonry-mass discipline: beaux-arts-french's own hard constraint (c03) requires a minimum 600 mm wall thickness and 200 mm window reveals specifically 'so that openings read as cut into mass.' Light timber frame construction has no place anywhere in this family.",
