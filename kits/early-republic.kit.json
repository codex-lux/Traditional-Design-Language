    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "solid-masonry-two-wythe",
          "status": "permitted",
          "note": "Federal and Southern Federal brick work, and stuccoed brick in Greek Revival Southern Plantation colonnades."
        },
        {
          "id": "solid-masonry-three-wythe",
          "status": "permitted"
        },
        {
          "id": "braced-timber-frame",
          "status": "permitted",
          "note": "New England Federal's white pine construction; the frame equivalent throughout the vernacular Greek Revival branches."
        },
        {
          "id": "balloon-frame",
          "status": "permitted",
          "note": "Available only within the family's later floruit (post-1830) and explicitly the dominant construction of Northern Greek Revival clapboard work — the earliest Federal work of the 1780s-90s predates it and could not have used it."
        },
        {
          "id": "log",
          "status": "permitted",
          "note": "Upland Vernacular Greek Revival frequently conceals a log or hewn-timber core inside a weatherboarded frame wall, a survival of the region's earlier German-Pennsylvania and backcountry building practice."
        },
        {
          "id": "masonry-veneer-over-frame",
          "status": "forbidden",
          "note": "A later nineteenth/twentieth-century technique; every masonry wall bound to this family is load-bearing."
        },
        {
          "id": "platform-frame",
          "status": "forbidden",
          "note": "Twentieth-century, long after the family's floruit ends in 1860."
        },
        {
          "id": "structural-insulated-panel",
          "status": "forbidden",
          "note": "Modern manufactured technology, anachronistic to the whole family."
        }
      ],
      "rule": "Construction is load-bearing masonry, or braced or balloon timber frame — balloon framing becomes available and is explicitly attested from the 1830s on in the Northern Greek Revival branch, but is not available to the earliest Federal work of the 1780s-90s, which predates it. No branch uses masonry veneer over a frame backup, platform framing, or a structural insulated panel, all of which postdate the family's 1860 floruit end.",
      "confidence": "high",
      "status": "drafted"
    },
