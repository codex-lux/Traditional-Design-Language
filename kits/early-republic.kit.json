    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "strict-bilateral-symmetry",
          "status": "canonical",
          "note": "The family's ideological core. Federal, Jeffersonian Roman classicism and Greek Revival all record 'strict-bilateral' as their governing symmetry — each stream claims classical symmetry as a political argument about the form of government, not only a compositional habit."
        },
        {
          "id": "off-centre-entrance",
          "status": "permitted",
          "note": "Tolerated only on the Greek Revival gable-front (temple) parti, where a side-hall door is pushed to the end bay because the pediment itself, not the door, supplies the composition's symmetry. Not tolerated on a broadside elevation."
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "note": "Inherited prohibition from the Georgian tradition every stream of this family descends from. Picturesque composition belongs to the Romantic Revivals that displace this family after 1840-60, not to it."
        },
        {
          "id": "balanced-asymmetrical",
          "status": "forbidden",
          "note": "Near-symmetry with a deliberate offset is a later, Picturesque-era habit, not a Federal, Jeffersonian or Greek Revival one."
        },
        {
          "id": "additive-vernacular",
          "status": "forbidden",
          "note": "Growth by accretion is exactly the colonial habit the pattern book displaced. Even the cheapest Upland Vernacular Greek Revival farmhouse is composed, not accreted — Grecian trim is applied precisely to make an old accretive plan read as classical."
        }
      ],
      "rule": "Every stream of the family — Federal, Jeffersonian Roman classicism, and Greek Revival alike — composes its principal elevation in strict bilateral symmetry; picturesque, balanced-asymmetrical and additive-vernacular partis are forbidden outright. The one tolerated departure is the Greek Revival gable-front house, where a side-hall door is pushed to the end bay because the pediment itself, not the door, supplies the symmetry.",
      "confidence": "high",
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "open",
      "status": "empty"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": "3:12",
          "unit": "rise_in_12",
          "kind": "measured",
          "source": "jeffersonian-classicism and greek-revival-southern-plantation proportional_system"
        },
        "pitch_max": {
          "value": "9:12",
          "unit": "rise_in_12",
          "kind": "measured",
          "source": "southern-federal proportional_system"
        }
      },
      "rule": "Roof pitch across the family runs markedly lower than the Georgian/colonial precedent it replaces — from a nearly flat, balustrade-concealed 3:12 in Jeffersonian and plantation Greek Revival work up to a still-shallow 9:12 in the steepest Southern Federal hip — and the roof is characteristically treated as subordinate mass: hidden behind a parapet or balustrade in Federal and Jeffersonian work, or flattened into a pediment in Greek Revival, rather than left as a dominant visible form.",
      "confidence": "high",
      "status": "drafted"
    },
