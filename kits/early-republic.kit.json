    "window_grouping_rule": {
      "group": "openings",
      "binding": "specified",
      "rule": "Openings are single, evenly spaced, and aligned vertically floor to floor across every stream of the family — Federal's 'vertically aligned openings', Jeffersonian's 'even bay rhythm derived from the portico's intercolumniation', and Greek Revival's 'even intercolumniation... imposed on the wall behind it' are the same discipline stated three ways. Paired or ribboned windows are not part of the vocabulary. The one permitted disturbance is a single centred feature — a Palladian or triple window over a Federal entrance, or the portico's own module in Jeffersonian and Greek Revival work — and it must sit on the composition's own axis, never off-centre.",
      "confidence": "high",
      "status": "drafted"
    },
