    "window_type": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "variants": [
        {
          "id": "horseshoe-arch",
          "status": "canonical",
          "note": "The founding form. diagnostic_tells: 'An arch whose curve continues below its springing line by a quarter to a third of the radius -- the true horseshoe.'"
        },
        {
          "id": "cusped-arch",
          "status": "permitted",
          "note": "Later development, defining_characteristics point 7."
        },
        {
          "id": "muqarnas-arch",
          "status": "permitted",
          "note": "Stalactite-vaulted transition, defining_characteristics point 7 and diagnostic_tells point 4."
        },
        {
          "id": "round-arch",
          "status": "forbidden",
          "note": "moorish-andalusian.c04 (hard): 'Less than [a quarter to a third of the radius below springing] and it is a round arch with a stylistic pretension.'"
        }
      ],
      "parameters": {
        "horseshoe_curve_below_springing": {
          "range": [
            0.25,
            0.33
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "moorish-andalusian.c04, typical_ratios"
        }
      },
      "rule": "Openings of consequence are horseshoe-arched, later cusped or muqarnas, always enclosed by an alfiz (see window_surround_masonry, inherited from the family). The horseshoe must continue its curve below the springing line by a quarter to a third of its radius; less than that reads as a round arch with a stylistic pretension."
    },
