      "confidence": "high",
      "parameters": {
        "court_width_to_range_height": {
          "range": [
            0.6,
            1.0
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "moorish-andalusian.c01 (hard)"
        }
      },
      "rule": "Court width runs 0.6 to 1.0 times the height of the enclosing ranges at 36-38 degrees north -- wider and the court floor bakes through the afternoon, narrower and it becomes a lightwell admitting no winter sun. This governs the court, not an exterior massing height, since the exterior has no composed massing (see composition_parti).",
      "note": "moorish-andalusian.c01 (hard, tested)."
