    "ornament_vocabulary": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "rule": "Geometric interlace (laceria), generated by rotating a square to produce root-2 and root-3 rectangles and by subdividing an eight- or sixteen-pointed star into a repeating cell, is cut by its own frame rather than composed to fit within it -- the pattern reads as excerpted from an infinite field, not as a bounded composition.",
      "note": "defining_characteristics point 8; description, direct: 'the laceria interlace is generated from a repeating star polygon and continues past every frame, so the wall reads as a cut-out from an infinite pattern rather than a bounded composition, which is a theological position as much as a decorative one.'"
    },
