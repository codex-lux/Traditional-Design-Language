    "entry_sequence": {
      "group": "threshold",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "parameters": {
        "thresholds_crossed": {
          "value": 1,
          "unit": "count",
          "kind": "measured",
          "source": "moorish-andalusian.json description",
          "note": "One controlled door; the passage that follows it is bent rather than gated a second time -- contrast andalusian-courtyard-vernacular's later two-threshold zaguan-plus-cancela, which makes the same passage visually transparent instead of physically bent."
        }
      },
      "rule": "A single door at the street opens onto a passage that is bent or set deliberately off-axis so that no line of sight from the street ever reaches the court -- concealment, not transparency, is the device.",
      "note": "description, direct: 'a single door, often set off-axis and reached through a bent passage so that no one on the street can see in.' distinguished_from andalusian-courtyard-vernacular states the vernacular descendant keeps the diagram but the cancela later makes the court visible-but-inaccessible instead -- a real point of divergence worth keeping explicit on both nodes."
    },
