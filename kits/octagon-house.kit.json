    "daylight_strategy": {
      "group": "plan-logic",
      "binding": "specified",
      "parameters": {
        "directions_per_principal_room": {
          "range": [
            3,
            4
          ],
          "unit": "count",
          "kind": "derived",
          "note": "Derived from the room-adjacency rule (a room open on 2+ of 8 radially-spaced faces receives light from multiple directions), not an independently sourced figure."
        }
      },
      "rule": "Light arrives from three or four directions in every principal room, so the quality of illumination is soft and shadowless in a way rectangular rooms of the period do not achieve.",
      "confidence": "medium",
      "status": "drafted"
