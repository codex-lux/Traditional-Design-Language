    "hearth_position": {
      "group": "plan-logic",
      "binding": "specified",
      "determined_by": [
        "stair_position"
      ],
      "rule": "Where the core is a stack of flues rather than the stair, hearth position is the core itself; the two are alternate readings of the same required central element (c02).",
      "confidence": "high",
      "status": "drafted"
    },
    "stair_position": {
      "group": "plan-logic",
      "binding": "specified",
      "variants": [
        {
          "id": "central-core",
          "status": "canonical"
        }
      ],
      "rule": "A central core, being either the principal stair or a stack of flues, serves all eight sectors at every storey. Without it the eight-hip roof has nothing to bear on and the plan has no organising element (c02).",
      "confidence": "high",
      "status": "drafted"
    },
