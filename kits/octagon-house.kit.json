    "room_adjacency_overrides": {
      "group": "plan-logic",
      "binding": "specified",
      "parameters": {
        "max_sides_per_room": {
          "value": 3,
          "unit": "count",
          "kind": "measured",
          "note": "c03: no single room shall occupy more than three of the eight sides."
        },
        "min_openings_per_principal_room": {
          "value": 2,
          "unit": "count",
          "kind": "measured"
        }
      },
      "rule": "No single room shall occupy more than three of the eight sides, and each principal room shall have openings on at least two faces. This is what buys the cross-light and cross-ventilation the type exists for (c03).",
      "confidence": "high",
      "status": "drafted",
      "rules": [
        {
          "kind": "topology",
          "effect": "restricts",
          "statement": "No single room shall occupy more than three of the eight sides.",
          "why": "Fowler's own c03. Machine-readable against `max_sides_per_room` beside this."
        },
        {
          "kind": "daylight",
          "effect": "adds",
          "statement": "Each principal room shall have openings on at least two faces.",
          "why": "A daylight claim, not an adjacency one, and it is what the three-sides restriction is FOR: cross-light and cross-ventilation are the reason the type exists. Kept here rather than moved to `daylight_strategy` because it is inseparable from the geometric rule above -- and flagged as the one clause in this slot corpus-wide whose home is arguable."
        }
      ]
    },
