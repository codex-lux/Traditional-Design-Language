      "binding": "specified",
      "variants": [
        {
          "id": "subordinate-ell",
          "status": "canonical",
          "note": "The upright-and-wing: 'arguably the most-built American house form of the nineteenth century', per this variant's own massing_affinities -- Greek Revival in origin before it becomes style-neutral."
        }
      ],
      "parameters": {
        "wing_ridge_offset_ft": {
          "range": [
            3,
            6
          ],
          "unit": "ft",
          "kind": "measured",
          "source": "greek-revival-northern constraint c03"
        },
        "wing_setback_min_ft": {
          "value": 2,
          "unit": "ft",
          "kind": "measured",
          "source": "greek-revival-northern constraint c03"
        }
      },
      "rule": "The wing ridge sits 3 to 6 ft below the main ridge and the wing's front plane is recessed at least 2 ft behind the temple block (hard constraint c03) -- a wing flush with the temple front destroys the hierarchy and produces a two-fronted house with no entry logic.",
