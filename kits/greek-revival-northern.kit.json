    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "subordinate-ell",
          "status": "canonical",
          "note": "The upright-and-wing: 'arguably the most-built American house form of the nineteenth century', per this variant's own massing_affinities -- Greek Revival in origin before it becomes style-neutral."
        }
      ],
      "parameters": {
        "wing_ridge_offset_ft": {
          "range": [
            3,
            6
          ],
          "unit": "ft",
          "kind": "measured",
          "source": "greek-revival-northern constraint c03"
        },
        "wing_setback_min_ft": {
          "value": 2,
          "unit": "ft",
          "kind": "measured",
          "source": "greek-revival-northern constraint c03"
        }
      },
      "rule": "The wing ridge sits 3 to 6 ft below the main ridge and the wing's front plane is recessed at least 2 ft behind the temple block (hard constraint c03) -- a wing flush with the temple front destroys the hierarchy and produces a two-fronted house with no entry logic.",
      "confidence": "high",
      "status": "drafted"
    },
    "construction_type": {
      "group": "envelope",
      "binding": "extends",
      "variants": [
        {
          "id": "braced-timber-frame",
          "status": "canonical",
          "op": "replace",
          "note": "Painted white clapboard over braced or balloon frame is the dominant construction of this variant -- 'painted white clapboard over braced or balloon frame as the dominant construction, brick in the towns', per defining_characteristics."
        },
        {
          "id": "balloon-frame",
          "status": "canonical",
          "op": "replace",
          "note": "Explicitly attested from the 1830s on in this variant specifically, per the family's own construction_type rule."
        },
        {
          "id": "solid-masonry-two-wythe",
          "status": "permitted",
          "op": "replace",
          "note": "'Brick in the towns' -- the minority, urban case."
        }
      ],
