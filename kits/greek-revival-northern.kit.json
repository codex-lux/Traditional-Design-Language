      "binding": "extends",
      "variants": [
        {
          "id": "front-gable",
          "status": "canonical",
          "op": "replace",
          "note": "Overrides the inherited Georgian prohibition ('turns the gable into the principal elevation, which inverts the style's parti') outright: rotating the gable to the road is this variant's own demographic bulk -- 'rotate the house, get a pediment for nothing' -- and the family's own composition_parti already tolerates the off-centre door this parti requires."
        }
      ],
      "status": "drafted",
      "confidence": "high"
