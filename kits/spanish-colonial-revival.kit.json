  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "picturesque-asymmetrical",
          "status": "canonical",
          "op": "add",
          "note": "The style's own proportional_system states this directly: bay_rhythm is 'deliberately irregular... any regular repeating bay rhythm pushes the building toward Mediterranean Revival.'"
        },
        {
          "id": "strict-bilateral",
          "status": "forbidden",
          "op": "add",
          "note": "An axial symmetrical block is exactly what distinguished_from names as the move toward mediterranean-revival instead."
        }
      ],
      "note": "eclectic-revivals leaves symmetry class to each member; this is Spanish Colonial Revival's own, sourced from its own proportional_system.symmetry field.",
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "hip",
          "status": "canonical"
        },
        {
          "id": "cross-gable",
          "status": "canonical",
          "note": "Gables and hips mixed freely -- defining_characteristics: roof 'broken into multiple planes at multiple heights ... describing an accreted, asymmetrical mass.'"
        },
        {
          "id": "gable-on-hip",
          "status": "permitted"
        },
        {
          "id": "front-gable",
          "status": "forbidden",
          "note": "A single uniform gable-fronted form contradicts the required multi-plane, varied-height roof (c01), and also reads as mission-revival's uniform roofline, which diagnostic_tells names as the opposite case."
        }
      ],
      "rule": "Adjacent roof planes on the primary elevation must differ in eave or ridge height by not less than 2'0\" (c01); a single uniform roof line voids the style.",
      "confidence": "high",
      "note": "Overrides the family's inherited single front-gable answer (germanic-vernacular), which describes a unified gabled silhouette this style's own hard constraint explicitly forbids.",
      "status": "drafted"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": "3:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_max": {
          "value": "5:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_typical": {
          "value": "4:12",
          "unit": "rise_in_12",
          "kind": "editorial"
        },
        "eave_overhang_max": {
          "value": 12,
          "unit": "in",
          "kind": "measured",
          "note": "c01: not exceeding 12 in, with no exposed dimensional rafter tails."
        }
      },
      "rule": "Roof pitch 3:12 to 5:12 in clay barrel or mission tile, eave overhang not exceeding 12 in, no exposed rafter tails.",
      "confidence": "high",
      "note": "Specified rather than extends: the inherited family default (british-picturesque, minimum 45 degrees = 12:12, for the family's steep-roofed Gothic/Baronial/Queen-Anne wing) is roughly three times this style's own maximum pitch -- not a number to refine but a different roof entirely.",
      "status": "drafted"
    },
