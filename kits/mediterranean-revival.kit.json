  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "near-symmetrical",
          "status": "canonical",
          "op": "add",
          "note": "proportional_system.symmetry, and diagnostic_tells: 'Composition is broadly symmetrical or axial even when the plan rambles -- the entrance sits on an axis that continues through the house to a garden feature.'"
        }
      ],
      "note": "eclectic-revivals leaves symmetry class to each member; this is Mediterranean Revival's own. Unlike its sibling spanish-colonial-revival, this style is not forbidden from strict or picturesque composition -- 'as [massed-picturesque] dominates, the building shades into spanish-colonial-revival' -- so no variant is forbidden here.",
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "hip",
          "status": "canonical",
          "note": "diagnostic_tells: 'The roof is hipped, low, and continuous around the whole building; Spanish Colonial Revival breaks its roof into varied planes at varied heights.'"
        },
        {
          "id": "cross-gable",
          "status": "forbidden",
          "note": "That multi-plane, varied-height roof is explicitly the sibling style's own signature, and this style's own hard constraint c02 forbids any gable facing a principal elevation."
        },
        {
          "id": "front-gable",
          "status": "forbidden",
          "note": "c02: 'Gables facing a principal elevation are forbidden; that move belongs to spanish-colonial-revival.'"
        }
      ],
      "rule": "A single continuous hipped roof line around the whole building, uniform in height -- never the broken, multi-plane roof of spanish-colonial-revival.",
      "confidence": "high",
      "note": "Overrides the family's front-gable default, and deliberately differs from the sibling style's own multi-plane roof_form (see spanish-colonial-revival.kit.json), which is exactly the trait this style's c02 forbids.",
      "status": "drafted"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": "3:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_max": {
          "value": "5:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_typical": {
          "value": "4:12",
          "unit": "rise_in_12",
          "kind": "editorial"
        },
        "eave_overhang_max": {
          "value": 18,
          "unit": "in",
          "kind": "measured",
          "note": "Hard constraint c02."
        }
      },
      "rule": "Roof pitch 3:12 to 5:12 in clay tile, hipped, with eave overhang not exceeding 18 in and no exposed dimensional rafter tails (c02).",
      "confidence": "high",
      "note": "Specified rather than extends: the inherited family default (british-picturesque, minimum 45 degrees = 12:12) is roughly three times this style's own maximum pitch.",
      "status": "drafted"
    },
