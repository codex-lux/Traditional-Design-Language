      "variants": [
        {
          "id": "platform-frame",
          "status": "canonical",
          "note": "The wall is 'stucco walls of expressed mass' (defining_characteristics) achieved over a frame with expressed lath, the same ordinary construction logic as the style's Californian and Floridian siblings mission-revival and spanish-colonial-revival."
        },
