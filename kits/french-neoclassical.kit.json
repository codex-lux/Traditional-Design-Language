    "order": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "high",
      "variants": [
        {
          "id": "free-standing-column-real-entablature",
          "status": "canonical",
          "note": "defining_characteristics: 'Free-standing columns carrying a real entablature in preference to engaged columns and pilasters.' Structurally justified per hard constraint c05: decorative free-standing columns supporting nothing 'invert the style's founding argument.'"
        }
      ],
      "parameters": {
        "column_height_diameters": {
          "range": [
            9.5,
            10
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "french-neoclassical.json proportional_system.typical_ratios"
        },
        "intercolumniation_diameters": {
          "range": [
            2.25,
            3.0
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "french-neoclassical.json constraints c05"
        }
      },
      "rule": "Corinthian and Ionic preferred (bound proportion packs), column height 9.5-10 diameters, shafts unfluted or fluted only above 1/3 height. A free-standing column must carry a real vault or floor above it -- never merely decorative (hard constraint c05).",
      "sources": [
        "french-neoclassical.json defining_characteristics, proportional_system.typical_ratios, constraints c05"
      ],
      "status": "drafted"
    },
    "column": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "high",
      "rule": "Same cascade correction as `order`: this slot is wrongly forbidden by the vernacular family spliced in via french-renaissance-chateau's hybridization edge. Corrected: free-standing, load-bearing, spaced 2.25-3.0 diameters, unfluted or fluted only above 1/3 height.",
      "sources": [
        "french-neoclassical.json constraints c05, proportional_system.typical_ratios"
      ],
      "status": "drafted"
    },
    "entablature": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "high",
      "parameters": {
        "entablature_to_column_height": {
          "value": 0.2,
          "unit": "ratio",
          "kind": "measured",
          "note": "1/5 of column height, against the Baroque 1/4 -- own distinguished_from note against french-baroque."
        }
      },
      "rule": "Same cascade correction as `order`. Entablature reduced to 1/5 of column height (typical_ratios), always structurally real -- carried by a genuine load, never applied over a flat-roofed projection with nothing behind it (c02).",
      "sources": [
        "french-neoclassical.json proportional_system.typical_ratios, constraints c02"
      ],
      "status": "drafted"
    },
    "pediment": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "high",
      "variants": [
        {
          "id": "pediment-over-real-portico-or-roof",
          "status": "canonical",
          "note": "Hard constraint c02: 'A pediment may appear only where a real roof or a real portico is behind it. Applying a pediment over a flat-roofed projection is the exact practice Laugier's critique was aimed at.'"
        },
        {
          "id": "pediment-over-flat-roofed-projection",
          "status": "forbidden",
          "note": "Exactly what c02 forbids -- decorative pediment with no real roof or portico behind it."
        }
      ],
      "rule": "Same cascade bug as `order`, corrected with high confidence and the style's own sharpest rule: a pediment is legitimate only where a real roof or a real portico stands behind it (hard constraint c02) -- this is the specific practice Laugier's 1753 critique targeted.",
      "sources": [
        "french-neoclassical.json constraints c02, description.long"
      ],
      "status": "drafted"
    },
    "pilaster": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "medium",
      "variants": [
        {
          "id": "exterior-pilaster",
          "status": "atypical",
          "note": "defining_characteristics states free-standing columns are preferred 'IN PREFERENCE TO engaged columns and pilasters' on the exterior -- not forbidden, but the secondary choice."
        },
        {
          "id": "interior-straight-fluted-pilaster",
          "status": "canonical",
          "note": "description.long: the Louis XVI interior answer to Rococo is 'rectilinear panelling, straight fluted pilasters, Vitruvian scroll and guilloche' -- pilasters ARE the interior norm even where the exterior prefers a free column."
        }
      ],
      "rule": "Same cascade bug as `order`, corrected: exterior pilasters are permitted but secondary to a free-standing column; interior pilasters (straight, fluted, rectilinear) are the Louis XVI norm and the diagnostic break from Rococo boiserie.",
      "sources": [
        "french-neoclassical.json defining_characteristics, description.long"
      ],
      "status": "drafted"
    },
    "modillion_dentil": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "low",
      "judgment": true,
      "variants": [
        {
          "id": "restrained-modillion",
          "status": "atypical",
          "note": "Consistent with the style's disciplined, banded ornament (c04) but not directly named; held atypical rather than canonical given the general austerity."
        }
      ],
      "rule": "Same cascade correction as `pediment`. Not directly documented; the style's general austerity (plain wall dominant, ornament banded per c04) argues against a rich modillion course as the norm.",
      "note": "EDITORIAL, low confidence.",
      "sources": [
        "french-neoclassical.json constraints c04 (banded ornament)"
      ],
      "status": "drafted"
    },
    "balustrade": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "high",
      "parameters": {
        "balustrade_to_wall_height": {
          "value": 0.0625,
          "unit": "ratio",
          "kind": "measured",
          "note": "At least 1/16 of the wall height, per hard constraint c01."
        }
      },
      "rule": "Same cascade bug as `order`, corrected with high confidence. A plain classical balustrade, at least 1/16 the wall height, conceals the low hipped roof at the cornice line (hard constraint c01) -- the style's single most reliable diagnostic tell.",
      "sources": [
        "french-neoclassical.json constraints c01, diagnostic_tells"
      ],
      "status": "drafted"
    },
    "ornament_vocabulary": {
      "group": "classical-apparatus",
      "binding": "specified",
      "confidence": "high",
      "variants": [
        {
          "id": "banded-archaeological-ornament",
          "status": "canonical",
          "note": "defining_characteristics: 'Archaeologically derived detail -- Greek key, Vitruvian scroll, guilloche, paterae, husk garlands -- used in narrow disciplined bands.' Hard-adjacent co-occurrence rule c04: 'Ornament is banded, not scattered... free-floating swags and cartouches on open wall belong to the Baroque.'"
        }
      ],
      "rule": "Same cascade bug as `order`, corrected with high confidence. Archaeologically correct ornament (Greek key, Vitruvian scroll, guilloche, paterae, husk garlands) confined to continuous horizontal bands or a single framed panel -- never scattered free-floating swags (soft constraint c04).",
      "sources": [
        "french-neoclassical.json defining_characteristics, constraints c04"
      ],
      "status": "drafted"
    },
