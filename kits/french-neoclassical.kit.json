        {
          "id": "low-hip-behind-balustrade",
          "status": "canonical",
          "note": "Hard constraint c01: roof 'must not be visible from a normal standing viewpoint at the building line... concealed behind a balustrade or blocking course.' diagnostic_tells: 'No visible roof.'"
        },
        {
          "id": "mansard",
          "status": "atypical",
          "note": "own massing_affinities marks mansard-block 'atypical: Neoclassicism actively suppresses the mansard in favour of a low roof behind a balustrade. A mansard indicates either a survival from the previous century or the nineteenth-century revival.'"
        }
      ],
      "parameters": {
        "pitch": {
          "range": [
            5,
            8
          ],
          "unit": "rise_in_12",
          "kind": "measured",
          "source": "french-neoclassical.json constraints c01"
