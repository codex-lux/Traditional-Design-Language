    "public_private_gradient": {
      "group": "plan-logic",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "rule": "The same court diagram runs across the whole social range at one scale per building type -- a Cordoban palace with a dozen courts, a two-storey merchant's house, a single-court artisan house, and the corral de vecinos, in which twenty families share one patio, a well, a sink and a privy. Privacy is graded less room by room within a dwelling than by how much of the diagram one household controls.",
      "note": "description, long, direct: 'The social range of the type is very wide... The corral is the courtyard house as tenement.'"
    },
