        {
          "id": "low-gable",
          "status": "canonical"
        },
        {
          "id": "gambrel",
          "status": "forbidden",
          "note": "Overrides the cascade's inherited value (shingle-style, via colonial-revival's family). No source names a gambrel roof; the ranch roof is a single simple low plane."
        }
      ],
      "status": "drafted",
      "confidence": "high",
      "rule": "A low-pitched hipped or gabled roof with a long unbroken ridge, no base, no piano nobile, no attic, and frequently no cornice.",
      "note": "Direct quote of defining_characteristics item 2 and diagnostic_tells item 3. Fixes a cascade bug."
