    },
    "material_change_rule": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "material-as-picture-changes-wherever-the-design-calls-for-it",
          "status": "canonical"
        },
        {
          "id": "material-honesty-change-only-at-structural-event",
          "status": "forbidden",
          "note": "Inherited from British Arts and Crafts + Tudor Revival's Ruskin/Morris material-honesty rule. This is the exact opposite of Storybook's own governing logic: the style is 'not trying to be authentic and does not think it should be' -- an architecture where stucco is troweled to imitate stone or thatch specifically because the material is theatrical, not structurally honest."
        }
      ],
      "parameters": {},
      "rule": "Material changes wherever the picture calls for it, not only at a genuine structural event -- the wall is set design, not a structural argument (description.long).",
      "status": "drafted"
    },
