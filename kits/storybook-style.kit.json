{
  "style": "storybook-style",
  "style_name": "Storybook Style",
  "ontology_version": "0.6.0",
  "kit_version": "0.2.1",
  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "picturesque-asymmetrical",
          "status": "canonical",
          "note": "The style's own proportional_system states symmetry directly as 'picturesque-asymmetrical', and c02 (hard) forbids a strictly symmetrical principal elevation outright, requiring at least three of ridge line, eave line, wall plane, window head heights, or chimney profile to be deliberately irregular."
        },
        {
          "id": "strict-bilateral",
          "status": "forbidden",
          "note": "storybook-style.c02, hard: 'a strictly symmetrical principal elevation is forbidden.'"
        }
      ],
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "pitch_max_18_12",
          "status": "canonical",
          "op": "add",
          "note": "typical_ratios states the principal roof pitch as '12:12 to 18:12', wider than the 16:12 upper bound inherited from Tudor Revival + Cotswold Cottage Revival."
        }
      ],
      "parameters": {
        "ridge_deflection_in": {
          "range": [
            3,
            6
          ],
          "unit": "in",
          "kind": "measured",
          "note": "typical_ratios: 'ridge deliberately deflected 3 to 6 in below level over its length' -- the sagging ridge is a designed dimension, not damage (c03: deviations between 5 and 25 percent of nominal, consistent in direction)."
        }
      },
      "status": "drafted"
    },
