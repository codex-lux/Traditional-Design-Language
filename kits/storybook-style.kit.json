    "gable_treatment": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "decorative-non-structural-half-timbering",
          "status": "canonical",
          "note": "The style's own lineage note is direct: Tudor Revival 'supplies the half-timbering... In Storybook the timbering ceases to correspond to any frame and becomes drawing.' diagnostic_tells confirms this as a positive identifier: 'half-timbering that does not meet at the corners or align across a floor line.'"
        },
        {
          "id": "no-half-timbered-gable",
          "status": "forbidden",
          "note": "Inherited from Cotswold Cottage Revival, whose own stone-and-stucco vocabulary genuinely forbids half-timbering. Storybook's own text directly contradicts this inherited prohibition -- it takes half-timbering from Tudor Revival and exaggerates it into pure applied drawing."
        }
      ],
      "parameters": {},
      "rule": "Half-timbering, where used, follows no real frame: it does not meet at the corners, does not align across a floor line, and is understood by the designer as surface drawing rather than structure -- the opposite of Tudor Revival's own honest-frame rule (distinguished_from: 'if the timbering resolves at the corners, it is Tudor Revival').",
      "status": "drafted"
    },
    "dormer": {
      "group": "massing-and-roof",
      "binding": "open",
      "variants": [],
      "parameters": {},
      "status": "empty"
    },
    "chimney": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "oversized-sculptural-stack-many-pots",
          "status": "canonical"
        }
      ],
      "parameters": {
        "chimney_width_to_flue_ratio": {
          "range": [
            1.5,
            2.5
          ],
          "unit": "ratio",
          "kind": "measured"
        },
        "chimney_height_above_ridge_ft": {
          "value": 4,
          "unit": "ft",
          "kind": "measured"
        }
      },
      "rule": "The principal chimney is the tallest and most massive element of the composition -- not less than 1.5 to 2.5 times the width required by its flues, terminating at least 4 ft above the main ridge, often occupying up to a third of the gable end, and carrying more chimney pots than the flues require (c04, soft; description.long). Overrides the inherited Cotswold Cottage Revival numbers (1/4-1/3 width, 3'0\" above ridge) with this style's own, more extreme figures.",
      "status": "drafted"
    },
