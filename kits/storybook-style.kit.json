    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "agglomerated-picturesque-massing",
          "status": "canonical",
          "note": "massing_affinities: 'massed-picturesque' canonical -- 'the agglomerated irregular mass with multiple roof directions is the style's home skeleton.'"
        },
        {
          "id": "gable-front-and-wing",
          "status": "permitted",
          "note": "massing_affinities: common -- 'an ordinary L-plan cottage with the whole apparatus applied to the street-facing gable', the commonest speculative version."
        },
        {
          "id": "flanking-symmetrical-dependencies",
          "status": "forbidden",
          "note": "Inherited from Tudor-Jacobean's E/H-plan gentry-house system; directly contradicts this style's own picturesque-asymmetrical governing logic and c02's hard forbidding of a symmetrical principal elevation."
        }
      ],
      "parameters": {},
      "status": "drafted"
    },
    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "wood-frame-wire-lath-portland-cement-stucco",
          "status": "canonical",
          "note": "The style's own description names the technique directly: 'a cheap and completely plastic wall system -- wood frame with wire lath and portland cement stucco -- that could be shaped into any profile a modeller could sketch.'"
        },
        {
          "id": "masonry-or-masonry-veneer-only",
          "status": "forbidden",
          "note": "Inherited from Cotswold Cottage Revival, whose genuine stone construction this style explicitly does not use -- it simulates stone in troweled plaster instead."
        }
      ],
      "rule": "Wood frame with wire lath and portland cement stucco, hand-modelled by studio-trained plasterers into any profile the design calls for -- not real masonry.",
      "status": "drafted"
    },
    "wall_thickness_masonry": {
      "group": "envelope",
      "binding": "open",
      "status": "empty"
    },
    "wall_thickness_frame": {
      "group": "envelope",
      "binding": "open",
      "status": "empty"
    },
    "primary_cladding": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "troweled-modelled-plastic-stucco",
          "status": "canonical",
          "note": "defining_characteristics: 'Wall surface as plastic material -- troweled and modelled stucco, simulated or genuinely distressed masonry, timbering that follows no frame.'"
        },
        {
          "id": "simulated-distressed-stone",
          "status": "permitted"
        },
        {
          "id": "never-half-timbering",
          "status": "forbidden",
          "note": "Inherited from Cotswold Cottage Revival; contradicted directly by this style's own use of decorative half-timbering (see gable_treatment) as an applied surface drawing over the stucco."
        }
      ],
      "parameters": {},
      "rule": "The wall is a plastic, hand-worked material -- troweled and modelled stucco, or stucco worked to simulate weathered or distressed masonry -- not a fixed material assembly with a single honest logic.",
      "status": "drafted"
    },
    "secondary_cladding": {
