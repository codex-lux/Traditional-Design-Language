    "construction_type": {
      "group": "envelope",
      "binding": "specified",
      "variants": [
        {
          "id": "solid-masonry-two-wythe",
          "status": "permitted",
          "note": "The Dutch, Georgian and Mid-Atlantic German branches build this way; not the family default, since roughly half the family builds in frame or log instead."
        },
        {
          "id": "solid-masonry-three-wythe",
          "status": "permitted"
        },
        {
          "id": "braced-timber-frame",
          "status": "permitted",
          "note": "The New England, Dutch-frame and French colombage (poteaux) branches."
        },
        {
          "id": "adobe",
          "status": "permitted",
          "note": "The New Mexico and California Spanish-colonial branches."
        },
        {
          "id": "rammed-earth",
          "status": "permitted"
        },
        {
          "id": "log",
          "status": "permitted",
          "note": "German Pennsylvania first settlement (V-notched horizontal log) and backcountry branches generally."
        },
        {
          "id": "masonry-veneer-over-frame",
          "status": "forbidden",
          "note": "A single wythe or thin veneer laid over a structural frame backup is a nineteenth/twentieth-century technique postdating every member's floruit. Every branch of this family that builds in masonry builds load-bearing masonry."
        },
        {
          "id": "balloon-frame",
          "status": "forbidden",
          "note": "Not developed until the 1830s, after the defining floruit of every member \u2014 including the latest-dated, Pennsylvania Bank House and Cape Cod Colonial."
        },
        {
          "id": "platform-frame",
          "status": "forbidden",
          "note": "Twentieth-century; centuries after the family's floruit."
        },
        {
          "id": "structural-insulated-panel",
          "status": "forbidden",
          "note": "A modern manufactured assembly, anachronistic to every branch."
        }
      ],
      "rule": "Every branch bears its own weight \u2014 in solid masonry, braced timber frame, log, or adobe/rammed earth, whichever the transplanted building culture brought \u2014 but none of the family's six national traditions built with balloon framing, platform framing, structural insulated panels, or a thin masonry veneer over a frame backup, because all four postdate the family's floruit. Which load-bearing method a given branch uses is a per-tradition decision the family does not adjudicate.",
      "confidence": "high",
