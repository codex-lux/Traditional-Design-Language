    "wing_strategy": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Subordinate wings (barchesse) step down from the dominant centre in BOTH height and order -- a lower eave line and a plainer order (Doric, against Ionic or Corinthian at the centre) -- carrying real agricultural or service functions. Equal wings destroy the hierarchy the composition depends on.",
      "parameters": {
        "wing_eave_height_fraction": {
          "range": [
            0.5,
            0.7
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "palladian.json proportional_system.typical_ratios"
        }
      },
      "variants": [
        {
          "id": "subordinate-barchesse-lower-and-plainer-order",
          "status": "canonical",
          "note": "palladian.c02, hard constraint."
        },
        {
          "id": "equal-height-and-order-wings",
          "status": "forbidden",
          "note": "palladian.c02: equal wings destroy the hierarchy the composition depends on."
        }
      ],
      "sources": [
        "palladian.json defining_characteristics, constraints (palladian.c02), proportional_system.typical_ratios"
      ],
