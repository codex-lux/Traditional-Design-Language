    "ornament_vocabulary": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "Ornament is the disciplined vocabulary of the orders themselves -- module-derived mouldings, capitals and the serliana as a single compositional event -- kept restrained relative to Baroque richness, but never reduced to the vernacular's 'ornament almost entirely absent, concentrated where it is unavoidable.' The style's whole identity is built from a fixed, published classical vocabulary transmissible by treatise.",
      "variants": [
        {
          "id": "disciplined-treatise-order-vocabulary",
          "status": "canonical"
        },
        {
          "id": "serliana-as-terminal-compositional-event",
          "status": "permitted",
          "note": "palladian.c05 (soft): used at most once per elevation, on axis or as a terminal event; repeating it as a standard window is a later Georgian/Colonial Revival habit."
        },
        {
          "id": "ornament-almost-entirely-absent-construction-only",
          "status": "forbidden",
          "note": "CASCADE FIX. This is mediterranean-vernacular's own rule, quoted verbatim from italian-villa-vernacular's defining_characteristics -- correct for the working farm buildings, flatly contradicted by Palladio's own treatise-derived order system, which is this style's entire reason for existing."
        }
      ],
      "sources": [
        "palladian.json defining_characteristics, constraints (palladian.c05), description"
      ],
      "group": "classical-apparatus"
    },
