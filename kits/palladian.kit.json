    "column": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule": "The temple-front portico carries real, module-proportioned free-standing or engaged columns of the Ionic or Corinthian order (portico of four or six columns, occupying 1/2 to 3/5 of the block width); the subordinate barchesse and flanking wings carry the same logic in a plainer Doric order, sized smaller and never competing with the centre -- not a bare unfluted pier carrying only an impost.",
      "parameters": {
        "portico_columns": {
          "set": [
            4,
            6
          ],
          "unit": "count",
          "kind": "measured",
          "source": "palladian.json proportional_system.typical_ratios"
        },
        "portico_width_fraction": {
          "range": [
            0.5,
            0.6
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "palladian.json proportional_system.typical_ratios"
        }
      },
      "variants": [
        {
          "id": "module-proportioned-order-centre-ionic-corinthian",
          "status": "canonical"
        },
        {
          "id": "module-proportioned-order-wings-doric",
          "status": "canonical",
          "note": "palladian.c02 (hard): wings subordinate in both height and order; the style's own proportion_packs binds palladio-doric specifically 'for the barchesse and flanking wings.'"
        },
        {
          "id": "unfluted-pier-with-impost-no-order",
          "status": "forbidden",
          "note": "CASCADE FIX. mediterranean-vernacular specifies the family's 'only columnar element' as a bare unfluted pier carrying an impost, 'never a moulded capital-and-full-entablature combination' -- correct for the plain vernacular loggia of italian-villa-vernacular and tuscan-vernacular, and directly contradicted for Palladian by the style's own defining_characteristics, its c02 hard constraint on ordered wings, and its own bound palladio-ionic/corinthian/doric proportion packs."
        }
      ],
      "sources": [
        "palladian.json defining_characteristics, constraints (palladian.c02), proportional_system.typical_ratios, proportion_packs"
      ],
      "group": "classical-apparatus"
    },
