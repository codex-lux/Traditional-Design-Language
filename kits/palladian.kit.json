    "pilaster": {
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "rule": "Engaged pilasters may articulate secondary bays and the barchesse wings where a full free-standing or engaged column would compete with the dominant centre -- consistent with the style's own defining_characteristics naming 'engaged or free-standing columns' for the temple front, and with c02's requirement that wings be subordinate in order as well as height.",
      "variants": [
        {
          "id": "engaged-pilaster-on-secondary-bays-and-wings",
          "status": "permitted"
        },
        {
          "id": "no-pilaster-of-any-kind",
          "status": "forbidden",
          "note": "CASCADE FIX. mediterranean-vernacular's blanket 'no applied pilaster order occurs' -- itself only an inference from italian-villa-vernacular's own text, not a direct quotation, per that binding's own note -- is wrong for a treatise-derived order style whose defining identity is a full classical apparatus applied to a domestic front."
        }
      ],
      "note": "Held at medium confidence because Palladian's own text names engaged and free-standing COLUMNS explicitly but does not use the word 'pilaster'; this is a reasonable reading of 'engaged... columns' rather than a verbatim citation.",
      "sources": [
        "palladian.json defining_characteristics, constraints (palladian.c02)"
      ],
      "group": "classical-apparatus"
    },
