    "composition_parti": {
      "binding": "extends",
      "variants": [
        {
          "id": "picturesque-asymmetrical",
          "status": "canonical",
          "op": "add",
          "note": "The style's own proportional_system.symmetry, verbatim."
        }
      ],
      "rule_append": "One mass shall dominate the composition, exceeding every other mass by at least 50 percent in either height above eave or plan area (c01); a composition of equal masses is Stick Style or an incoherent accumulation, not Queen Anne.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/queen-anne-american.json proportional_system, constraints c01"
      ],
      "group": "massing-and-roof"
    },
    "roof_form": {
      "binding": "specified",
      "variants": [
        {
          "id": "cross-gable",
          "status": "canonical"
        },
        {
          "id": "hip",
          "status": "canonical",
          "note": "Especially in combination with a corner tower."
        },
        {
          "id": "gable-on-hip",
          "status": "permitted"
        },
        {
          "id": "side-gable",
          "status": "forbidden",
          "note": "c05: a simple rectangular hip or gable with applied ornament is Folk Victorian, not Queen Anne."
        },
        {
          "id": "front-gable",
          "status": "forbidden",
          "note": "Same reasoning as side-gable: a simple rectangular ridge is the Folk Victorian case."
        }
      ],
      "rule": "A complex, non-rectangular ridge with at least one front-facing gable; the ridge shape is itself diagnostic against Folk Victorian's simple rectangle or L.",
      "status": "drafted",
      "confidence": "high",
      "sources": [
        "styles/queen-anne-american.json defining_characteristics, constraints c05"
      ],
      "group": "massing-and-roof"
    },
