    "landscape_idiom": {
      "group": "site",
      "binding": "specified",
      "variants": [
        {
          "id": "landscape-park",
          "status": "canonical",
          "note": "Capability Brown's practice from the 1750s onward 'removed the formal garden, brought grass up to the walls, and made the house an object standing in an idealised pasture' (description, long) -- replacing the working-agricultural-ground idiom (terraced retaining walls, an axial approach) this slot would otherwise inherit through the corpus's deep mediterranean-vernacular ancestry, which describes a wholly different Italian farmhouse relationship to its land."
        },
        {
          "id": "designed-ornamental-garden-as-separate-work",
          "status": "forbidden",
          "note": "The whole point of the landscape park is that grass runs to the wall with no formal garden or forecourt intervening; a house set in a designed ornamental garden read as its own separate work belongs to an earlier or later idiom."
        }
      ],
      "rule": "Grass to the walls, no formal forecourt, and a roofline and four elevations composed to resolve when seen in the round at a quarter of a mile -- the house is designed to stand as a single object in an idealised, grazed landscape, not framed by a garden.",
      "sources": [
        "english-georgian-country-house style node, description (long)"
      ],
      "status": "drafted",
      "confidence": "high"
    },
