        },
        {
          "id": "none",
          "status": "canonical",
          "note": "Wall ornament is limited to plinth, string course, quoins and crowning cornice, plus one accented centre (soft constraint c05) -- no applied pilaster order runs anywhere on the elevation."
        }
      ],
      "rule": "No pilaster order at all: a house that carries one has crossed into the Palladian style, per this variant's own explicit classification rule.",
