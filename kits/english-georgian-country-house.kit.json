      "binding": "extends",
      "parameters": {
        "second_floor_ratio_of_first": {
          "range": [
            0.7,
            0.8
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "english-georgian-country-house proportional_system typical_ratios: 'second floor 0.7-0.8 of the first'"
        },
        "attic_ratio_of_first": {
          "range": [
            0.5,
            0.6
          ],
          "unit": "ratio",
          "kind": "measured",
          "source": "english-georgian-country-house proportional_system typical_ratios: 'attic 0.5-0.6'"
        }
      },
      "rule_append": "This is the free-standing case the family text describes by default: ground floor tallest, every storey above diminishing, restated as this variant's own hard constraint c02 -- the graduation identifies the building as rural 'at a glance' against the town house's inverted, first-floor-peaked arrangement.",
      "status": "drafted",
      "confidence": "high"
    },
    "wing_strategy": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "flanking-symmetrical-dependencies",
          "status": "canonical",
          "note": "Overrides the generic H-plan Tudor gentry-house content this slot would otherwise inherit through the corpus's deep vernacular ancestry: this variant's own service wing is a screened, ASYMMETRICAL block joined to a strictly symmetrical main range (defining_characteristics, constraint c01), the reverse relationship of a Tudor E/H-plan, where the wings themselves are symmetrical about the hall range."
        }
      ],
      "parameters": {
        "wing_ridge_deficit_pct_min": {
          "value": 25,
          "unit": "percent",
          "kind": "measured",
          "source": "english-georgian-country-house constraint c04 (hard, tested)"
        }
      },
      "rule": "The main block is strictly symmetrical about the entrance axis, including chimney positions; asymmetry is permitted only in the service wing, which must be visually subordinate, set back, and screened by planting so that the park's own fiction -- that the house is not a place of work -- holds (hard constraints c01, c04).",
      "sources": [
        "english-georgian-country-house style node, defining_characteristics, constraints c01, c04"
      ],
      "status": "drafted",
      "confidence": "high"
    },
