    "outbuilding_types": {
      "group": "site",
      "binding": "specified",
      "variants": [
        {
          "id": "screened-service-court",
          "status": "canonical",
          "note": "'A service wing that is symmetrical about nothing, joined to a main block that is symmetrical about everything' (diagnostic_tells) -- the stable and service court is deliberately screened from the park front by planting so the park's fiction that the house is not a place of work can hold (description, long)."
        }
      ],
      "rule": "Service and stable accommodation is pushed into a subordinate wing or a detached court, joined by a passage, and screened from the principal park front by trees -- never displayed on the same elevation as the main block.",
