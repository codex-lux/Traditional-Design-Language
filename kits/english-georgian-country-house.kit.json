    "order": {
      "group": "classical-apparatus",
      "binding": "specified",
      "variants": [
        {
          "id": "gibbs-ionic",
          "status": "canonical",
          "note": "'The five-part scheme, the pedimented centre, the Venetian window and the piano nobile survive here in reduced and affordable form, transmitted through Gibbs, Ware and Robert Morris's Select Architecture' (this node's own lineage note) -- replacing the Palladio-mediated order this slot would otherwise inherit, which belongs to the aristocratic parent this variant deliberately builds at a quarter of the cost."
        },
        {
          "id": "gibbs-doric",
          "status": "permitted",
          "note": "The subordinate wing and service court's plainer order, graded below the main block's Ionic centre exactly as hard constraint c04 requires the wing to be subordinate in height."
        }
      ],
      "rule": "The order appears at the doorcase and, where used, the cornice and any Venetian window -- drawn from exactly the Gibbs and Ware plates the American colonies also owned, at the same date, for the same reason -- never from a portico standing on a rusticated basement.",
      "sources": [
        "english-georgian-country-house style node, lineage, proportion_packs"
      ],
      "status": "drafted",
      "confidence": "high"
    },
