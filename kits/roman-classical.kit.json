    "construction_type": {
      "group": "envelope",
      "binding": "extends",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "parameters": {
        "structural_logic": {
          "value": "arcuated",
          "unit": "none",
          "kind": "measured",
          "source": "roman-classical.json defining_characteristics"
        }
      },
      "variants": [
        {
          "id": "arcuated-concrete-or-brick",
          "status": "canonical",
          "op": "add",
          "note": "The arch, the barrel/groin vault and opus caementicium (brick-faced concrete) free the wall from the colonnade; the order becomes an applied articulating grid rather than the load path itself. Any span above roughly 6 m must be arched or vaulted, not lintelled (c01, hard)."
        },
        {
          "id": "trabeated-dressed-ashlar-no-mortar",
          "status": "forbidden",
          "op": "add",
          "note": "The Greek answer to the same family-level masonry binding — see greek-classical's own construction_type, where this is canonical."
        }
      ],
      "rule_append": "Specifically arcuated: arched and vaulted concrete or brick-faced concrete, with the order applied over the structure rather than carrying it.",
      "note": "Resolves the family's own explicitly-left-open trabeated/arcuated split (antique-classical.construction_type note: 'It deliberately does NOT resolve trabeated (Greek) versus arcuated (Roman) structural logic... that disagreement is real and stays open for the style to decide'). See greek-classical's own construction_type for the mirror-image resolution.",
      "sources": [
        "roman-classical.json defining_characteristics",
        "roman-classical.c01"
      ]
    },
