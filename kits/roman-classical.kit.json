          "kind": "measured",
          "source": "roman-classical.json diagnostic_tells",
          "note": "2-4 m in the source, converted to ft (unit vocabulary has no metre)."
        }
      },
      "variants": [
        {
          "id": "high-podium-frontal-stair",
          "status": "canonical",
          "note": "diagnostic_tells: 'Temple standing on a podium 2 to 4 m high with steps only on the entrance front.'"
        },
        {
          "id": "all-round-stepped-crepidoma",
          "status": "forbidden",
          "note": "Greek, not Roman — see greek-classical's own composition. Roman temples are pseudoperipteral and frontal, approached on one face only."
        }
      ],
      "rule": "The temple stands on a high podium, approached by a frontal stair on the entrance face only — never an all-round stepped base. Podium height runs between 1/5 and 1/3 of the column height; below about 1/6 the building loses the frontality that distinguishes it from Greek practice (c04, soft).",
      "sources": [
        "roman-classical.c04",
        "roman-classical.json diagnostic_tells"
      ]
    },
