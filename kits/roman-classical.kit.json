    "order": {
      "group": "classical-apparatus",
      "binding": "extends",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "rule_append": "In this style the order is characteristically APPLIED rather than load-bearing: an engaged half-column or pilaster set against a structural pier, spanned by a real arch, repeated as a bay and stacked in superimposed registers — the Colosseum bay (Tuscan, Ionic, Corinthian) is the paradigm case and the ancestor of every arcuated classical facade since. The order still varies as one graduated system (shaft, capital and entablature together); what changes from the family's generic statement is that the structure no longer requires it to.",
      "sources": [
        "roman-classical.json defining_characteristics, description.long"
      ]
    },
    "column": {
      "group": "classical-apparatus",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "parameters": {
        "intercolumniation_classes": {
          "set": [
            "pycnostyle 1.5D",
            "systyle 2D",
            "eustyle 2.25D (central bay 3D)",
            "diastyle 3D",
            "araeostyle 4D"
          ],
          "unit": "none",
          "kind": "measured",
          "source": "Vitruvian intercolumniations, per proportional_system.typical_ratios"
        },
        "canonical_order_heights_diameters": {
          "set": [
            "Tuscan 7D",
            "Doric 8D",
            "Ionic 9D",
            "Corinthian/Composite 10D"
          ],
          "unit": "none",
          "kind": "measured",
          "source": "as later codified by Vignola, per this node's own proportional_system"
        }
      },
      "variants": [
        {
          "id": "doric-or-tuscan-with-moulded-base",
          "status": "canonical",
          "note": "diagnostic_tells: 'Roman Doric and Tuscan columns have bases; Greek Doric never does.'"
        },
        {
          "id": "doric-baseless",
          "status": "forbidden",
          "note": "Exclusively Greek — see greek-classical's own column binding, where this is canonical."
        },
        {
          "id": "superimposition-heavy-to-light",
          "status": "canonical",
          "note": "c02, hard: superimposed orders must ascend Tuscan/Doric, then Ionic, then Corinthian/Composite."
        },
        {
          "id": "superimposition-inverted",
          "status": "forbidden",
          "note": "c02, hard: 'Inverting this order is a hard error.'"
        }
      ],
      "rule": "Doric and Tuscan columns always carry a moulded base — bare stylobate contact is exclusively Greek practice. Where orders are superimposed in a multi-storey arcade they must ascend from heavier to lighter: Tuscan or Doric at the base, Ionic next, Corinthian or Composite above.",
      "sources": [
        "roman-classical.c02",
        "roman-classical.json diagnostic_tells, proportional_system"
      ]
    },
    "entablature": {
      "group": "classical-apparatus",
      "binding": "extends",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "parameters": {
        "entablature_to_column_ratio": {
          "value": 0.25,
          "unit": "ratio",
          "kind": "measured",
          "note": "'Entablature approximately 1/4 of column height' per proportional_system.typical_ratios — against a Greek Doric third."
        }
      },
      "rule_append": "Where an order is applied to an arcade, the arch springing must align with a horizontal member of the applied order (impost or subordinate entablature), and the arch crown must clear the main entablature soffit by at least half a module (c03, hard).",
      "sources": [
        "roman-classical.c03",
        "roman-classical.json proportional_system.typical_ratios"
      ]
    },
