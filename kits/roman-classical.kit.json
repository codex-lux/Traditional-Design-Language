    "window_head_masonry": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "medium",
      "judgment": true,
      "variants": [
        {
          "id": "arched-head-aligned-to-impost",
          "status": "canonical",
          "note": "Where an opening sits within an applied arch order, its head is a real structural arch whose springing aligns with a horizontal member of the order and whose crown clears the main entablature soffit by at least half a module (c03, hard)."
        },
        {
          "id": "flat-lintel-over-6m-span",
          "status": "forbidden",
          "note": "c01, hard: 'Any span above roughly 6 m must be arched or vaulted, not lintelled. A flat stone lintel spanning 8 m is not Roman; it is a modern steel beam with stone cladding.'"
        }
      ],
      "rule": "Openings within an applied arch order take a real structural arch as their head, coordinated with the order's own impost line — never a flat lintel pretending to be load-bearing over a wide span.",
      "note": "Judgment: applies the general arcuated-structure rules (c01, c03) specifically to the window_head_masonry slot, which the style's own text does not name by that vocabulary directly.",
