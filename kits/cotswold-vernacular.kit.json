      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "kneelers-and-raised-coping",
          "status": "canonical",
          "note": "Kneeler stones at the foot of every gable and a coping standing proud of the slates, frequently with a ball, ogee or finial at the apex — a raised stone edge in place of a timber barge board."
        },
        {
          "id": "timber-barge-board",
          "status": "forbidden",
          "note": "c04, hard: 'No barge boards.'"
        }
      ],
      "rule": "No barge board of any kind. Gables are finished with kneelers at the foot and a raised, mortar-bedded stone coping, often carrying a finial at the apex (c04, hard).",
      "sources": [
        "cotswold-vernacular.c04",
        "cotswold-vernacular.json defining_characteristics"
