    "color_strategy": {
      "group": "envelope",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "variants": [
        {
          "id": "lime-mortar-limewash",
          "status": "canonical"
        },
        {
          "id": "cement-pointing-or-render",
          "status": "forbidden",
          "note": "c05, hard: 'Cement pointing and impermeable render trap moisture in a rubble wall and will spall the stone within a generation.'"
        }
      ],
      "rule": "Lime mortar and limewash only. The stone weathers within one range across the district: honey and gold in the north around Broadway and Stanton, greyer and cooler toward Tetbury in the south.",
      "sources": [
        "cotswold-vernacular.c05",
        "cotswold-vernacular.json description.long"
