          "value": 0.5,
          "unit": "ft",
          "kind": "measured",
          "note": "Roughly 150 mm in the source, converted to ft."
        }
      },
      "variants": [
        {
          "id": "graded-stone-slate-large-to-small",
          "status": "canonical"
        },
        {
          "id": "uniform-course-slate-or-imitation",
          "status": "forbidden",
          "note": "c02, hard, and cotswold-cottage-revival's own distinguished_from entry: 'uniform machine-cut slates or swept composition shingles imitating graded stone.'"
        }
      ],
      "rule": "Cotswold stone slate, graded course by course from large at the eaves down to small at the ridge; uniform coursing destroys the roof and with it the whole reading of the building (c02, hard).",
      "sources": [
        "cotswold-vernacular.c02",
        "cotswold-vernacular.json proportional_system.typical_ratios"
      ]
