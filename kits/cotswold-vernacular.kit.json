    "ceiling_height_rule": {
      "group": "interior",
      "binding": "specified",
      "status": "drafted",
      "confidence": "high",
      "judgment": false,
      "parameters": {
        "storey_height_ground": {
          "range": [
            6.9,
            8.5
          ],
          "unit": "ft",
          "kind": "measured",
          "note": "2.1-2.6 m in the source, converted to ft (unit vocabulary has no metre)."
        },
        "storey_height_upper": {
          "range": [
            6.2,
            7.5
          ],
          "unit": "ft",
          "kind": "measured",
          "note": "1.9-2.3 m in the source, converted to ft."
        },
        "eaves_height_two_storey": {
          "range": [
            13.1,
            16.4
          ],
          "unit": "ft",
          "kind": "measured",
          "note": "4.0-5.0 m in the source, converted to ft."
        }
      },
      "rule": "Room and storey height come from structural and material logic — joist span, wall coursing, what a rubble wall of the period could economically raise — never from an applied plan-proportion formula. Ground-floor storeys run 6'11\"-8'6\", upper storeys 6'3\"-7'6\", and total eaves height for a two-storey house is 13'1\"-16'5\".",
      "note": "CASCADE-PROVENANCE FIX (WP-4.2 wave B2): left open, this slot resolves through this style's own real lineage descent (english-gothic, weight 0.6; tudor, weight 0.4) into the deep classical chain the docs' own worked example traces (norman-romanesque-english -> roman-classical -> antique-classical -> greek-classical, and separately tudor -> tudor-jacobean -> ... -> italian-renaissance -> renaissance-classical) to renaissance-classical's Palladian arithmetic/geometric/harmonic-mean room-height derivation. That rule is real and correctly bound for the drawn classical tradition it comes from, but it flatly contradicts this style's own documented governing_logic ('Material logic, not applied proportion... Nothing is drawn; everything is set out on site'). Fixed on this node's own kit with this style's own measured typical_ratios figures, not on renaissance-classical, italian-renaissance, or any other ancestor.",
      "sources": [
        "cotswold-vernacular.json proportional_system.governing_logic, typical_ratios"
      ]
    },
