    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "status": "drafted",
      "confidence": "low",
      "judgment": true,
      "invented": true,
      "variants": [
        {
          "id": "detached-stone-outbuilding-matched-coursing",
          "status": "canonical",
          "note": "Invented: no historical precedent exists for any traditional style. Built as a detached stone outbuilding in the same coursing, wall thickness and graded-slate roof as the house — consistent with the district's own logic that 'everything in the district is the same stone: house, boundary wall, gatepost, barn, church' (diagnostic_tells) — rather than a bay or door cut into the principal elevation."
        },
        {
          "id": "garage-door-in-principal-elevation",
          "status": "forbidden",
          "note": "Invented judgment: a wide garage-door opening exceeds the roughly 1.8 m clear span a stone lintel or relieving arch can carry (c03, hard) without a run of structural mullions across it, which would misread as a shopfront, not an opening in a rubble wall."
        }
      ],
      "rule": "A garage is built as its own detached stone outbuilding, coursed and roofed to match the house, rather than as an opening cut into the principal elevation.",
      "note": "Explicitly named as a plausible contemporary-buildable reinterpretation in this wave's brief; cotswold-vernacular is 'living' status. Invented per docs/inheritance.md's own guidance: no traditional style has a historical answer for this slot."
    },
