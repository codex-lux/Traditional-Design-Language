    "garage_strategy": {
      "group": "openings",
      "binding": "specified",
      "variants": [
        {
          "id": "attached-side-wing-set-back",
          "status": "canonical",
          "note": "A subordinate, lower wing set back from the principal planar wall, so the garage door never interrupts the flat, unbroken wall plane the style's whole calm depends on."
        },
        {
          "id": "attached-flush-facing-street",
          "status": "forbidden",
          "note": "Defining_characteristics: the wall is 'treated as a plane... no picturesque projection'; a garage door punched into the principal facade breaks the calm, evenly-fenestrated wall the style is built on."
        }
      ],
      "rule": "No traditional precedent exists; the garage is kept subordinate and set back so it never competes with the flat planar wall and its strict bay rhythm.",
      "invented": true,
      "confidence": "medium",
      "status": "drafted"
    },
