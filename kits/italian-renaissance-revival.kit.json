  "slots": {
    "composition_parti": {
      "group": "massing-and-roof",
      "binding": "extends",
      "variants": [
        {
          "id": "strict-bilateral",
          "status": "canonical",
          "op": "add",
          "note": "proportional_system.symmetry is 'strict-bilateral', and bay_rhythm states vertical alignment between storeys is absolute -- 'a single misaligned window is visible from across the street.'"
        },
        {
          "id": "picturesque-asymmetrical",
          "status": "forbidden",
          "op": "add",
          "note": "defining_characteristics: 'no picturesque projection... nothing overhangs, nothing turns a corner, nothing surprises.'"
        }
      ],
      "parameters": {
        "bay_count": {
          "set": [
            3,
            5,
            7,
            9
          ],
          "unit": "count",
          "kind": "measured"
        }
      },
      "note": "eclectic-revivals leaves symmetry class to each member; this is Italian Renaissance Revival's own, sourced from bay_rhythm ('strictly even, three to nine bays').",
      "status": "drafted"
    },
    "roof_form": {
      "group": "massing-and-roof",
      "binding": "specified",
      "variants": [
        {
          "id": "hip",
          "status": "canonical",
          "note": "defining_characteristics: 'Low-pitched hipped roof... often not visible from the street on urban examples.'"
        },
        {
          "id": "front-gable",
          "status": "forbidden",
          "note": "Hard constraint c03: 'no gable facing any principal elevation.' The family's inherited front-gable answer (germanic-vernacular) is exactly this style's own forbidden case."
        }
      ],
      "rule": "Low-pitched hipped roof with no gable facing any principal elevation (c03).",
      "confidence": "high",
      "note": "Overrides the family's front-gable default, which contradicts this style's own hard constraint.",
      "status": "drafted"
    },
    "roof_pitch": {
      "group": "massing-and-roof",
      "binding": "specified",
      "parameters": {
        "pitch_min": {
          "value": "3:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_max": {
          "value": "5:12",
          "unit": "rise_in_12",
          "kind": "measured"
        },
        "pitch_typical": {
          "value": "4:12",
          "unit": "rise_in_12",
          "kind": "editorial",
          "note": "EDITORIAL, AND NO SOURCE IS RECORDED (OQ 18, annotated 25 Aug 2026; reclassified 25 Aug after audit). The basis stated for this slot is: \"Roof pitch 3:12 to 5:12, clay tile only, with no gable facing any principal elevation (hard constraint c03).\" -- which is the reasoning, not a citation. A SINGLE FIGURE WITH NO SOURCE AND NO BAND, which is the weakest form in this corpus and the class OQ 18 most needs closed -- it reads as precise and is not."
        }
      },
      "rule": "Roof pitch 3:12 to 5:12, clay tile only, with no gable facing any principal elevation (hard constraint c03).",
      "confidence": "high",
      "note": "Specified rather than extends: the inherited family default (british-picturesque, minimum 45 degrees = 12:12) is roughly three times this style's own maximum pitch.",
      "status": "drafted"
    },
