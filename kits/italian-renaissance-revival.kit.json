    "order": {
      "group": "classical-apparatus",
      "binding": "specified",
      "variants": [
        {
          "id": "vernacular-abstracted",
          "status": "forbidden",
          "note": "Redundant with the general rule below; retained only to keep the family's inherited forbidding visible as a deliberate override, not an oversight."
        }
      ],
      "rule": "Where an order is used at all it is engaged as a pilaster within the wall plane, never free-standing and never carried on a portico (hard constraint c05).",
      "confidence": "high",
      "note": "Overrides the family-wide 'no classical order of any kind' binding this slot would otherwise inherit (french-vernacular): this style's whole compositional system is a stacked classical order, only ever engaged rather than free-standing.",
      "status": "drafted"
    },
    "column": {
      "group": "classical-apparatus",
      "binding": "specified",
      "rule": "No free-standing, entasis-bearing column appears anywhere on the exterior; c05 forbids any column projecting more than 1/6 of its width in front of the wall plane.",
      "confidence": "high",
      "note": "Overrides the inherited family-wide column-forbidden binding: not the column itself but its free-standing use is what this style prohibits.",
      "status": "drafted"
    },
    "entablature": {
      "group": "classical-apparatus",
      "binding": "specified",
      "rule": "A full entablature caps the wall at the cornice (see cornice); where pilasters occur they carry a correctly proportioned entablature band, never a fascia standing in for one.",
      "confidence": "high",
      "note": "Overrides the inherited family-wide entablature-forbidden binding: the cornice IS the entablature here, at building scale.",
      "status": "drafted"
    },
