    "cornice": {
      "group": "envelope",
      "binding": "extends",
      "parameters": {
        "projection_ratio_min": {
          "value": 0.0625,
          "unit": "ratio",
          "kind": "measured",
          "note": "Hard constraint c02: not less than 1/16 of total wall height."
        },
        "projection_min_absolute": {
          "value": 24,
          "unit": "in",
          "kind": "measured",
          "note": "c02: not less than 24 in on any two-storey example."
        },
        "bracket_spacing": {
          "range": [
            12,
            24
          ],
          "unit": "in",
          "kind": "measured",
          "note": "c02: modillions or brackets spaced 12-24 in on centre."
        }
      },
      "rule_append": "A cornice under 12 in voids the style (c02).",
      "note": "The inherited modillion-cornice base (english-georgian) is the right family, but its own projection ratio (about 1.0, an entablature-derived figure) is a different, much deeper convention than this style's own boxed-domestic proportion; this adds the style's own sourced numbers on top of the inherited variant list rather than the parent's ratio.",
      "status": "drafted"
    },
